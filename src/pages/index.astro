.author{padding:1rem 0}.author-collage{display:grid;grid-template-columns:.62fr .95fr 1.65fr;align-items:center;min-height:245px;overflow:hidden;background:#f6f7f7}.practice{padding:1rem}.practice strong{float:left;margin-right:.4rem;color:var(--c-orange);font-family:var(--font-editorial);font-size:2.5rem;line-height:.8}.practice>span{font-family:var(--font-editorial);font-size:.8rem}.practice ul{clear:both;display:grid;gap:.6rem;padding:1rem 0 0;list-style:none;font-size:.65rem}.practice li::before{margin-right:.35rem;content:'✓'}.author-photo{align-self:stretch;overflow:hidden}.author-photo img{width:100%;height:100%;object-fit:cover}.author-copy{position:relative;padding:1.2rem 1.5rem}.author-copy h2{margin:.15rem 0 .55rem;font-size:1.7rem}.author-copy h2 em{color:var(--c-orange);font-style:normal}.author-copy>p:not(.eyebrow){max-width:610px;margin:0 0 .7rem;font-size:.76rem}.facts{display:grid;grid-template-columns:1fr 1fr;gap:.4rem .9rem;max-width:560px;margin-bottom:.7rem}.facts span{display:flex;align-items:center;gap:.35rem;font-size:.62rem}.facts i{color:var(--c-blue);font-size:1rem}.author-copy>a{font-size:.66rem;font-weight:800;text-decoration:none}.chart-accent{position:absolute;right:1rem;bottom:.4rem;color:var(--c-blue);font-size:3.2rem}
