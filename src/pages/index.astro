.article-rail{display:grid;grid-template-columns:repeat(5,1fr);gap:.55rem}.article-rail article{min-width:0;border:1px solid #dfe3e5;border-radius:6px;background:#fff}.article-image{position:relative;display:block;height:92px;overflow:hidden}.article-image img{width:100%;height:100%;object-fit:cover}.article-image span{position:absolute;bottom:.3rem;left:.3rem;padding:.18rem .32rem;background:var(--c-blue);color:#fff;font-size:.58rem}.article-rail h3{min-height:3.5em;margin:.55rem .55rem .4rem;font:700 .8rem/1.16 var(--font-ui)}.article-rail h3 a{text-decoration:none}.article-rail article>div{display:flex;justify-content:space-between;gap:.25rem;padding:.45rem .55rem;border-top:1px solid #eef0f1;color:#777f85}.article-rail small{font-size:.55rem}
