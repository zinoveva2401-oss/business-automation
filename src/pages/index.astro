@media(max-width:600px){.author-collage{height:auto}.practice{width:46%}.practice ul{font-size:.875rem}.author-photo{height:215px;min-height:215px}.author-copy{padding:.65rem .8rem}.author-copy>p:not(.eyebrow){margin-bottom:.45rem;line-height:1.4}.facts{gap:.25rem .5rem;margin-bottom:.45rem}}
.practice{top:auto;bottom:.75rem;left:.75rem;width:27%;box-shadow:0 8px 24px #0e111426}.author-photo img{object-position:center 28%}.social-panel{padding:.5rem 0}.social-grid{align-items:center;gap:1rem}.social-grid h2{margin-bottom:.25rem}.social-grid a{padding:.28rem .45rem}.social-grid nav{gap:.25rem}:global(.site-footer .footer-brand){padding-left:16px;font-size:1.04rem;line-height:.9;text-transform:uppercase}:global(.site-footer .footer-brand:before){inset:0 auto 0 0;width:3px}
