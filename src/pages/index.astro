---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialFolio from '../components/EditorialFolio.astro';
import EditorialArticleRow from '../components/EditorialArticleRow.astro';
import { getActiveServices, getPublishedArticles, getVisibleProducts } from '../lib/content';
import { categories, topicDescriptions } from '../lib/site';

const articles = await getPublishedArticles();
const featuredArticle = articles[0];
const supportingArticles = articles.slice(1, 5);
const currentArticleSlugs = new Set(['pyatiminutka-direktora', 'pyatiminutka-zakonchilas-zadachi', 'vchera-kollega-segodnya-administrator']);
const currentArticles = articles.filter(({ data }) => currentArticleSlugs.has(data.slug));
const tools = await getVisibleProducts();
const services = await getActiveServices();
const channels = [
  { name: 'ВКонтакте', label: 'VK-сообщество', href: 'https://vk.ru/svetlana_tarasova_marketolog', reason: 'Посты и серии по задачам бизнеса — чтобы разбирать рабочую ситуацию вместе с сообществом.', icon: 'VK', event: 'click_vk' },
  { name: 'Telegram', label: 'Telegram-канал', href: 'https://t.me/Svetlana_Marketolog_riteil', reason: 'Короткие разборы, чек-листы и наблюдения — чтобы быстро вернуться к следующей проверке.', icon: 'TG', event: 'click_telegram' },
];
const steps = ['Проблема', 'Причины', 'Проверка', 'Решение', 'Инструмент', 'Действие', 'Контроль результата'];
const homeSchema = [
  { '@context': 'https://schema.org', '@type': 'Person', name: 'Светлана Тарасова', jobTitle: 'Основатель и практик', url: Astro.site ? new URL('/about/', Astro.site).href : undefined },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Докрути', description: 'Практические решения для малого бизнеса: от разбора рабочей ситуации до следующего проверяемого шага.', url: Astro.site?.href },
];
---

<BaseLayout title="Докрути — найти причину и следующий шаг для бизнеса" description="Практические разборы, инструменты и услуги для малого бизнеса. Выберите рабочую задачу и пройдите путь от причины до контроля результата." image="/images/home-hero-editorial.png" schema={homeSchema}>
  <div class="home" id="top">
    <section class="home-brand-hero" aria-labelledby="home-title">
      <div class="container home-brand-hero__inner">
        <div class="home-brand-hero__top"><EditorialFolio number="01" label="Практика для малого бизнеса" total="09" /><span>Проблема → ясность → действие</span></div>
        <p class="eyebrow">Когда привычный способ уже не помогает</p>
        <h1 id="home-title">Разобраться,<br />что мешает бизнесу.<br /><em>И докрутить решение.</em></h1>
        <div class="home-brand-hero__bottom"><p>Продажи, команда, управление, маркетинг и другие рабочие задачи — начнём с факта, найдём причину и выберем следующий шаг, который можно проверить.</p><a class="button button--primary" href="#problems" data-analytics-event="hero_cta" data-analytics-placement="home_hero">Выбрать задачу <span aria-hidden="true">↘</span></a></div>
        <div class="hero-trace" aria-hidden="true"><span>СИМПТОМ</span><i></i><span>ПРИЧИНА</span><i></i><span>СЛЕДУЮЩИЙ ШАГ</span></div>
      </div>
    </section>

    <section class="problem-section" id="problems" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-intro section-intro--compact"><div><EditorialFolio number="02" label="Карта задач" total="09" /><p class="eyebrow">Начните с того, что происходит</p><h2 id="problem-title">Где сейчас<br /><em>нужна ясность?</em></h2></div><p>Выберите направление: короткий ориентир подскажет, с какой части ситуации начать.</p></div>
        <div class="problem-band" role="list" aria-label="Семь направлений задач">
          {categories.map((topic, index) => <details class="problem-topic" role="listitem" name="home-topic">
            <summary data-analytics-event="pain_topic_click" data-analytics-category={topic.slug} data-analytics-placement="home_problem_band"><span class="problem-topic__number">0{index + 1}</span><strong>{topic.name}</strong><span class="problem-topic__plus" aria-hidden="true">+</span></summary>
            <div class="problem-topic__detail"><p>{topicDescriptions[topic.slug]}</p><a href={'/topics/' + topic.slug + '/'}>Открыть направление <span aria-hidden="true">↗</span></a></div>
          </details>)}
        </div>
      </div>
    </section>

    <section class="library-section" id="articles" aria-labelledby="library-title">
      <div class="container">
        <div class="section-intro"><div><EditorialFolio number="03" label="Библиотека" total="09" /><p class="eyebrow">Статьи и рабочие разборы</p><h2 id="library-title">Сначала увидеть причину.<br /><em>Потом выбрать действие.</em></h2></div><p>Материалы помогают отделить наблюдаемый факт от версии и выбрать одну полезную проверку.</p></div>
        {featuredArticle && <div class="home-feature"><EditorialArticleRow article={featuredArticle} featured placement="home_feature" /></div>}
        <div class="home-article-rows">{supportingArticles.map((article, index) => <EditorialArticleRow article={article} rank={index + 1} placement="home_supporting" />)}</div>
        <a class="text-link" href="/articles/">Все статьи <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="current-section" id="current" aria-labelledby="current-title">
      <div class="container current-grid">
        <div class="current-heading"><EditorialFolio number="04" label="Сейчас в Докрути" total="09" /><p class="eyebrow">Актуально в Докрути</p><h2 id="current-title">Рабочие материалы<br /><em>для ближайшего шага.</em></h2><p>Начните с разбора или сохраните материал, чтобы вернуться к задаче позже.</p><a class="text-link" href="/articles/">Открыть библиотеку <span aria-hidden="true">↗</span></a></div>
        <div class="current-list" aria-label="Недавние материалы">
          {currentArticles.map((article, index) => <a class="current-item" href={'/articles/' + article.data.slug + '/'} data-analytics-event="current_item_click" data-analytics-content-id={article.data.id} data-analytics-placement="home_current"><span class="current-item__number">0{index + 1}</span><span><small>{article.data.category}</small><strong>{article.data.title}</strong><span>{article.data.description}</span></span><b aria-hidden="true">↗</b></a>)}
          {!currentArticles.length && <p>Новые материалы появятся здесь.</p>}
        </div>
      </div>
    </section>

    <section class="work-section" id="how-it-works" aria-labelledby="work-title">
      <div class="container">
        <div class="section-intro"><div><EditorialFolio number="05" label="Как работаем" total="09" /><p class="eyebrow">Не совет наугад, а рабочая последовательность</p><h2 id="work-title">От симптома<br /><em>к контролю результата.</em></h2></div><p>Задача проходит понятные этапы. На каждом — конкретный вопрос и решение, которое соотносится с реальностью бизнеса.</p></div>
        <ol class="work-sequence">{steps.map((step, index) => <li><span class="work-sequence__number">0{index + 1}</span><strong>{step}</strong>{index < steps.length - 1 && <span class="work-sequence__connector" aria-hidden="true"></span>}</li>)}</ol>
        <div class="work-foot"><p><strong>Проблема → причины → проверка → решение → инструмент → действие → контроль результата.</strong> Такая логика помогает видеть, что уже известно и что проверить дальше.</p><a class="text-link" href="/about/" data-analytics-event="how_dokruti_works_click" data-analytics-placement="home_how_it_works">Подробнее о подходе <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="tool-section" id="tools" aria-labelledby="tools-title">
      <div class="container tool-grid"><div><EditorialFolio number="06" label="Инструменты" dark total="09" /><p class="eyebrow">Проверять на данных</p><h2 id="tools-title">Инструмент —<br /><em>часть решения.</em></h2><p>Рабочие материалы помогают зафиксировать наблюдения, увидеть взаимосвязи и выбрать действие. Каждый инструмент появляется здесь со своим актуальным статусом.</p><a class="text-link text-link--light" href="/tools/" data-analytics-event="tool_click" data-analytics-placement="home_tools">Все инструменты <span aria-hidden="true">↗</span></a></div>
        <div class="tool-note">{tools[0] ? <><span class="tool-note__status">{tools[0].data.status === 'HOLD' ? 'ГОТОВИТСЯ · НЕ ПРОДАЁТСЯ' : 'ИНСТРУМЕНТ'}</span><h3>{tools[0].data.title}</h3><p>{tools[0].data.description}</p><a href={'/tools/' + tools[0].data.slug + '/'} data-analytics-event="tool_click" data-analytics-content-id={tools[0].data.id} data-analytics-placement="home_tool_detail">Посмотреть карточку <span aria-hidden="true">↗</span></a></> : <><span class="tool-note__status">БИБЛИОТЕКА ИНСТРУМЕНТОВ</span><h3>Подберите рабочий материал</h3><p>Откройте библиотеку и проверьте, какие материалы доступны сейчас.</p><a href="/tools/">Перейти к инструментам <span aria-hidden="true">↗</span></a></>}</div>
      </div>
    </section>

    <section class="founder-section" id="founder" aria-labelledby="founder-title">
      <div class="container founder-grid"><div class="founder-mark" aria-hidden="true"><span>ДК</span><i></i><small>ПРАКТИКА<br />→ СИСТЕМА</small></div><div><EditorialFolio number="07" label="Почему Докрути" total="09" /><p class="eyebrow">Основатель и практик</p><h2 id="founder-title">Светлана<br /><em>Тарасова</em></h2><p class="founder-lead">«Докрути» вырос из многолетней практической работы в бизнесе: важно не остановиться на симптоме, а понять, что за ним стоит и как проверить решение.</p><p>Здесь соединяются наблюдение, данные и рабочая логика — чтобы следующий шаг был понятным для владельца бизнеса и команды.</p><a class="text-link" href="/about/" data-analytics-event="founder_click" data-analytics-placement="home_founder">История и подход <span aria-hidden="true">↗</span></a></div></div>
    </section>

    <section class="services-section" id="services" aria-labelledby="services-title">
      <div class="container"><div class="section-intro"><div><EditorialFolio number="08" label="Услуги" total="09" /><p class="eyebrow">Когда нужен совместный разбор</p><h2 id="services-title">Формат под<br /><em>масштаб задачи.</em></h2></div><p>Выберите глубину работы. Сначала обсудим ситуацию и соответствие формата; срок и стоимость согласуем до начала.</p></div>
        <div class="service-list">{services.map((service, index) => <article class="service-row"><span class="service-row__number">0{index + 1}</span><div><h3>{service.data.title}</h3><p>{service.data.description}</p></div><a href={'/services/' + service.data.slug + '/'} data-analytics-event="service_click" data-analytics-content-id={service.data.id} data-analytics-placement="home_services">Посмотреть формат <span aria-hidden="true">↗</span></a></article>)}</div>
        <a class="text-link" href="/services/">Все форматы работы <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="channels-section" id="channels" aria-labelledby="channels-title">
      <div class="container channels-grid"><div><EditorialFolio number="09" label="Каналы" dark total="09" /><p class="eyebrow">Оставаться в рабочем контексте</p><h2 id="channels-title">Разборы там,<br /><em>где вам удобно.</em></h2><p>Выберите канал по формату материалов и возвращайтесь к тому, что помогает в вашей задаче.</p></div><div class="channel-list">{channels.map((channel, index) => <a class="channel-row" href={channel.href} target="_blank" rel="noopener noreferrer" data-analytics-event="channel_subscribe_click" data-analytics-category={channel.event} data-analytics-placement="home_channels"><span class="channel-row__index">0{index + 1}</span><span class="channel-row__icon" aria-hidden="true">{channel.icon}</span><span class="channel-row__copy"><strong>{channel.label}</strong><small>{channel.reason}</small></span><b aria-hidden="true">↗</b></a>)}</div></div>
    </section>
  </div>
</BaseLayout>

<style>
  .home{--home-ink:#20272d;--home-muted:#59646b;--home-paper:#f5f3ef;--home-line:#a7a8a5;color:var(--home-ink);background:#fff}.home h1,.home h2,.home h3,.home p{margin-top:0}.home em{font-style:normal;color:var(--c-orange)}.home .eyebrow{margin:0 0 .8rem;color:var(--c-orange);font-size:.7rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.home .editorial-folio{margin-bottom:2.4rem}.home-brand-hero{padding:1.6rem 0 clamp(4rem,8vw,7rem);background:var(--home-paper)}.home-brand-hero__inner{max-width:1160px}.home-brand-hero__top{display:flex;justify-content:space-between;align-items:start;min-height:60px;color:#70777b;font-size:.68rem}.home-brand-hero__top .editorial-folio{margin:0}.home-brand-hero__top>span{padding-top:.35rem;text-transform:uppercase;letter-spacing:.08em}.home-brand-hero h1{max-width:1160px;margin:1rem 0 2rem;font-size:clamp(3.5rem,8.2vw,8rem);font-weight:650;line-height:.86;letter-spacing:-.075em}.home-brand-hero h1 em{display:inline-block;color:var(--c-orange)}.home-brand-hero__bottom{display:grid;grid-template-columns:minmax(0,620px) auto;gap:2rem;align-items:end;justify-content:space-between}.home-brand-hero__bottom p{max-width:580px;margin:0;color:var(--home-muted);font-size:clamp(1rem,1.5vw,1.2rem);line-height:1.5}.home-brand-hero__bottom .button{white-space:nowrap}.hero-trace{display:grid;grid-template-columns:max-content 1fr max-content 1fr max-content;gap:1rem;align-items:center;margin-top:3.2rem;padding-top:1rem;border-top:1px solid #c5c4c0;color:#656c70;font-size:.62rem;font-weight:800;letter-spacing:.12em}.hero-trace i{height:1px;background:#9c9d99;transform-origin:left;animation:trace-draw 1.1s ease-out both}.hero-trace i:nth-of-type(2){animation-delay:.18s}@keyframes trace-draw{from{transform:scaleX(0)}to{transform:scaleX(1)}}
  .problem-section,.library-section,.current-section,.work-section,.founder-section,.services-section,.channels-section{padding:clamp(4rem,8vw,7.5rem) 0}.section-intro{display:grid;grid-template-columns:minmax(0,1fr) minmax(250px,.65fr);gap:clamp(2rem,7vw,7rem);align-items:end;margin-bottom:2.5rem}.section-intro>div{min-width:0}.section-intro .editorial-folio{margin-bottom:2rem}.section-intro h2,.current-heading h2,.tool-grid h2,.founder-grid h2,.channels-grid h2{margin:0;font-size:clamp(2.8rem,5.7vw,5.8rem);line-height:.9;letter-spacing:-.055em;font-weight:600}.section-intro>p{max-width:420px;margin:0 0 .3rem;color:var(--home-muted);line-height:1.55}.section-intro--compact{margin-bottom:2rem}.problem-band{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));border-top:1px solid var(--home-ink);border-bottom:1px solid var(--home-ink)}.problem-topic{min-width:0;border-right:1px solid var(--home-line)}.problem-topic:first-child{border-left:1px solid var(--home-line)}.problem-topic[open]{background:#f5f3ef}.problem-topic summary{position:relative;display:grid;grid-template-rows:auto 1fr auto;gap:1rem;min-height:156px;padding:1rem .8rem .8rem;cursor:pointer;list-style:none}.problem-topic summary::-webkit-details-marker{display:none}.problem-topic summary:focus-visible{outline:3px solid var(--c-orange);outline-offset:-3px}.problem-topic__number{color:var(--c-orange);font:600 1.1rem/1 var(--font-editorial)}.problem-topic summary strong{align-self:end;font-size:clamp(.78rem,1vw,.94rem);line-height:1.08}.problem-topic__plus{justify-self:end;color:var(--c-orange);font-size:1.2rem;line-height:.8;transition:transform .25s ease}.problem-topic[open] .problem-topic__plus{transform:rotate(45deg)}.problem-topic__detail{padding:0 .8rem 1rem;animation:detail-in .22s ease-out}.problem-topic__detail p{margin:0 0 .8rem;color:var(--home-muted);font-size:.77rem;line-height:1.45}.problem-topic__detail a,.tool-note a{color:inherit;font-size:.72rem;font-weight:800;text-decoration:none}.problem-topic__detail a span,.tool-note a span{color:var(--c-orange)}@keyframes detail-in{from{opacity:.45;transform:translateY(-4px)}to{opacity:1;transform:translateY(0)}}
  .library-section{background:#fff}.home-feature{margin-top:1rem}.home-article-rows{margin-top:1rem}.text-link{display:inline-flex;gap:.5rem;align-items:center;margin-top:1.5rem;color:inherit;font-size:.78rem;font-weight:800;text-decoration:none}.text-link span{color:var(--c-orange);transition:transform .2s ease}.text-link:hover span{transform:translate(3px,-3px)}.current-section{background:#e9edf0}.current-grid{display:grid;grid-template-columns:minmax(260px,.75fr) minmax(0,1.25fr);gap:clamp(2rem,8vw,8rem);align-items:start}.current-heading .editorial-folio{margin-bottom:2rem}.current-heading h2{font-size:clamp(2.4rem,4.7vw,4.8rem)}.current-heading>p:not(.eyebrow){max-width:360px;margin:1rem 0 0;color:var(--home-muted);font-size:.9rem;line-height:1.5}.current-list{border-top:1px solid var(--home-ink)}.current-item{display:grid;grid-template-columns:32px minmax(0,1fr) 20px;gap:1rem;align-items:start;padding:1.2rem .3rem;border-bottom:1px solid var(--home-line);color:inherit;text-decoration:none}.current-item:hover{background:#ffffff85}.current-item__number{padding-top:.1rem;color:var(--c-orange);font:600 1rem/1 var(--font-editorial)}.current-item>span:nth-child(2){display:grid;gap:.4rem}.current-item small{color:#526b7d;font-size:.65rem;font-weight:800;text-transform:uppercase;letter-spacing:.07em}.current-item strong{font-size:1.12rem;line-height:1.12}.current-item>span>span{color:var(--home-muted);font-size:.77rem;line-height:1.4}.current-item>b{color:var(--c-orange)}
  .work-section{background:var(--home-paper)}.work-sequence{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));margin:3.4rem 0 0;padding:0;list-style:none;border-top:2px solid var(--c-orange)}.work-sequence li{position:relative;display:flex;min-height:112px;flex-direction:column;gap:1rem;padding:1rem .6rem 1rem 0;border-right:1px solid var(--home-line)}.work-sequence li+li{padding-left:.7rem}.work-sequence li:last-child{border:0}.work-sequence__number{color:var(--c-orange);font:600 .88rem/1 var(--font-editorial)}.work-sequence li strong{max-width:130px;font-size:clamp(.78rem,1vw,1rem);line-height:1.1}.work-sequence__connector{position:absolute;top:-6px;right:-4px;width:8px;height:8px;border-radius:50%;background:var(--c-orange)}.work-foot{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-top:1.5rem}.work-foot p{max-width:670px;margin:0;color:var(--home-muted);font-size:.83rem;line-height:1.5}.work-foot p strong{color:var(--home-ink)}
  .tool-section{padding:clamp(4rem,8vw,7rem) 0;background:var(--c-chocolate);color:#fff}.tool-grid{display:grid;grid-template-columns:1fr .8fr;gap:clamp(2rem,8vw,8rem);align-items:center}.tool-grid .editorial-folio{margin-bottom:2rem}.tool-grid h2{font-size:clamp(2.7rem,5.2vw,5.2rem)}.tool-grid>div:first-child>p:not(.eyebrow){max-width:490px;margin:1rem 0 0;color:#d4d1cd;line-height:1.55}.text-link--light{color:#fff}.tool-note{min-height:250px;padding:1.6rem 0 1.6rem 2rem;border-left:2px solid var(--c-orange);align-content:center}.tool-note__status{display:block;margin-bottom:1rem;color:#ef9b68;font-size:.62rem;font-weight:900;letter-spacing:.12em}.tool-note h3{max-width:460px;margin:0 0 .7rem;font-size:clamp(1.6rem,3vw,2.7rem);line-height:.98}.tool-note p{max-width:440px;color:#d4d1cd;font-size:.86rem;line-height:1.5}.tool-note a{color:#fff}
  .founder-section{background:#fff}.founder-grid{display:grid;grid-template-columns:.8fr 1fr;gap:clamp(2.5rem,10vw,10rem);align-items:center}.founder-mark{position:relative;display:grid;min-height:390px;place-content:center;overflow:hidden;background:#263b47;color:#fff}.founder-mark>span{font:600 clamp(6rem,15vw,12rem)/.8 var(--font-editorial);letter-spacing:-.1em}.founder-mark>i{position:absolute;top:17%;left:50%;width:1px;height:66%;background:#ffffff60;transform:rotate(37deg)}.founder-mark>small{position:absolute;right:1.2rem;bottom:1.1rem;color:#e0a070;font-size:.63rem;font-weight:900;letter-spacing:.1em;line-height:1.5}.founder-grid .editorial-folio{margin-bottom:2rem}.founder-grid h2{font-size:clamp(3.2rem,6vw,6rem)}.founder-lead{max-width:570px;margin:1.3rem 0 .8rem;font:500 clamp(1.1rem,1.7vw,1.45rem)/1.42 var(--font-editorial)}.founder-grid>div:last-child>p:not(.eyebrow,.founder-lead){max-width:510px;color:var(--home-muted);line-height:1.55}
  .services-section{background:#f5f3ef}.service-list{border-top:2px solid var(--home-ink)}.service-row{display:grid;grid-template-columns:50px minmax(0,1fr) auto;gap:1.3rem;align-items:center;padding:1.35rem 0;border-bottom:1px solid var(--home-line)}.service-row__number{color:var(--c-orange);font:600 1.5rem/.9 var(--font-editorial)}.service-row h3{margin:0 0 .35rem;font-size:clamp(1.25rem,2.4vw,2.25rem);line-height:1.05}.service-row p{max-width:640px;margin:0;color:var(--home-muted);font-size:.85rem;line-height:1.45}.service-row>a{display:inline-flex;gap:.5rem;align-items:center;color:inherit;font-size:.72rem;font-weight:800;text-decoration:none;white-space:nowrap}.service-row>a span{color:var(--c-orange)}
