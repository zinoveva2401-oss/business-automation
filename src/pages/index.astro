.author-collage{grid-template-columns:18% 30% 52%}.practice{position:static;grid-column:1;align-self:end;width:auto;padding:.75rem .35rem .8rem .75rem;background:transparent;box-shadow:none}.author-photo{grid-column:2}.author-copy{grid-column:3}.practice strong{font-size:2.2rem}.practice ul{gap:.45rem;padding-top:.7rem}.practice li{line-height:1.25}:global(.site-footer .footer-brand){padding-left:18px}:global(.site-footer .footer-brand:before){left:2px;right:auto}
