ort :global(.editorial-article-row__body>strong){font-size:13px}.spotlight-support :global(.editorial-article-row__meta){font-size:8px}.spotlight-support :global(.editorial-article-row__meta b){font-size:8px}.section-links{margin-top:8px}.tools-teaser{padding:25px 0}.teaser-grid{grid-template-columns:1fr;gap:15px}.teaser-copy h2{font-size:35px}.teaser-copy p:not(.eyebrow){margin-bottom:9px;font-size:13px}.teaser-evidence{grid-template-columns:1fr 1fr;gap:9px}.tool-preview{min-height:145px}.tool-caption{padding:10px}.tool-caption span{font-size:8px}.tool-caption strong{font-size:17px}.tool-caption p{margin-top:6px;font-size:10px}.founder-section{padding:25px 0}.founder-grid{grid-template-columns:1fr;gap:14px}.founder-photo{height:250px}.founder-photo img{object-position:50% 43%}.founder-copy h2{font-size:38px}.founder-copy>p:not(.eyebrow){font-size:13px}.founder-steps{gap:7px 12px;margin:12px 0 5px;padding-top:9px;font-size:10px}.services-section{padding-top:27px;padding-bottom:28px}.services-heading{gap:8px}.services-heading>p{font-size:12px}.service-cards-v4{grid-template-columns:1fr;gap:6px}.service-cards-v4 a{grid-template-columns:38px minmax(0,1fr) 18px;grid-template-rows:auto auto;min-height:79px;padding:11px 12px}.service-number{font-size:24px}.service-cards-v4 strong{font-size:18px}.service-cards-v4 small{font-size:10px}.closing-strip{padding:20px 0}.closing-strip>.container{flex-wrap:wrap;gap:9px}.closing-strip h2{flex-basis:100%;font-size:29px}.closing-strip .button,.closing-read{min-height:44px;padding:10px 11px;font-size:11px}}
  @media(prefers-reduced-motion:reduce){.trace-node,.service-cards-v4 a{transition:none}}
</style>

<style>
  /* HOME-LOWER-FINAL-05 */
  .section-links{display:none}
  .tools-teaser{padding:clamp(34px,4.3vw,58px) 0;background:#F4F5F6}
  .teaser-grid{grid-template-columns:minmax(250px,.72fr) minmax(0,1.28fr);gap:clamp(22px,4vw,52px)}
  .teaser-copy .eyebrow{margin-bottom:8px}
  .teaser-copy h2{margin-bottom:12px}
  .teaser-copy p:not(.eyebrow){margin-bottom:17px}
  .teaser-copy>a{display:inline-flex;min-height:44px;align-items:center;padding:10px 16px;border:1px solid #d9562f;border-radius:999px;color:#262626}
  .teaser-evidence{position:relative;display:block;min-width:0}
  .tool-preview{display:block;height:auto;aspect-ratio:3/1;min-height:0;overflow:hidden;background:#e8e9e9;box-shadow:none}
  .tool-preview picture,.tool-preview img{display:block;width:100%;height:100%}
  .tool-preview img{object-fit:contain;object-position:center}
  .tool-steps{position:absolute;right:0;bottom:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px 16px;width:min(390px,76%);margin:0;padding:15px 17px;border:1px solid #e0e3e5;background:#fffffff2;list-style:none}
  .tool-steps li{position:relative;padding-left:14px;color:#34383a;font-size:11px;line-height:1.3}
  .tool-steps li:before{position:absolute;top:.25em;left:0;width:7px;height:7px;border:1px solid #d9562f;border-radius:50%;content:''}
