:global(.site-footer){padding-top:1.2rem}:global(.site-footer .footer-social){display:none}:global(.site-footer .footer-grid){gap:1.25rem}:global(.site-footer .copyright){padding-top:.6rem}
.hero-copy>p{font-size:.9rem}.section-link,.topic-grid a{font-size:.875rem}.article-rail{grid-template-columns:repeat(min(5,var(--article-count,5)),1fr)}.article-rail.count-1{--article-count:1;max-width:760px}.article-rail.count-1 article{display:grid;grid-template-columns:46% 54%}.article-rail.count-1 .article-image{grid-row:1/4;height:100%;min-height:210px}.article-rail.count-1 h3{align-self:end;margin:1rem 1rem .4rem}.article-rail.count-1 article>p{margin:.2rem 1rem}.article-rail.count-1 article>div{margin-top:auto}.article-rail.count-2{--article-count:2}.article-rail.count-3{--article-count:3}.article-rail.count-4{--article-count:4}.article-rail.count-5{--article-count:5}.article-rail h3{font-size:.875rem}.article-rail article>p{margin:.1rem .55rem .45rem;color:#555e65;font-size:.875rem}.article-rail small,.article-image span{font-size:.72rem}.product-rail.count-1{grid-template-columns:minmax(300px,580px)}.product-rail.count-2{grid-template-columns:repeat(2,minmax(260px,1fr))}.product-rail.count-3{grid-template-columns:repeat(3,1fr)}.product-rail.count-4{grid-template-columns:repeat(4,1fr)}.product-rail.count-5{grid-template-columns:repeat(5,1fr)}.product-rail.count-1 article{display:grid;grid-template-columns:48% 52%}.product-rail.count-1 .product-image{height:100%;min-height:210px}.product-copy h3,.product-copy p,.product-copy footer a{font-size:.875rem}.product-copy>small,.product-image span{font-size:.72rem}.author-collage{position:relative;grid-template-columns:44% 56%}.practice{position:absolute;z-index:2;top:1rem;left:0;width:25%;padding:.8rem;background:#f6f7f7e8}.practice ul{font-size:.875rem}.author-photo{grid-column:1}.author-copy{grid-column:2;padding-left:2rem}.author-copy>p:not(.eyebrow),.facts span,.author-copy>a{font-size:.875rem}.chart-accent{display:block;color:var(--c-blue);font-size:3.4rem}.service-grid h3,.service-grid p,.service-grid a,.social-grid a{font-size:.875rem}.social-grid h2{font-size:1rem}:global(.site-footer .footer-grid a),:global(.site-footer .footer-grid button),:global(.site-footer .footer-about p){font-size:.875rem;color:#d2d6d9}
