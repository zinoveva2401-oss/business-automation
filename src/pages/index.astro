---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getActiveServices, getPublishedArticles, getVisibleProducts } from '../lib/content';
import { categories, homeChannels, topicForCategory } from '../lib/site';

const articles = await getPublishedArticles();
const featuredArticle = articles.find(({ data }) => data.featured) ?? articles[0];
const supportingArticles = articles.filter(({ id }) => id !== featuredArticle?.id).slice(0, 3);
const products = await getVisibleProducts();
const services = await getActiveServices();
const method = [
  { title: 'Фиксируем факт', text: 'Что именно изменилось — без версии о причине.' },
  { title: 'Сверяем условия', text: 'Какие шаги и обстоятельства могли повлиять.' },
  { title: 'Проверяем причину', text: 'Какое наблюдение подтвердит или опровергнет версию.' },
  { title: 'Выбираем действие', text: 'Что сделать дальше и по какому сигналу проверить результат.' },
];
const homeSchema = [
  { '@context': 'https://schema.org', '@type': 'Person', name: 'Светлана Тарасова', jobTitle: 'Основатель «Докрути»', url: Astro.site ? new URL('/about/', Astro.site).href : undefined },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Докрути', description: 'Практические решения для малого бизнеса: понять причину проблемы и выбрать следующий шаг.', url: Astro.site?.href },
];
---

<BaseLayout title="Докрути — когда усилия не дают нужного результата" description="Находим, где не сходятся усилия и результат: выберите задачу бизнеса, изучите проверку и следующий шаг." stickyHeader={true} schema={homeSchema}>
  <div class="home-v3" id="top">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__inner">
        <div class="home-hero__copy">
          <p class="home-kicker">Практические решения для малого бизнеса</p>
          <h1 id="home-title">Усилий много.<br /><em>Результат не тот?</em></h1>
          <p>Найдём, где не сходятся действия, причина и следующий шаг.</p>
          <a class="hero-cta" href="#problems" data-analytics-event="hero_cta" data-analytics-placement="home_hero">Найти свою ситуацию <span aria-hidden="true">↓</span></a>
        </div>
        <svg class="home-hero__art" viewBox="0 0 900 620" role="img" aria-labelledby="hero-art-title hero-art-desc">
          <title id="hero-art-title">Листы рабочего учёта расходятся в одной точке</title>
          <desc id="hero-art-desc">Слои бумаг и строк учёта смещены друг относительно друга; одна оранжевая отметка выделяет расхождение.</desc>
          <defs>
            <filter id="paper-shadow" x="-30%" y="-30%" width="160%" height="170%"><feDropShadow dx="0" dy="22" stdDeviation="18" flood-color="#191710" flood-opacity=".2"/></filter>
            <pattern id="fine-rule" width="30" height="28" patternUnits="userSpaceOnUse"><path d="M0 27.5H30" stroke="#a9a49b" stroke-opacity=".45"/></pattern>
            <pattern id="dark-rule" width="34" height="30" patternUnits="userSpaceOnUse"><path d="M0 29.5H34" stroke="#6c695f" stroke-opacity=".42"/></pattern>
          </defs>
          <g class="paper paper--back" filter="url(#paper-shadow)" transform="translate(230 80) rotate(9 240 230)">
            <rect x="12" y="10" width="470" height="430" fill="#d9d4c9"/>
            <rect x="32" y="38" width="430" height="370" fill="url(#fine-rule)"/>
            <path d="M72 95h142M72 123h208M72 179h113M72 207h248M72 263h164M72 291h220M72 347h120" stroke="#69665f" stroke-opacity=".3" stroke-width="8"/>
            <circle cx="420" cy="82" r="16" fill="#bfb9ad"/><circle cx="420" cy="82" r="6" fill="#f0ece2"/>
          </g>
          <g class="paper paper--middle" filter="url(#paper-shadow)" transform="translate(295 45) rotate(-7 225 245)">
            <path d="M14 22h426v446l-28-8-23 9-30-9-24 8-32-9-30 8-30-9-28 8-30-8-32 8-28-8-31 8-28-8-30 7V22z" fill="#f6f2e8"/>
            <rect x="40" y="55" width="375" height="365" fill="url(#fine-rule)"/>
            <path d="M83 112h166M83 140h255M83 196h127M83 224h292M83 280h195M83 308h245M83 364h150" stroke="#78746b" stroke-opacity=".4" stroke-width="8"/>
            <path d="M309 55v365" stroke="#c3bdb1" stroke-width="2"/>
          </g>
          <g class="paper paper--front" filter="url(#paper-shadow)" transform="translate(365 128) rotate(5 190 200)">
            <rect x="0" y="0" width="380" height="370" fill="#fbf9f1"/>
            <rect x="24" y="27" width="332" height="315" fill="url(#dark-rule)"/>
            <path d="M60 82h118M60 112h185M60 172h95M60 202h218M60 262h148M60 292h198" stroke="#48473f" stroke-opacity=".4" stroke-width="8"/>
            <path d="M238 28v314" stroke="#c9c3b8" stroke-width="2"/>
          </g>
          <g class="orange-mark" transform="translate(590 347) rotate(-7)">
            <path d="M-82 0c38-53 134-52 171-4 36 47-7 112-80 112-78 0-130-59-91-108z" fill="none" stroke="#e75d35" stroke-width="7" stroke-linecap="round"/>
            <circle cx="3" cy="52" r="11" fill="#e75d35"/>
            <path d="M44 49h106" stroke="#e75d35" stroke-width="3" stroke-linecap="round"/>
          </g>
        </svg>
        <span class="hero-caption">Когда работа не складывается в результат</span>
      </div>
    </section>

    <section class="problems-section" id="problems" aria-labelledby="problems-title">
      <div class="container">
        <div class="section-head section-head--line">
          <div><p class="home-kicker">Начните с того, что болит</p><h2 id="problems-title">Где застрял бизнес?</h2></div>
          <span class="section-aside">Выберите направление</span>
        </div>
        <nav class="problem-track" aria-label="Выберите задачу бизнеса">
          {categories.map((topic, index) => {
            const directTopic = topicForCategory(topic.name) ?? topic;
            return <a class="problem-link" href={'/topics/' + directTopic.slug + '/'} data-analytics-event="pain_topic_click" data-analytics-category={topic.slug} data-analytics-placement="home_problem_track">
              <span class="problem-link__node" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="problem-link__name">{topic.name}</span>
              <span class="problem-link__arrow" aria-hidden="true">↗</span>
            </a>;
          })}
        </nav>
      </div>
    </section>

    <section class="articles-section" id="articles" aria-labelledby="articles-title">
      <div class="container">
        <div class="section-head">
          <div><p class="home-kicker">Библиотека</p><h2 id="articles-title">Разобраться глубже</h2></div>
          <a class="text-link" href="/articles/">Все статьи <span aria-hidden="true">↗</span></a>
        </div>
        {featuredArticle && <div class="articles-layout">
          <article class="featured-article">
            <a class="featured-article__cover" href={'/articles/' + featuredArticle.data.slug + '/'} aria-label={'Читать: ' + featuredArticle.data.title} data-analytics-event="article_click" data-analytics-content-id={featuredArticle.data.id} data-analytics-placement="home_featured_article">
              {featuredArticle.data.cover ? <img src={featuredArticle.data.cover} alt={featuredArticle.data.coverAlt ?? 'Иллюстрация к статье ' + featuredArticle.data.title} width="900" height="560" loading="lazy" /> : <span class="cover-fallback" aria-hidden="true">Д</span>}
              <span class="cover-label">Проверить причину <b aria-hidden="true">↗</b></span>
            </a>
            <div class="featured-article__copy">
              <span class="article-meta">{topicForCategory(featuredArticle.data.category)?.name ?? featuredArticle.data.category} · {featuredArticle.data.readingTime} мин</span>
              <h3><a href={'/articles/' + featuredArticle.data.slug + '/'} data-analytics-event="article_click" data-analytics-content-id={featuredArticle.data.id} data-analytics-placement="home_featured_article">{featuredArticle.data.title}</a></h3>
              <a class="text-link" href={'/articles/' + featuredArticle.data.slug + '/'} data-analytics-event="article_click" data-analytics-content-id={featuredArticle.data.id} data-analytics-placement="home_featured_article">Читать статью <span aria-hidden="true">↗</span></a>
            </div>
          </article>
          <div class="supporting-articles" aria-label="Ещё три статьи">
            {supportingArticles.map((article, index) => <article class="supporting-article">
              <span class="supporting-article__index" aria-hidden="true">0{index + 1}</span>
              <div><span class="article-meta">{topicForCategory(article.data.category)?.name ?? article.data.category}</span><h3><a href={'/articles/' + article.data.slug + '/'} data-analytics-event="article_click" data-analytics-content-id={article.data.id} data-analytics-placement="home_supporting_article">{article.data.title}</a></h3></div>
              <a class="supporting-article__arrow" href={'/articles/' + article.data.slug + '/'} aria-label={'Читать: ' + article.data.title} data-analytics-event="article_click" data-analytics-content-id={article.data.id} data-analytics-placement="home_supporting_article">↗</a>
            </article>)}
          </div>
        </div>}
        {!featuredArticle && <div class="empty-library"><p>Материалы появятся в библиотеке.</p><a class="text-link" href="/topics/">Посмотреть направления <span aria-hidden="true">↗</span></a></div>}
      </div>
    </section>

    <section class="approach-section" id="approach" aria-labelledby="approach-title" data-approach>
      <div class="container">
        <div class="approach-heading"><p class="home-kicker">Подход «Докрути»</p><h2 id="approach-title">От симптома — к действию</h2><a class="text-link" href="/about/" data-analytics-event="how_dokruti_works_click" data-analytics-placement="home_approach">Как мы работаем <span aria-hidden="true">↗</span></a></div>
        <div class="method">
          <div class="method-steps" role="group" aria-label="Этапы разбора">
            {method.map((step, index) => <button class="method-step" type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-step-index={index} data-step-title={step.title} data-step-text={step.text} data-analytics-event="how_dokruti_works_click" data-analytics-category={String(index + 1)} data-analytics-placement="home_approach_step"><span>{String(index + 1).padStart(2, '0')}</span><b>{step.title}</b><i aria-hidden="true">↗</i></button>)}
          </div>
          <p class="method-detail" aria-live="polite" aria-atomic="true"><span class="method-detail__step">01</span><strong data-step-output-title>{method[0].title}</strong><span data-step-output-text>{method[0].text}</span></p>
        </div>
      </div>
    </section>

    <section class="tools-section" id="tools" aria-labelledby="tools-title">
      <div class="container tools-layout">
        <div class="tools-intro"><p class="home-kicker">Инструменты</p><h2 id="tools-title">Проверить самостоятельно</h2><a class="text-link" href="/tools/" data-analytics-event="tool_click" data-analytics-placement="home_tools">Все инструменты <span aria-hidden="true">↗</span></a></div>
        {products[0] ? <a class="tool-feature" href={'/tools/' + products[0].data.slug + '/'} data-analytics-event="tool_click" data-analytics-content-id={products[0].data.id} data-analytics-placement="home_product">
          {products[0].data.cover && <img src={products[0].data.cover} alt={products[0].data.coverAlt ?? 'Обложка инструмента ' + products[0].data.title} width="300" height="220" loading="lazy" />}
          <span class="tool-feature__copy"><small>Практический инструмент</small><strong>{products[0].data.title}</strong><span>{products[0].data.description}</span><em>Пока не продаётся <b aria-hidden="true">↗</b></em></span>
        </a> : <div class="tool-empty"><strong>Готовых инструментов пока нет.</strong><a class="text-link" href="/services/">Посмотреть услуги <span aria-hidden="true">↗</span></a></div>}
      </div>
    </section>

    <section class="founder-section" id="founder" aria-labelledby="founder-title">
      <div class="container founder-note">
        <span class="founder-note__mark" aria-hidden="true">Д</span>
        <div><p class="home-kicker">Основатель «Докрути»</p><h2 id="founder-title">Светлана Тарасова</h2><p>Практическая работа начинается с внимания к ограничениям бизнеса. Опыт работы с малым бизнесом и исследование управленческих подходов помогают переводить идею в применимый следующий шаг.</p><a class="text-link" href="/about/" data-analytics-event="founder_click" data-analytics-placement="home_founder">История и подход <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="services-section" id="services" aria-labelledby="services-title">
      <div class="container">
        <div class="section-head section-head--services"><div><p class="home-kicker">Личная работа</p><h2 id="services-title">Три способа начать</h2></div><a class="text-link" href="/services/">Все услуги <span aria-hidden="true">↗</span></a></div>
        <div class="service-list">
          {services.map((service, index) => <a class="service-row" href={'/services/' + service.data.slug + '/'} data-analytics-event="service_click" data-analytics-content-id={service.data.id ?? service.data.slug} data-analytics-placement="home_services"><span class="service-row__index">0{index + 1}</span><strong>{service.data.title}</strong><span class="service-row__description">{service.data.description}</span><i aria-hidden="true">↗</i></a>)}
        </div>
        <a class="services-contact" href="/contacts/" data-analytics-event="contact_open" data-analytics-placement="home_services">Не уверены, с чего начать? Опишите задачу <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="channels-section" id="channels" aria-labelledby="channels-title">
      <div class="container">
        <div class="section-head section-head--channels"><div><p class="home-kicker">Продолжить в удобном формате</p><h2 id="channels-title">Каналы и материалы</h2></div><a class="channel-contact" href="/contacts/" data-analytics-event="contact_open" data-analytics-placement="home_channels">Описать задачу <span aria-hidden="true">↗</span></a></div>
        <nav class="channel-list" aria-label="Публичные площадки «Докрути»">
          {homeChannels.map((channel) => <a class="channel-row" href={channel.href} target="_blank" rel="noopener noreferrer" data-analytics-event="channel_subscribe_click" data-analytics-channel-id={channel.id} data-analytics-category={channel.channelId} data-analytics-placement="home_channels">
            <span class="channel-row__short" aria-hidden="true">{channel.short}</span><span class="channel-row__main"><strong>{channel.label}</strong><small>{channel.role}</small></span><b class="channel-row__arrow" aria-hidden="true">↗</b>
          </a>)}
        </nav>
      </div>
    </section>

    <a class="mobile-contact" href="/contacts/" data-analytics-event="click_contact" data-analytics-placement="home_mobile_sticky">Описать задачу <span aria-hidden="true">↗</span></a>
    <button class="back-to-top" type="button" aria-label="Наверх">↑</button>
  </div>
</BaseLayout>

<script>
  const approach = document.querySelector<HTMLElement>('[data-approach]');
  if (approach) {
    const buttons = [...approach.querySelectorAll<HTMLButtonElement>('[data-step-index]')];
    const number = approach.querySelector<HTMLElement>('.method-detail__step');
    const title = approach.querySelector<HTMLElement>('[data-step-output-title]');
    const text = approach.querySelector<HTMLElement>('[data-step-output-text]');
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      const stepNumber = String(Number(button.dataset.stepIndex) + 1).padStart(2, '0');
      if (number) number.textContent = stepNumber;
      if (title) title.textContent = button.dataset.stepTitle ?? '';
      if (text) text.textContent = button.dataset.stepText ?? '';
      approach.style.setProperty('--active-step', button.dataset.stepIndex ?? '0');
    }));
  }

  const masthead = document.querySelector<HTMLElement>('[data-scroll-header]');
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const mobileAction = document.querySelector<HTMLElement>('.mobile-contact');
  const backToTop = document.querySelector<HTMLButtonElement>('.back-to-top');
  const syncNavigation = () => {
    const show = window.scrollY > Math.max(120, (hero?.offsetHeight ?? 500) - 80);
    masthead?.classList.toggle('is-pinned', show);
    mobileAction?.classList.toggle('is-visible', show);
    backToTop?.classList.toggle('is-visible', window.scrollY > 900);
  };
  window.addEventListener('scroll', syncNavigation, { passive: true });
  window.addEventListener('resize', syncNavigation);
  syncNavigation();
  backToTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' }));
</script>

<style>
  .home-v3{--ink:#23251f;--muted:#6b6c65;--line:#cbc9c0;--orange:#e75d35;--paper:#f2f0e8;--serif:var(--font-editorial,Georgia,serif);color:var(--ink)}
  .home-v3 h1,.home-v3 h2,.home-v3 h3,.home-v3 p{margin-top:0}
  .home-v3 a{color:inherit}
  .home-v3 a:focus-visible,.home-v3 button:focus-visible{outline:3px solid var(--orange);outline-offset:4px}
  .home-v3 .home-kicker{margin:0 0 .8rem;color:#a64b2f;font-size:.68rem;font-weight:850;letter-spacing:.12em;text-transform:uppercase}
  .home-hero{overflow:hidden;background:#e8e4da;color:var(--ink)}
  .home-hero__inner{position:relative;display:grid;grid-template-columns:minmax(330px,.86fr) minmax(0,1.14fr);align-items:center;gap:2rem;max-width:1440px;min-height:560px;margin:auto;padding:2.3rem max(4.8vw,2rem)}
  .home-hero__copy{position:relative;z-index:2;max-width:530px}
  .home-hero h1{max-width:560px;margin:0 0 1rem;font:650 clamp(3.5rem,6.1vw,5.8rem)/.94 var(--serif);letter-spacing:-.055em}
  .home-hero h1 em{color:#b94e30;font-style:normal}
  .home-hero__copy>p:not(.home-kicker){max-width:355px;margin:0 0 1.35rem;color:#585a54;font-size:1rem;line-height:1.5}
  .hero-cta{display:inline-flex;min-height:46px;align-items:center;gap:1rem;padding:.65rem 0;border-bottom:2px solid var(--orange);font-size:.86rem;font-weight:800;text-decoration:none}
  .hero-cta span{color:var(--orange);font-size:1.12rem}
  .home-hero__art{display:block;width:100%;max-height:505px;overflow:visible}
  .paper{transform-box:fill-box;transform-origin:center;transition:transform .5s cubic-bezier(.2,.8,.2,1)}
  .paper--back{transform:translate(0,0) rotate(9deg)}.paper--middle{transform:translate(0,0) rotate(-7deg)}.paper--front{transform:translate(0,0) rotate(5deg)}
  .home-hero__art:hover .paper--back{transform:translate(-6px,-4px) rotate(7deg)}.home-hero__art:hover .paper--middle{transform:translate(2px,-5px) rotate(-5deg)}.home-hero__art:hover .paper--front{transform:translate(6px,3px) rotate(7deg)}
  .orange-mark{transform-origin:center;animation:mark-draw 3.2s ease-in-out infinite}
  @keyframes mark-draw{0%,15%{opacity:.55;transform:translate(590px,347px) rotate(-7deg) scale(.9)}55%,100%{opacity:1;transform:translate(590px,347px) rotate(-7deg) scale(1)}}
  .hero-caption{position:absolute;right:5vw;bottom:1.15rem;color:#6b6b64;font-size:.68rem}
  .container{width:min(100% - 2.5rem,1160px);margin-inline:auto}
  .problems-section,.articles-section,.tools-section,.founder-section,.services-section,.channels-section{padding:clamp(3.1rem,5.3vw,4.65rem) 0}
  .problems-section,.tools-section,.founder-section,.services-section,.channels-section{padding-block:calc(clamp(3.1rem,5.3vw,4.65rem) + 2.5rem)}
  .problems-section{background:var(--paper)}
  .section-head{display:flex;justify-content:space-between;align-items:end;gap:1.2rem;margin-bottom:1.55rem}
  .section-head .home-kicker{margin-bottom:.48rem}
  .section-head h2,.approach-heading h2,.tools-intro h2{margin:0;font:630 clamp(2rem,3.4vw,3.05rem)/1 var(--serif);letter-spacing:-.04em}
  .section-aside{padding-bottom:.25rem;color:var(--muted);font-size:.75rem}
  .problem-track{position:relative;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));padding-top:1.35rem;border-top:1px solid #aaa69d}
  .problem-track::before{position:absolute;top:-2px;left:0;right:0;height:3px;background:linear-gradient(90deg,#a9a69e 0 6%,var(--orange) 6% 13%,#a9a69e 13%);content:'';transform:scaleX(.12);transform-origin:left;transition:transform .35s ease}
  .problem-track:hover::before,.problem-track:focus-within::before{transform:scaleX(1)}
  .problem-link{position:relative;display:grid;grid-template-columns:1fr auto;grid-template-rows:auto auto;gap:.55rem .35rem;min-height:104px;padding:.45rem .8rem .35rem;border-right:1px solid #d3cfc6;text-decoration:none;transition:background .18s ease}
  .problem-link:first-child{border-left:1px solid #d3cfc6}
  .problem-link__node{grid-column:1;color:#a54b30;font:600 .7rem/1 var(--serif)}
  .problem-link__name{grid-column:1/-1;max-width:140px;font-size:.92rem;font-weight:760;line-height:1.14}
  .problem-link__arrow{grid-column:2;grid-row:1;color:var(--orange);font-size:.85rem;opacity:.6;transition:transform .18s ease,opacity .18s ease}
  .problem-link:hover,.problem-link:focus-visible{background:#fff7}
  .problem-link:hover .problem-link__arrow,.problem-link:focus-visible .problem-link__arrow{opacity:1;transform:translate(3px,-3px)}
  .articles-section{background:#fff}
  .text-link{display:inline-flex;align-items:center;gap:.6rem;color:#7e391f!important;font-size:.79rem;font-weight:800;text-decoration:none}
  .text-link span{color:var(--orange)}
  .text-link:hover{color:#b54d2e!important}
  .articles-layout{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(310px,.9fr);gap:2.1rem;align-items:stretch}
  .featured-article{display:grid;grid-template-columns:minmax(190px,.78fr) minmax(0,1.22fr);min-height:265px;background:#eeece5}
  .featured-article__cover{position:relative;display:block;min-height:265px;overflow:hidden;background:#d8d3c8}
