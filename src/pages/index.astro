---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { categories, contactLinks, projectLinks, personalMaxLink, projectMaxLink, formatPrice } from '../lib/site';

const articles = (await getCollection('articles')).filter(({ data }) => !data.draft).sort((a,b) => b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
const homeArticles = [...articles.filter(({data})=>data.featured),...articles.filter(({data})=>!data.featured)].slice(0,5);
const tools = await getCollection('tools');
const homeProducts = [...tools.filter(({data})=>data.status==='published'&&data.featured),...tools.filter(({data})=>data.status==='published'&&!data.featured),...tools.filter(({data})=>data.status==='comingSoon'&&data.featured)].slice(0,5);
const services = (await getCollection('services')).filter(({data})=>data.active).sort((a,b)=>a.data.order-b.data.order);
const serviceImages=['/service-cards/ChatGPT Image 24 авг. 2026 г., 16_29_15 (1).png','/service-cards/ChatGPT Image 24 авг. 2026 г., 16_29_15 (2).png','/service-cards/ChatGPT Image 24 авг. 2026 г., 16_29_15 (3).png'];
const homeContactLinks = [...contactLinks, personalMaxLink];
const homeProjectLinks = [...projectLinks, projectMaxLink];
const personSchema={'@context':'https://schema.org','@type':'Person',name:'Светлана Тарасова',jobTitle:'Эксперт по управлению, продажам и операционной деятельности',image:Astro.site?new URL('/svetlana-home.png.png',Astro.site).href:'/svetlana-home.png.png'};
---
<BaseLayout title="Розница в цифрах — системное управление магазином" description="Практические статьи, цифровые инструменты и услуги для собственников, директоров и управляющих непродовольственных магазинов." darkHeader={true} image="/hero-retail-investigation.png.png" schema={personSchema} heroPreload={true}>
<section class="hero"><div class="container hero-inner"><div class="hero-copy"><h1>От хаоса<br/>в торговле<br/><em>к понятной системе</em></h1><p>Практические инструменты для розницы и управления торговым бизнесом</p><div class="hero-actions"><a class="button button--primary" href="/articles/">Читать статьи <i class="ti ti-arrow-right"></i></a><a class="button button--outline" href="/tools/">Смотреть продукты <i class="ti ti-shopping-bag"></i></a></div></div></div></section>

<section class="topics"><div class="container"><div class="section-head"><h2>Темы и направления</h2></div><nav class="topic-grid" aria-label="Темы статей">{categories.map(category=><a href={`/articles/?category=${category.slug}`} data-analytics-event="click_article_category" data-analytics-category={category.name} data-analytics-placement="home_topics"><i class={`ti ${category.icon}`}></i><span>{category.name}</span></a>)}</nav></div></section>

<section class="articles"><div class="container"><div class="section-head"><h2>Свежие статьи</h2><a class="section-link" href="/articles/">Все статьи</a></div><div class:list={['article-rail',`count-${homeArticles.length}`]}>{homeArticles.map(article=><article><a class="home-article-link" href={`/articles/${article.data.slug}/`} aria-label={article.data.title}><div class:list={['article-image',!article.data.cover&&'article-image--editorial']}>{article.data.cover?(article.data.cover === '/hero-retail-investigation.png.png'?<picture><source media="(max-width: 600px)" srcset="/_optimized/hero-retail-investigation.png.w768.webp" /><img src={article.data.cover} alt={article.data.coverAlt || ''} width="520" height="293" loading="lazy" fetchpriority="high" /></picture>:<img src={article.data.cover} alt={article.data.coverAlt || ''} width="520" height="293" loading="lazy" />):<i class="ti ti-file-description" aria-hidden="true"></i>}</div><span class="article-category">{article.data.category}</span><h3>{article.data.title}</h3></a></article>)}</div></div></section>

<section class="products"><div class="container product-shell"><div class="section-head"><h2>Инструменты для вашего бизнеса</h2>{homeProducts.length > 0 && <a class="section-link" href="/tools/">Инструменты</a>}</div>{homeProducts.length > 0 ? <div class:list={['product-rail',`count-${homeProducts.length}`]}>{homeProducts.map((product)=><article><a class="product-image" href={`/tools/${product.data.slug}/`} data-analytics-event="click_product" data-analytics-product-id={product.data.id} data-analytics-placement="home_product"><ResponsiveImage src={product.data.cover} alt={product.data.coverAlt} width={1672} height={941} loading="lazy" fetchpriority="auto" sizes="(max-width: 600px) 100vw, 560px" /><span>{product.data.status==='published'?'Доступен':'В разработке'}</span></a><div class="product-copy"><small>{product.data.cardFormat ?? product.data.type}</small><h3><a href={`/tools/${product.data.slug}/`} data-analytics-event="click_product" data-analytics-product-id={product.data.id} data-analytics-placement="home_product">{product.data.title}</a></h3><p>{product.data.cardDescription ?? product.data.description}</p><div class="product-price">{formatPrice(product.data.price, product.data.pricePrefix)}</div><footer><a href={`/tools/${product.data.slug}/`} data-analytics-event="click_product_catalog" data-analytics-product-id={product.data.id} data-analytics-placement="home_product">Подробнее</a></footer></div></article>)}</div> : <p class="product-announcement">Направление развивается: новые рабочие инструменты появятся после проверки на реальных задачах.</p>}</div></section>

<section class="author"><div class="container author-story"><picture class="author-visual"><source media="(max-width: 800px)" srcset="/about/author-home-mobile.webp" /><img src="/about/author-home-desktop.webp" alt="Светлана Тарасова в пространстве магазина и аналитическая схема" width="1799" height="875" loading="lazy" /></picture><div class="author-content"><h2>Привет, я <em>Светлана Тарасова</em></h2><p>19 лет опыта в торговле и управлении бизнесом. Помогаю находить слабые места в продажах и рабочих процессах, наводить порядок и превращать проблемы в понятные решения, которые можно внедрить в работу.</p><div class="facts"><span><i class="ti ti-building-store"></i>Розничная торговля, опт, закупки и производство</span><span><i class="ti ti-buildings"></i>Управление магазинами и сетями</span><span><i class="ti ti-route"></i>Продажи, персонал и бизнес-процессы</span><span><i class="ti ti-tool"></i>Автор практических инструментов</span></div><a href="/about/">Обо мне <i class="ti ti-arrow-right"></i></a></div></div></section>

<section class="services"><div class="container"><div class="section-head"><h2>Услуги</h2><a class="section-link" href="/services/">Все услуги</a></div><div class="service-grid">{services.map((service,index)=><article><img src={serviceImages[index]} alt="" width="420" height="250" loading="lazy" /><div><span>0{index+1}</span><h3>{service.data.title}</h3><p>{service.data.description}</p><a href={`/services/#${service.data.slug}`} data-analytics-event="click_service" data-analytics-service-id={service.data.id} data-analytics-placement="home_services">Смотреть описание <i class="ti ti-arrow-right"></i></a></div></article>)}</div></div></section>

<aside id="question" class="social-panel"><div class="container social-grid"><div><h2>Задать вопрос</h2><nav>{homeContactLinks.map(link=><a href={link.href} target="_blank" rel="noopener noreferrer" data-analytics-event={link.event} data-analytics-placement="home_contacts"><i class={`ti ${link.icon}`}></i>{link.label}</a>)}</nav></div><div><h2>Читать проект</h2><nav>{homeProjectLinks.map(link=><a href={link.href} target="_blank" rel="noopener noreferrer" data-analytics-event={link.event} data-analytics-placement="home_platforms"><i class={`ti ${link.icon}`}></i>{link.label}</a>)}</nav></div></div></aside>


<style>.product-announcement{max-width:620px;margin:.35rem 0 0;color:#626a70;font-family:var(--font-editorial);font-size:1.1rem;line-height:1.35}</style>
</BaseLayout>

<style>
.hero{position:relative;min-height:350px;overflow:hidden;background-color:var(--c-ink);background-position:69% center;background-size:cover;background-repeat:no-repeat;color:#fff}.hero::after{position:absolute;inset:0;content:'';background:linear-gradient(90deg,#0e1114 0%,#0e1114f5 29%,#0e11149a 47%,#0e111408 75%)}.hero-inner{position:relative;z-index:1;display:flex;min-height:350px;align-items:center}.hero-copy{width:42%}.hero h1{margin:0;font-size:clamp(2.55rem,4.2vw,4rem);line-height:.92}.hero h1 em{color:var(--c-orange);font-style:normal}.hero-copy>p{max-width:390px;margin:.8rem 0 1rem;font-size:.86rem}.hero-actions{display:flex;gap:.55rem}.hero-actions .button{min-height:40px;padding:.65rem 1rem;font-size:.75rem}
