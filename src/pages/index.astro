---
import BaseLayout from '../layouts/BaseLayout.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ProductCard from '../components/ProductCard.astro';
import { getPublishedArticles, getVisibleProducts } from '../lib/content';
import { categories } from '../lib/site';
const articles=await getPublishedArticles();
const tools=await getVisibleProducts();
const featuredArticle=articles[0];
const supportingArticles=articles.slice(1,3);
const heroSchema={'@context':'https://schema.org','@type':'Person',name:'Светлана Тарасова',jobTitle:'Основатель и практик',url:Astro.site?new URL('/about/',Astro.site).href:undefined};
---
<BaseLayout title="Докрути — практические решения для бизнеса" description="Статьи, инструменты и практические решения для задач продаж, ассортимента, клиентов, команды, управления, маркетинга и ИИ." image="/hero-dokruti-editorial.png" schema={heroSchema} heroPreload={true}>
<section class="hero"><div class="hero-art"><ResponsiveImage src="/hero-dokruti-editorial.png" alt="Рабочие документы, данные и оранжевый trace, ведущий к результату" width={1792} height={1024} loading="eager" fetchpriority="high" sizes="(max-width: 700px) 100vw, 58vw" /></div><div class="container hero-inner"><div class="hero-copy"><p class="eyebrow">Практические решения для бизнеса</p><h1>Найти, что мешает бизнесу работать лучше. <em>И докрутить до понятного решения.</em></h1><p class="hero-lead">Статьи, инструменты и практические решения для задач продаж, ассортимента, клиентов, команды, управления, маркетинга и ИИ.</p><div class="hero-actions"><a class="button button--primary" href="#question">Найти решение <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a><a class="hero-secondary" href="#founder">Почему «Докрути» <i class="ti ti-arrow-down" aria-hidden="true"></i></a></div></div></div></section>
<section class="topics"><div class="container"><div class="section-head"><div><p class="eyebrow">Задача, а не отрасль</p><h2>Что нужно докрутить?</h2></div><span class="section-note">Выберите точку, где нужен следующий шаг</span></div><nav class="topic-list" aria-label="Публичные темы">{categories.map((topic,index)=><a class:list={['topic-item',index===0?'topic-item--lead':'']} href={'/topics/' + topic.slug + '/'}><i class={'ti '+topic.icon} aria-hidden="true"></i><span>{topic.name}</span><b>→</b></a>)}</nav></div></section>
<section class="materials"><div class="container"><div class="section-head"><div><p class="eyebrow">Из библиотеки</p><h2>Свежие материалы</h2></div><a class="section-link" href="/articles/">Вся библиотека</a></div><div class="material-layout">{featuredArticle&&<div class="material-feature"><ArticleCard article={featuredArticle} featured placement="home_materials" priority={true}/></div>}<div class="material-supporting">{supportingArticles.map((article)=><ArticleCard article={article} placement="home_materials"/>)}</div></div></div></section>
<section class="tools-band"><div class="container tools-layout"><div><p class="eyebrow">Практический инструмент</p><h2>Проверить проблему на данных</h2><p>Когда вопрос упирается не в совет, а в цифры, нужен порядок проверки. Инструменты «Докрути» помогают пройти его последовательно.</p><a class="text-link text-link--light" href="/tools/">Смотреть инструменты <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div><div class="tool-feature">{tools.slice(0,1).map((tool)=><ProductCard product={tool} placement="home_tool" priority={true}/>)}</div></div></section>
<section class="founder" id="founder"><div class="container founder-grid"><figure class="founder-media"><ResponsiveImage src="/images/about-editorial-workspace.png" alt="Рабочая схема проекта «Докрути» на столе" width={1672} height={941} loading="lazy" sizes="(max-width: 700px) 100vw, 55vw"/><span class="play-affordance" aria-hidden="true"><i class="ti ti-player-play-filled"></i></span><figcaption>Видео о подходе — готовится · фото основателя ожидает согласования</figcaption></figure><div class="founder-copy"><p class="eyebrow">Почему «Докрути»</p><h2>Сначала причина.<br/><em>Потом действие.</em></h2><p class="founder-lead">Светлана Тарасова — основатель и практик.</p><p>«Докрути» появился из простой идеи: не давать ещё один общий совет, а находить причину проблемы и доводить решение до применения.</p><a class="text-link" href="/about/">Познакомиться со Светланой <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></div></section>
<section class="question" id="question"><div class="container question-grid"><div><p class="eyebrow">Если готового материала нет</p><h2>Нужна помощь с конкретной задачей?</h2></div><div><p>Опишите ситуацию. Я посмотрю, могу ли быть полезна, и предложу формат работы, срок и стоимость до начала.</p><a class="button button--primary" href="mailto:hello@dokruti.ru">Задать вопрос <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></div></section>
</BaseLayout>
<style>
.hero{position:relative;min-height:520px;overflow:hidden;background:var(--c-chocolate);color:#fff}.hero-art{position:absolute;inset:0 0 0 39%;opacity:.9}.hero-art::after{position:absolute;inset:0;background:linear-gradient(90deg,var(--c-chocolate) 0%,#17130fe8 19%,#17130f45 62%,#17130f00 100%);content:''}.hero-art img{width:100%;height:100%;object-fit:cover;object-position:center}.hero-inner{position:relative;z-index:1;display:flex;min-height:520px;align-items:center}.hero-copy{width:min(620px,54%)}.hero h1{margin:.3rem 0 1.2rem;font-size:clamp(3.2rem,5.2vw,5.3rem);font-weight:600;line-height:.98;letter-spacing:-.045em}.hero h1 em{color:#ffd2c6;font-style:normal}.hero-lead{max-width:490px;margin:0 0 1.5rem;color:#e4e0dc;font-size:1rem;line-height:1.55}.hero-actions{display:flex;align-items:center;gap:1.2rem}.hero-secondary{color:#fff;font-size:.85rem;font-weight:600;text-decoration:none}.hero-secondary:hover{color:#b8d4f6}.hero-secondary i{margin-left:.25rem;color:var(--c-orange)}.topics,.materials,.founder{padding:var(--section) 0}.topics{background:var(--c-paper)}.section-head{align-items:end}.section-note{max-width:230px;color:var(--c-muted);font-size:.8rem;line-height:1.35;text-align:right}.topic-list{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid var(--c-graphite);border-left:1px solid var(--c-graphite)}.topic-list a{display:grid;grid-template-columns:28px minmax(0,1fr) 18px;gap:.75rem;align-items:center;min-width:0;min-height:80px;padding:1rem;border-right:1px solid var(--c-graphite);border-bottom:1px solid var(--c-graphite);text-decoration:none}.topic-list a:hover{background:#fff}.topic-list i{color:var(--c-blue);font-size:1.25rem}.topic-list span{min-width:0;font-size:.9rem;font-weight:600;overflow-wrap:anywhere}.topic-list b{color:var(--c-orange);font-size:1rem}.materials{background:#fff}.material-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.tools-band{padding:var(--section) 0;background:var(--c-chocolate);color:#fff}.tools-layout{display:grid;grid-template-columns:1fr 1.05fr;gap:clamp(2rem,7vw,7rem);align-items:center}.tools-layout h2{max-width:440px;margin:.4rem 0 .8rem;font-size:clamp(2.2rem,4vw,3.7rem);line-height:1}.tools-layout p:not(.eyebrow){max-width:450px;color:#d2cfca}.text-link{display:inline-flex;align-items:center;gap:.4rem;margin-top:1rem;color:var(--c-graphite);font-size:.85rem;font-weight:700;text-decoration:none}.text-link:hover{color:var(--c-orange)}.text-link--light{color:#fff}.tool-feature :global(.product-card){grid-template-columns:45% 55%;border:1px solid #ffffff30;background:#262626;color:#fff}.tool-feature :global(.product-card>div){padding:1.4rem}.tool-feature :global(.product-card strong){display:none}.tool-feature :global(.product-card>div>p:not(.product-type)){color:#c9c6c1}.founder{background:var(--c-paper)}.founder-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,8vw,8rem);align-items:center}.founder-media{position:relative;margin:0}.founder-media img{width:100%;aspect-ratio:1.7;object-fit:cover}.founder-media figcaption{margin-top:.5rem;color:var(--c-muted);font-size:.72rem}.play-affordance{position:absolute;right:1rem;bottom:2.2rem;display:grid;width:48px;height:48px;place-items:center;border:1px solid #fff;background:var(--c-orange);color:#fff}.founder-copy h2{margin:.4rem 0 1rem;font-size:clamp(2.6rem,4.8vw,4.5rem);line-height:.98}.founder-copy h2 em{color:var(--c-orange);font-style:normal}.founder-lead{font-weight:700}.founder-copy>p:not(.eyebrow){max-width:460px;color:#50575d}.question{padding:clamp(2.5rem,5vw,4.5rem) 0;background:#e8edf2}.question-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);align-items:end}.question h2{max-width:520px;margin:.35rem 0 0;font-size:clamp(2.2rem,4vw,3.8rem);line-height:1.02}.question-grid>div:last-child{max-width:470px}.question-grid p:not(.eyebrow){margin:0;color:#4d5861}.question .button{margin-top:1.1rem}@media(max-width:900px){.hero{min-height:480px}.hero-inner{min-height:480px}.hero-copy{width:65%}.hero-art{inset:0 0 0 32%}.topic-list{grid-template-columns:repeat(2,1fr)}.tools-layout,.founder-grid,.question-grid{gap:2rem}.founder-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.hero{min-height:610px}.hero-art{inset:33% 0 0;opacity:.82}.hero-art::after{background:linear-gradient(180deg,var(--c-chocolate) 0%,#17130f88 35%,#17130f00 100%)}.hero-inner{min-height:610px;align-items:flex-start;padding-top:3rem}.hero-copy{width:100%}.hero h1{font-size:clamp(2.8rem,12vw,4rem)}.hero-lead{font-size:.95rem}.hero-actions{align-items:flex-start;flex-direction:column;gap:.8rem}.section-note{display:none}.material-grid,.tools-layout,.founder-grid,.question-grid{grid-template-columns:1fr}.material-grid{gap:.75rem}.tools-layout{gap:1.5rem}.tool-feature :global(.product-card){grid-template-columns:1fr}.founder-grid{gap:1.5rem}.founder-copy h2{font-size:2.6rem}.question-grid{gap:1rem}}@media(max-width:430px){.topic-list a{grid-template-columns:22px 1fr 12px;gap:.45rem;min-height:68px;padding:.75rem}.topic-list span{font-size:.8rem}.founder-media img{aspect-ratio:1.35}.play-affordance{right:.7rem;bottom:2rem}}
  .tools-layout{grid-template-columns:minmax(0,1fr) minmax(0,1.05fr)}.tools-layout>*,.tool-feature,.tool-feature :global(.product-card),.tool-feature :global(.product-card>div){min-width:0}.material-layout{display:grid;grid-template-columns:1.15fr .85fr;gap:1.5rem}.material-feature :global(.article-card){height:100%;border:0;border-top:3px solid var(--c-orange);border-radius:0}.material-feature :global(.article-card__link){grid-template-columns:minmax(0,1.1fr) minmax(220px,.9fr);grid-template-rows:1fr}.material-feature :global(.article-card__image){order:2;aspect-ratio:auto;min-height:300px}.material-feature :global(.article-card__body){display:flex;flex-direction:column;justify-content:center;padding:1.6rem 1.8rem}.material-supporting{display:grid;gap:0;border-top:1px solid var(--c-graphite)}.material-supporting :global(.article-card){border:0;border-bottom:1px solid var(--c-line);border-radius:0}.material-supporting :global(.article-card__link){grid-template-columns:120px minmax(0,1fr);grid-template-rows:1fr}.material-supporting :global(.article-card__image){aspect-ratio:auto}.material-supporting :global(.article-card__body){display:flex;flex-direction:column;justify-content:center;padding:.8rem 1rem}.material-supporting :global(.article-card h3){font-size:1rem}.material-supporting :global(.article-card__description){display:none}@media(max-width:900px){.material-layout{grid-template-columns:1fr}}@media(max-width:700px){.material-feature :global(.article-card__link),.material-supporting :global(.article-card__link){grid-template-columns:1fr;grid-template-rows:auto 1fr}.material-feature :global(.article-card__image),.material-supporting :global(.article-card__image){order:0;aspect-ratio:16/9;min-height:0}.material-feature :global(.article-card__body){padding:1.2rem 1rem}.material-supporting :global(.article-card__body){padding:1rem}}
@media(min-width:901px){.topic-list a.topic-item--lead{grid-column:span 2;grid-row:span 2;grid-template-columns:36px minmax(0,1fr) 22px;min-height:164px;padding:1.4rem}.topic-list a.topic-item--lead span{font-size:1.25rem;line-height:1.05}.topic-list a.topic-item--lead i{font-size:1.5rem}}
@media(max-width:700px){.topic-list a.topic-item--lead{grid-column:span 2;min-height:92px;background:#fff}.topic-list a.topic-item--lead span{font-size:.95rem}}
</style>
