---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const tool = (await getCollection('tools')).find(({ data }) => data.featured);
const services = (await getCollection('services')).sort((a,b) => a.data.order - b.data.order);
const topics = [
  ['↗','Продажи','Конверсия, средний чек, товары в чеке и работа продавца.'],['◇','Товар','Неликвид, оборачиваемость, остатки и ассортимент.'],['○','Покупатель','Поведение, путь клиента, лояльность и повторные покупки.'],['♙','Персонал','Стандарты, мотивация, обучение и управление командой.'],['▤','Управление','Показатели, планирование и контроль решений.'],['◁','Маркетинг','Привлечение, акции, локальный трафик и воронки.'],['✦','ИИ и автоматизация','ИИ в конкретных задачах магазина и рутине директора.'],
];
const articleSlots = ['Пятиминутка директора: что обсуждать с командой каждый день','Почему падает конверсия в покупку и что с этим делать','Как избавиться от неликвида и вернуть деньги в оборот','Как привлекать покупателей без слива бюджета'];
const money = (value:number) => new Intl.NumberFormat('ru-RU').format(value) + ' ₽';
---
<BaseLayout title="Розница в цифрах — системное управление магазином" description="Практические статьи, инструменты и услуги для собственников и директоров непродовольственных магазинов." darkHeader={true}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy"><p class="hero-kicker">разбираем хаос розничного бизнеса<br>в понятную систему</p><h1>Разберём хаос<br>розничного бизнеса<br><em>в понятную систему</em></h1><p class="hero-lead">Покажем, где теряются деньги, и дадим инструменты, чтобы их вернуть.</p><div class="hero-actions"><a class="button button--primary" href="/articles/">Читать статьи</a><a class="button button--outline" href="/tools/">Смотреть инструменты</a></div></div>
      <div class="hero-scene" role="img" aria-label="Место для утверждённой фотографии реального непродовольственного магазина"><div class="shelf shelf-a"></div><div class="shelf shelf-b"></div><div class="store-light one"></div><div class="store-light two"></div><div class="route">· · · · · · ·</div><p class="note">Следим за покупателем.<br>Ищем, что исправить. ↙</p><span class="image-status">ФОТО RETAIL-СЦЕНЫ<br>ОЖИДАЕТ УТВЕРЖДЕНИЯ</span></div>
    </div>
  </section>

  <section class="topics"><div class="container"><div class="section-head"><div><p class="eyebrow">Карта магазина</p><h2>Что разбираем в магазине</h2></div><a class="section-link" href="/articles/">Все направления</a></div><div class="topic-grid">{topics.map(([icon,title,text]) => <a class="topic" href={`/articles/?topic=${encodeURIComponent(title)}`}><span class="topic-icon">{icon}</span><h3>{title}</h3><p>{text}</p><b aria-hidden="true">→</b></a>)}</div></div></section>

  <section class="articles"><div class="container"><div class="section-head"><div><p class="eyebrow">База знаний</p><h2>Свежие статьи</h2></div><a class="section-link" href="/articles/">Все статьи</a></div><div class="article-grid">{articleSlots.map((title,i) => <article class={`article-card tone-${i+1}`}><div class="slot-pattern" aria-hidden="true"></div><span>{i === 0 ? 'Управление' : 'Материал готовится'}</span><h3>{title}</h3><p>{i === 0 ? '8 мин чтения' : 'Технический анонс'}</p></article>)}</div><p class="content-warning">Карточки показывают композицию макета. Изображения и тексты, кроме первого анонса, будут заменены после утверждения материалов.</p></div></section>

  {tool && <section class="tool"><div class="container"><div class="section-head light"><div><p class="eyebrow">Готовый инструмент</p><h2>Диагностика вместо догадок</h2></div><a class="section-link" href="/tools/">Все инструменты</a></div><div class="tool-panel"><div class="tool-copy"><p class="tool-label">Метод «4 точки диагностики»</p><h3>{tool.data.title}</h3><p>{tool.data.description}</p><strong>{money(tool.data.price)}</strong><div><a class="button button--primary" href={`/tools/${tool.id}/`}>Подробнее</a><span class="button button--outline" aria-disabled="true">Демо позже</span></div></div><div class="dashboard-preview"><div class="kpis"><span><small>Выручка</small><b>—</b></span><span><small>Средний чек</small><b>—</b></span><span><small>Конверсия</small><b>—</b></span></div><div class="chart"><i></i><i></i><i></i><svg viewBox="0 0 320 100" aria-label="Схематичный график без фактических данных"><polyline points="0,75 45,54 92,67 145,30 190,48 240,19 320,42" fill="none" stroke="#2f80ed" stroke-width="4"/></svg></div><p>Визуальный слот интерфейса — без вымышленных показателей</p></div><ul><li>Сравнение двух периодов</li><li>Ключевые показатели</li><li>Поиск узких мест</li><li>Готовые выводы и рекомендации</li></ul></div></div></section>}

  <section class="services"><div class="container"><div class="section-head"><div><p class="eyebrow">Работа со мной</p><h2>От анализа к системе</h2></div><a class="section-link" href="/services/">Все услуги</a></div><div class="service-grid">{services.map(({id,data},i) => <article class="service-card"><span class="service-number">0{i+1}</span><div><h3>{data.title}</h3><p>{data.description}</p></div><strong>{data.pricePrefix} {money(data.price)}</strong><a href={`/services/${id}/`}>Подробнее <span>→</span></a></article>)}</div><p class="hand-note">Разбираем по шагам. Решаем то, что тормозит ваш рост. ⟵</p></div></section>

  <section class="contact"><div class="container contact-panel"><div><p class="eyebrow">Следующий шаг</p><h2>Есть вопрос или нужна помощь?</h2><p>Подтверждённые способы связи появятся здесь после согласования с владельцем.</p><a class="button button--primary" href="/contacts/">Перейти к контактам</a></div><aside><b>Свяжитесь удобным способом</b><span>↙</span></aside></div></section>
</BaseLayout>

<style>
.hero{background:var(--c-ink);color:#fff}.hero-grid{display:grid;grid-template-columns:minmax(420px,.85fr) 1.35fr;min-height:610px}.hero-copy{position:relative;z-index:2;align-self:center;padding:4rem 2rem 5rem 0}.hero-kicker{position:absolute;top:1rem;left:190px;width:240px;font-size:.74rem;color:#ccd0d4}.hero h1{margin:0;font-family:var(--font-editorial);font-size:clamp(3.2rem,5.2vw,6rem);line-height:.92;letter-spacing:-.04em}.hero h1 em{display:block;color:var(--c-orange);font-style:normal}.hero-lead{max-width:470px;margin:2rem 0;font-size:1.15rem}.hero-actions{display:flex;flex-wrap:wrap;gap:1rem}.hero-scene{position:relative;overflow:hidden;min-height:560px;background:linear-gradient(90deg,rgba(23,19,15,.25),rgba(23,19,15,.05)),repeating-linear-gradient(90deg,#21170f 0 18%,#39261a 18% 19%,#17100b 19% 35%);box-shadow:inset 50px 0 80px #17130f}.hero-scene:after{content:'';position:absolute;inset:55% 0 0;background:repeating-linear-gradient(90deg,transparent 0 60px,#402e21 61px),repeating-linear-gradient(0deg,#2c2018 0 44px,#1d1713 45px)}.shelf{position:absolute;z-index:1;border:10px solid #0c0b0a;background:repeating-linear-gradient(0deg,#3b2618 0 14px,#111 15px 22px);filter:brightness(.8)}.shelf-a{inset:15% 57% 20% 5%}.shelf-b{inset:25% 5% 20% 67%}.store-light{position:absolute;z-index:3;top:5%;width:70px;height:70px;border-radius:50%;background:radial-gradient(circle,#f5d5a5 0 8%,#0c0b0a 12% 45%,transparent 47%)}.store-light.one{left:48%}.store-light.two{left:64%}.route{position:absolute;z-index:4;left:44%;top:50%;color:#fff;font-size:4rem;transform:rotate(28deg);letter-spacing:.2rem}.note{position:absolute;z-index:4;right:7%;top:19%;font-family:cursive;font-size:1.12rem;transform:rotate(-3deg)}.image-status{position:absolute;z-index:5;right:2rem;bottom:2rem;padding:.5rem;background:#17130fcc;color:#d8dde3;font-size:.62rem;letter-spacing:.12em}.topics,.articles,.services{padding-block:clamp(3.5rem,6vw,6rem)}.topics{background:#fff}.topic-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:6px}.topic{display:flex;min-height:260px;flex-direction:column;padding:1.3rem;border:1px solid #edf0f3;border-radius:var(--r-md);background:#f8f9fa;text-decoration:none}.topic-icon{color:#0a478c;font-family:var(--font-editorial);font-size:2.8rem}.topic h3{margin:1rem 0 .5rem;font-size:1rem}.topic p{margin:0;color:#4e5359;font-size:.78rem}.topic b{margin-top:auto;color:#0a478c;font-size:1.4rem}.articles{padding-top:0;background:#fff}.article-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.article-card{position:relative;display:flex;min-height:330px;overflow:hidden;flex-direction:column;justify-content:flex-end;padding:1.25rem;border-radius:var(--r-md);background:#151719;color:#fff}.slot-pattern{position:absolute;inset:0;opacity:.48;background:linear-gradient(145deg,transparent 25%,#683b22 26% 38%,transparent 39%),repeating-linear-gradient(90deg,#0d2131 0 35px,#1b1612 36px 75px)}.tone-2 .slot-pattern{transform:scaleX(-1)}.tone-3 .slot-pattern{background:repeating-linear-gradient(0deg,#5e3b25 0 34px,#1a1512 35px 40px)}.tone-4 .slot-pattern{background:linear-gradient(120deg,#10151a,#27455b 55%,#12100f)}.article-card>*:not(.slot-pattern){position:relative}.article-card span{align-self:flex-start;padding:.25rem .45rem;border-radius:.2rem;background:#064e9e;font-size:.65rem;font-weight:800;text-transform:uppercase}.article-card h3{margin:.8rem 0;font-size:1.15rem;line-height:1.25}.article-card p{margin:0;font-size:.75rem}.content-warning{max-width:760px;margin:1rem 0 0;color:#70757a;font-size:.75rem}.tool{padding:var(--section) 0;background:var(--c-paper)}.section-head.light{margin-bottom:1.3rem}.tool-panel{display:grid;grid-template-columns:.85fr 1.25fr .7fr;gap:2rem;padding:2rem;border-radius:var(--r-lg);background:linear-gradient(120deg,#071a31,#173b67);color:#fff}.tool-copy h3{margin:.3rem 0 1rem;font-family:var(--font-editorial);font-size:2.1rem}.tool-copy>strong{display:block;margin:1.3rem 0;color:#ff683d;font-size:1.6rem}.tool-copy>div{display:flex;flex-wrap:wrap;gap:.75rem}.tool-label{color:#9ac8ff;font-weight:700}.dashboard-preview{align-self:center;padding:1rem;border-radius:.7rem;background:#fff;color:var(--c-text);transform:rotate(-.5deg)}.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem}.kpis span{padding:.6rem;background:#f4f5f6}.kpis small,.kpis b{display:block}.kpis b{font-size:1.4rem}.chart{position:relative;height:120px;margin-top:1rem;background:repeating-linear-gradient(0deg,#fff 0 28px,#d8dde3 29px)}.chart svg{position:absolute;inset:12px 0}.dashboard-preview p{margin:.3rem 0 0;font-size:.65rem;color:#71767b}.tool-panel ul{display:grid;align-content:center;gap:1rem;padding:0;list-style:none}.tool-panel li:before{content:'✓';margin-right:.8rem;color:#fff}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.service-card{display:grid;min-height:255px;grid-template-columns:auto 1fr;gap:1rem;padding:1.5rem;border:1px solid #e8eaed;border-radius:var(--r-md);background:#fff}.service-number{color:#174c8b;font-family:var(--font-editorial);font-size:2.4rem}.service-card h3{margin:.35rem 0}.service-card p{margin:.4rem 0;color:#565b61;font-size:.86rem}.service-card>strong{align-self:end;color:var(--c-orange);font-size:1.1rem}.service-card>a{align-self:end;justify-self:end;text-decoration:none;font-size:.85rem}.service-card>a span{display:inline-grid;width:28px;height:28px;margin-left:.3rem;place-items:center;border:1px solid var(--c-line);border-radius:.3rem}.hand-note{text-align:center;color:#084d9e;font-family:cursive;font-size:1.05rem;transform:rotate(-1deg)}.contact{padding:0 0 var(--section);background:var(--c-paper)}.contact-panel{display:grid;grid-template-columns:1fr 290px;gap:2rem;padding:clamp(2rem,5vw,4.5rem);border-radius:var(--r-lg);background:#fff}.contact h2{margin:.2rem 0;font-family:var(--font-editorial);font-size:clamp(2rem,4vw,3.4rem)}.contact aside{display:grid;place-items:center;padding:2rem;border-radius:.4rem;background:var(--c-ink);color:#fff;font-family:cursive;font-size:1.4rem;transform:rotate(-2deg)}.contact aside span{color:var(--c-orange);font-size:3rem}
@media(max-width:1100px){.hero-grid{grid-template-columns:1fr 1fr}.topic-grid{grid-template-columns:repeat(4,1fr)}.article-grid{grid-template-columns:repeat(2,1fr)}.tool-panel{grid-template-columns:1fr 1.2fr}.tool-panel ul{grid-column:1/-1;grid-template-columns:1fr 1fr}.service-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:760px){.hero-grid{grid-template-columns:1fr}.hero-copy{padding:3.5rem 0}.hero-kicker{position:static;margin-bottom:2rem}.hero-scene{min-height:380px;box-shadow:inset 0 50px 80px #17130f}.topic-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.topic{min-width:240px;scroll-snap-align:start}.article-grid{display:flex;overflow-x:auto;scroll-snap-type:x mandatory}.article-card{min-width:82vw;scroll-snap-align:start}.tool-panel{grid-template-columns:1fr;padding:1.25rem}.tool-panel ul{grid-column:auto;grid-template-columns:1fr}.service-grid{grid-template-columns:1fr}.contact-panel{grid-template-columns:1fr}.contact aside{min-height:160px}.section-head h2{font-size:1.7rem}}
@media(max-width:430px){.hero h1{font-size:2.75rem}.hero-actions .button{width:100%}.topic{min-height:230px}.dashboard-preview{margin-inline:-.25rem}.kpis small{font-size:.56rem}.service-card{grid-template-columns:auto 1fr}.contact-panel{width:100%;border-radius:0}}
</style>
