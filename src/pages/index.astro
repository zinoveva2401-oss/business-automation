---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getActiveServices, getPublishedArticles, getVisibleProducts } from '../lib/content';
import { categories, homeChannels, topicDescriptions, topicForCategory } from '../lib/site';
import heroImage from '../assets/home-thread-route.webp';
import founderIllustration from '../assets/founder-illustration-ai.webp';

const articles = await getPublishedArticles();
const featuredArticle = articles.find(({ data }) => data.featured) ?? articles[0];
const supportingArticles = articles.filter(({ id }) => id !== featuredArticle?.id).slice(0, 3);
const products = await getVisibleProducts();
const services = await getActiveServices();
const method = [
  { title: 'Фиксируем, что изменилось', text: 'Отделяем наблюдаемый факт от версии о причине.' },
  { title: 'Сверяем возможные причины', text: 'Смотрим на шаги и условия, которые могли повлиять на результат.' },
  { title: 'Проверяем одну версию', text: 'Выбираем данные или наблюдение, которые помогут подтвердить или опровергнуть объяснение.' },
  { title: 'Решаем, что делать дальше', text: 'Определяем ближайшее действие и сигнал, по которому оценить его результат.' },
];
const homeSchema = [
  { '@context': 'https://schema.org', '@type': 'Person', name: 'Светлана Тарасова', jobTitle: 'Основатель «Докрути»', url: Astro.site ? new URL('/about/', Astro.site).href : undefined },
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'Докрути', description: 'Практические решения для малого бизнеса: понять причину проблемы и выбрать следующий шаг.', url: Astro.site?.href },
];
---

<BaseLayout title="Докрути — найти причину и следующий шаг для бизнеса" description="Разбираем задачи малого бизнеса: находим возможную причину, проверяем её и выбираем следующий шаг. Начните с ситуации, которая знакома вам." image={heroImage.src} schema={homeSchema}>
  <div class="home" id="top">
    <section class="home-hero" aria-labelledby="home-title">
      <Image src={heroImage} alt="Образная сцена: тёмная путаница на бумаге переходит в ясную оранжевую линию и точку" width={heroImage.width} height={heroImage.height} loading="eager" fetchpriority="high" class="home-hero__image" />
      <div class="home-hero__shade" aria-hidden="true"></div>
      <div class="container home-hero__content">
        <p class="home-kicker">Практические решения для малого бизнеса</p>
        <h1 id="home-title">Где бизнес<br /><em>буксует на деле?</em></h1>
        <p class="home-hero__lead">Разберём ситуацию, проверим возможную причину и выберем следующий шаг.</p>
        <div class="home-hero__actions">
          <a class="button button--primary" href="#problems" data-analytics-event="hero_cta" data-analytics-placement="home_hero">Выбрать задачу <span aria-hidden="true">↘</span></a>
          <a class="home-hero__text-link" href="#approach">Посмотреть подход <span aria-hidden="true">↓</span></a>
        </div>
        <p class="home-hero__caption">Образная сцена о пути от путаницы к ясному действию.</p>
      </div>
      <span class="home-hero__edge" aria-hidden="true"><span></span>Следующий шаг — точка опоры</span>
    </section>

    <section class="problem-section" id="problems" aria-labelledby="problem-title">
      <div class="container">
        <div class="section-heading section-heading--compact">
          <div><p class="home-kicker">Начните со своей ситуации</p><h2 id="problem-title">Что сейчас<br /><em>не получается?</em></h2></div>
          <p>Выберите направление — сразу откроется страница с проверками и материалами по теме.</p>
        </div>
        <nav class="problem-track" aria-label="Выберите задачу бизнеса">
          {categories.map((topic, index) => {
            const directTopic = topicForCategory(topic.name) ?? topic;
            return <a class="problem-link" href={'/topics/' + directTopic.slug + '/'} data-analytics-event="pain_topic_click" data-analytics-category={topic.slug} data-analytics-placement="home_problem_track">
              <span class="problem-link__node" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <span class="problem-link__name">{topic.name}</span>
              <span class="problem-link__hint">{topicDescriptions[topic.slug]}</span>
              <span class="problem-link__arrow" aria-hidden="true">↗</span>
            </a>;
          })}
        </nav>
      </div>
    </section>

    <section class="journal-section" id="articles" aria-labelledby="journal-title">
      <div class="container">
        <div class="section-heading">
          <div><p class="home-kicker">Практика без лишней теории</p><h2 id="journal-title">Идеи для<br /><em>следующей проверки.</em></h2></div>
          <a class="arrow-link" href="/articles/">Все статьи <span aria-hidden="true">↗</span></a>
        </div>
        {featuredArticle && <div class="journal-layout">
          <article class="journal-feature">
            <a class="journal-feature__image" href={'/articles/' + featuredArticle.data.slug + '/'} aria-label={'Читать: ' + featuredArticle.data.title} data-analytics-event="article_click" data-analytics-content-id={featuredArticle.data.id} data-analytics-placement="home_featured_article">
              {featuredArticle.data.cover ? <img src={featuredArticle.data.cover} alt={featuredArticle.data.coverAlt ?? 'Иллюстрация к статье ' + featuredArticle.data.title} width="900" height="560" loading="lazy" /> : <span class="journal-feature__fallback" aria-hidden="true">Д</span>}
              <span class="journal-feature__image-mark" aria-hidden="true">Новый взгляд <b>↗</b></span>
            </a>
            <div class="journal-feature__copy"><span class="article-meta">{topicForCategory(featuredArticle.data.category)?.name ?? featuredArticle.data.category} <i>·</i> {featuredArticle.data.readingTime} мин</span><h3><a href={'/articles/' + featuredArticle.data.slug + '/'} data-analytics-event="article_click" data-analytics-content-id={featuredArticle.data.id} data-analytics-placement="home_featured_article">{featuredArticle.data.title}</a></h3><p>{featuredArticle.data.description}</p><a class="arrow-link" href={'/articles/' + featuredArticle.data.slug + '/'} data-analytics-event="article_click" data-analytics-content-id={featuredArticle.data.id} data-analytics-placement="home_featured_article">Читать статью <span aria-hidden="true">↗</span></a></div>
          </article>
          <div class="journal-list" aria-label="Ещё три статьи">
            {supportingArticles.map((article, index) => <article class="journal-row">
              <span class="journal-row__number">0{index + 1}</span>
              <div><span class="article-meta">{topicForCategory(article.data.category)?.name ?? article.data.category} <i>·</i> {article.data.readingTime} мин</span><h3><a href={'/articles/' + article.data.slug + '/'} data-analytics-event="article_click" data-analytics-content-id={article.data.id} data-analytics-placement="home_supporting_article">{article.data.title}</a></h3></div>
              <a class="journal-row__arrow" href={'/articles/' + article.data.slug + '/'} aria-label={'Читать: ' + article.data.title} data-analytics-event="article_click" data-analytics-content-id={article.data.id} data-analytics-placement="home_supporting_article">↗</a>
            </article>)}
          </div>
        </div>}
        {!featuredArticle && <div class="journal-empty"><h3>Материалы появятся здесь</h3><p>А пока выберите свою задачу — на тематических страницах уже собраны первые шаги.</p><a class="arrow-link" href="/topics/">Посмотреть направления <span aria-hidden="true">↗</span></a></div>}
      </div>
    </section>

    <section class="approach-section" id="approach" aria-labelledby="approach-title" data-approach>
      <div class="container approach-layout">
        <div class="approach-copy"><p class="home-kicker">Как работаем</p><h2 id="approach-title">От симптома<br /><em>к ясному действию.</em></h2><p>Откройте любой этап разбора, чтобы увидеть, что на нём происходит.</p><a class="arrow-link" href="/about/" data-analytics-event="how_dokruti_works_click" data-analytics-placement="home_approach">Подробнее о подходе <span aria-hidden="true">↗</span></a></div>
        <div class="approach-experience">
          <div class="approach-steps" role="group" aria-label="Этапы разбора">
            {method.map((step, index) => <button class="approach-step" type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-step-index={index} data-step-title={step.title} data-step-text={step.text} data-analytics-event="how_dokruti_works_click" data-analytics-category={String(index + 1)} data-analytics-placement="home_approach_step"><span>{String(index + 1).padStart(2, '0')}</span><b>{step.title}</b><i aria-hidden="true">↗</i></button>)}
          </div>
          <article class="approach-detail" aria-live="polite" aria-atomic="true">
            <span class="approach-detail__eyebrow">Шаг 01</span><h3 data-step-output-title>{method[0].title}</h3><p data-step-output-text>{method[0].text}</p>
            <span class="approach-detail__trace" aria-hidden="true"><i></i><b></b></span>
          </article>
        </div>
      </div>
    </section>

    <section class="tool-section" id="tools" aria-labelledby="tool-title">
      <div class="container tool-layout">
        <div class="tool-intro"><p class="home-kicker">Инструменты и продукты</p><h2 id="tool-title">Когда полезно<br /><em>сделать самому.</em></h2><p>Показываем рабочие материалы в том состоянии, в котором они есть сейчас.</p><a class="arrow-link" href="/tools/" data-analytics-event="tool_click" data-analytics-placement="home_tools">Открыть раздел <span aria-hidden="true">↗</span></a></div>
        {products[0] ? <a class="product-feature" href={'/tools/' + products[0].data.slug + '/'} data-analytics-event="tool_click" data-analytics-content-id={products[0].data.id} data-analytics-placement="home_product">
          <div class="product-feature__art">{products[0].data.cover && <img src={products[0].data.cover} alt={products[0].data.coverAlt ?? 'Обложка концепции продукта'} width="640" height="720" loading="lazy" />}<span>Концепция продукта<br />не скриншот инструмента</span></div>
          <div class="product-feature__copy"><span class="product-feature__state">В подготовке · пока не продаётся</span><h3>{products[0].data.title}</h3><p>{products[0].data.description}</p><span class="arrow-link">Посмотреть статус <i aria-hidden="true">↗</i></span></div>
        </a> : <div class="product-empty"><span class="product-empty__point" aria-hidden="true"></span><strong>Сейчас нет опубликованных инструментов.</strong><p>Пока выбирайте следующий шаг в статьях или личной работе.</p><a class="arrow-link" href="/services/">Посмотреть услуги <span aria-hidden="true">↗</span></a></div>}
      </div>
    </section>

    <section class="founder-section" id="founder" aria-labelledby="founder-title">
      <div class="container founder-layout">
        <figure class="founder-portrait"><Image src={founderIllustration} alt="Иллюстрация основателя «Докрути» Светланы Тарасовой за рабочим столом" width={founderIllustration.width} height={founderIllustration.height} loading="lazy" /><figcaption>AI-иллюстрация по визуальному референсу. Это не документальная фотография.</figcaption></figure>
        <div class="founder-copy"><p class="home-kicker">Основатель «Докрути»</p><h2 id="founder-title">Светлана<br /><em>Тарасова.</em></h2><p class="founder-lead">Практическая работа начинается с внимания к реальным ограничениям бизнеса.</p><p>«Докрути» соединяет опыт работы с малым бизнесом и исследование управленческих подходов. Здесь идеи проверяют на применимость в конкретной ситуации и переводят в следующий понятный шаг.</p><a class="arrow-link" href="/about/" data-analytics-event="founder_click" data-analytics-placement="home_founder">История и подход <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="services-section" id="services" aria-labelledby="services-title">
      <div class="container">
        <div class="section-heading section-heading--services"><div><p class="home-kicker">Личная работа</p><h2 id="services-title">С чем можно<br /><em>обратиться.</em></h2></div><p>Три способа начать — в зависимости от того, где сейчас нужна ясность.</p></div>
        <div class="service-list">
          {services.map((service) => <a class="service-row" href={'/services/' + service.data.slug + '/'} data-analytics-event="service_click" data-analytics-content-id={service.data.id ?? service.data.slug} data-analytics-placement="home_services"><span class="service-row__title">{service.data.title}</span><span class="service-row__description">{service.data.description}</span><span class="service-row__arrow" aria-hidden="true">↗</span></a>)}
        </div>
        <a class="services-contact" href="/contacts/" data-analytics-event="contact_open" data-analytics-placement="home_services">Если не уверены, с чего начать — опишите ситуацию <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="channels-section" id="channels" aria-labelledby="channels-title">
      <div class="container channels-layout">
        <div class="channels-intro"><p class="home-kicker">Выберите площадку</p><h2 id="channels-title">Остаться<br /><em>на связи.</em></h2><p>У каждой площадки своя роль. Здесь видны и каналы, которые ещё готовятся к регулярной работе.</p><a class="channels-contact" href="/contacts/" data-analytics-event="contact_open" data-analytics-placement="home_channels">Задать вопрос <span aria-hidden="true">↗</span></a></div>
        <nav class="channel-list" aria-label="Публичные площадки «Докрути»">
          {homeChannels.map((channel) => <a class="channel-row" href={channel.href} target="_blank" rel="noopener noreferrer" data-analytics-event="channel_subscribe_click" data-analytics-channel-id={channel.id} data-analytics-category={channel.channelId} data-analytics-placement="home_channels">
            <span class="channel-row__short" aria-hidden="true">{channel.short}</span><span class="channel-row__main"><strong>{channel.label}</strong><small>{channel.role}</small><span>{channel.state}</span></span><b class="channel-row__arrow" aria-hidden="true">↗</b>
          </a>)}
        </nav>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const approach = document.querySelector<HTMLElement>('[data-approach]');
  if (approach) {
    const buttons = [...approach.querySelectorAll<HTMLButtonElement>('[data-step-index]')];
    const title = approach.querySelector<HTMLElement>('[data-step-output-title]');
    const text = approach.querySelector<HTMLElement>('[data-step-output-text]');
    const eyebrow = approach.querySelector<HTMLElement>('.approach-detail__eyebrow');
    buttons.forEach((button) => button.addEventListener('click', () => {
      buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
      if (title) title.textContent = button.dataset.stepTitle ?? '';
      if (text) text.textContent = button.dataset.stepText ?? '';
      if (eyebrow) eyebrow.textContent = 'Шаг ' + String(Number(button.dataset.stepIndex) + 1).padStart(2, '0');
      approach.style.setProperty('--active-step', button.dataset.stepIndex ?? '0');
    }));
  }
</script>

<style>
  .home{--ink:#20201e;--paper:#f4f0e7;--muted:#686861;--orange:#e65b2f;color:var(--ink);background:#fff;overflow:hidden}.home h1,.home h2,.home h3,.home p{margin-top:0}.home em{font-style:normal;color:var(--orange)}.home-kicker{margin:0 0 1rem;color:var(--orange);font-size:.69rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase}.home-hero{position:relative;display:grid;min-height:min(740px,calc(100svh - 74px));align-items:center;overflow:hidden;background:#171715;color:#fff}.home-hero__image,.home-hero__shade{position:absolute;inset:0;width:100%;height:100%}.home-hero__image{z-index:0;object-fit:cover;object-position:center 48%}.home-hero__shade{z-index:1;background:linear-gradient(90deg,#151513f5 0%,#151513e8 31%,#1515139b 52%,#15151312 82%),linear-gradient(0deg,#1515139c 0%,transparent 33%)}.home-hero__content{position:relative;z-index:2;padding-top:clamp(3rem,8vw,7rem);padding-bottom:clamp(3.5rem,7vw,6rem)}.home-hero .home-kicker{color:#ffad84}.home-hero h1{max-width:750px;margin:0 0 1.35rem;font-size:clamp(3.8rem,7.3vw,7.4rem);line-height:.89;letter-spacing:-.065em;font-weight:650}.home-hero h1 em{color:#ff8d61}.home-hero__lead{max-width:480px;margin:0 0 1.7rem;color:#e5e0d8;font:500 clamp(1rem,1.4vw,1.22rem)/1.52 var(--font-editorial)}.home-hero__actions{display:flex;gap:1.35rem;align-items:center;flex-wrap:wrap}.home-hero__actions .button{min-height:50px;padding-inline:1.2rem}.home-hero__text-link{display:inline-flex;gap:.55rem;align-items:center;color:#fff;font-size:.8rem;font-weight:750;text-decoration:none}.home-hero__text-link span{color:#ff936a;transition:transform .2s ease}.home-hero__text-link:hover span{transform:translateY(3px)}.home-hero__caption{max-width:350px;margin:2.5rem 0 0;padding-left:.8rem;border-left:1px solid #ef784e;color:#c6c2bb;font-size:.66rem;line-height:1.4}.home-hero__edge{position:absolute;z-index:2;right:2.5rem;bottom:2.2rem;display:flex;gap:.55rem;align-items:center;color:#f5e6dc;font-size:.67rem;letter-spacing:.04em}.home-hero__edge span{width:7px;height:7px;border-radius:50%;background:#fb7545;box-shadow:0 0 0 5px #fb754533}
  .problem-section{padding:clamp(4rem,8vw,7.2rem) 0;background:var(--paper)}.section-heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:2.5rem}.section-heading h2,.approach-copy h2,.tool-intro h2,.founder-copy h2,.channels-intro h2{margin:0;font-size:clamp(3rem,6.1vw,6.2rem);line-height:.91;letter-spacing:-.06em;font-weight:620}.section-heading>p{max-width:390px;margin:0 0 .25rem;color:var(--muted);font-size:.95rem;line-height:1.55}.section-heading--compact{margin-bottom:2rem}.problem-track{position:relative;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));padding-top:2.1rem;border-top:1px solid #bdb7ae}.problem-link{position:relative;display:grid;grid-template-rows:34px auto 1fr;gap:.6rem;min-width:0;padding:.1rem .8rem .65rem;color:inherit;text-decoration:none;border-right:1px solid #d4cfc6;transition:background .18s ease,color .18s ease}.problem-link:first-child{border-left:1px solid #d4cfc6}.problem-link::before{position:absolute;top:-2.37rem;left:.8rem;width:11px;height:11px;border:2px solid var(--paper);border-radius:50%;background:var(--orange);box-shadow:0 0 0 1px var(--orange);content:'';transition:transform .2s ease,box-shadow .2s ease}.problem-link:hover,.problem-link:focus-visible{background:#fff9;color:var(--ink)}.problem-link:hover::before,.problem-link:focus-visible::before{transform:scale(1.35);box-shadow:0 0 0 7px #e65b2f30}.problem-link:focus-visible{outline:2px solid var(--orange);outline-offset:2px}.problem-link__node{color:var(--orange);font:600 .78rem/1 var(--font-editorial)}.problem-link__name{max-width:155px;font-size:clamp(.82rem,1.1vw,1.03rem);font-weight:750;line-height:1.12}.problem-link__hint{color:#67665f;font-size:.67rem;line-height:1.4}.problem-link__arrow{justify-self:end;color:var(--orange);font-size:.95rem}
  .journal-section{padding:clamp(4rem,8vw,7rem) 0;background:#fff}.journal-section .section-heading{margin-bottom:2.1rem}.arrow-link{display:inline-flex;gap:.6rem;align-items:center;color:inherit;font-size:.78rem;font-weight:800;text-decoration:none}.arrow-link>span,.arrow-link>i{color:var(--orange);font-size:1.05em;transition:transform .2s ease}.arrow-link:hover>span,.arrow-link:hover>i{transform:translate(3px,-2px)}.journal-layout{display:grid;grid-template-columns:minmax(0,1.28fr) minmax(300px,.72fr);gap:clamp(2rem,5vw,5rem);align-items:stretch}.journal-feature{display:grid;grid-template-rows:minmax(260px,1fr) auto;min-width:0;border-top:3px solid var(--orange)}.journal-feature__image{position:relative;display:block;min-height:290px;overflow:hidden;background:#20201e;color:#fff}.journal-feature__image img{display:block;width:100%;height:100%;min-height:290px;object-fit:cover;transition:transform .55s cubic-bezier(.2,.7,.2,1)}.journal-feature__image:hover img{transform:scale(1.035)}.journal-feature__fallback{display:grid;min-height:290px;place-items:center;background:#252a2a;color:#ff895d;font:600 8rem/.9 var(--font-editorial)}.journal-feature__image-mark{position:absolute;right:1rem;bottom:1rem;display:flex;gap:1.2rem;align-items:center;padding:.55rem .7rem;background:#181816e8;color:#fff;font-size:.68rem}.journal-feature__image-mark b{color:#ff8d61}.journal-feature__copy{padding:1.3rem .2rem .2rem}.article-meta{display:inline-flex;gap:.45rem;align-items:center;color:#6e6e67;font-size:.68rem;font-weight:750;letter-spacing:.04em}.article-meta i{color:var(--orange);font-style:normal}.journal-feature h3{max-width:740px;margin:.65rem 0 .7rem;font-size:clamp(1.9rem,3.5vw,3.5rem);line-height:.98;letter-spacing:-.04em}.journal-feature h3 a,.journal-row h3 a{color:inherit;text-decoration:none}.journal-feature h3 a:hover,.journal-row h3 a:hover{color:#b64728}.journal-feature__copy>p{max-width:690px;margin:0 0 1rem;color:var(--muted);font-size:.91rem;line-height:1.52}.journal-list{display:grid;grid-template-rows:repeat(3,1fr);border-top:1px solid var(--ink)}.journal-row{display:grid;grid-template-columns:30px minmax(0,1fr) 24px;gap:.75rem;align-content:center;align-items:center;padding:1.1rem .15rem;border-bottom:1px solid var(--line)}.journal-row__number{align-self:start;color:var(--orange);font:600 .9rem/1 var(--font-editorial)}.journal-row h3{margin:.4rem 0 0;font-size:clamp(1rem,1.45vw,1.35rem);line-height:1.12}.journal-row__arrow{display:grid;width:28px;height:28px;place-items:center;border:1px solid #d5d1c9;border-radius:50%;color:var(--orange);text-decoration:none;transition:background .2s ease,transform .2s ease}.journal-row__arrow:hover{background:#f4eee8;transform:translate(2px,-2px)}.journal-empty{max-width:670px;padding:2rem;border:1px solid var(--line)}.journal-empty h3{margin:0 0 .5rem;font-size:1.6rem}.journal-empty p{color:var(--muted)}
