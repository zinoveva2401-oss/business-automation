-row:2;align-self:start;color:#555;font-size:11px;line-height:1.35}.service-cards-v4 b{grid-column:3;grid-row:1;color:#d9562f}.closing-strip{padding:27px 0;background:#17130f;color:#fff}.closing-strip>.container{display:flex;align-items:center;gap:16px}.closing-strip h2{flex:1;margin:0;font-size:clamp(26px,2.7vw,38px);line-height:1.05}.closing-read{min-height:46px;padding:10px 13px;border:1px solid #ffffff60;background:transparent;color:#fff;cursor:pointer}
  @media(max-width:1000px){.opening-grid{gap:22px;min-height:400px}.opening-photo{height:330px}.trace-line strong{font-size:11px}.spotlight-support :global(.editorial-article-row__link){grid-template-columns:minmax(0,1fr) 100px 15px}.teaser-grid{grid-template-columns:.55fr 1.45fr;gap:22px}.teaser-evidence{grid-template-columns:1fr}.tool-preview{min-height:190px}.tool-caption{padding:13px}.founder-grid{gap:24px}.service-cards-v4 a{grid-template-columns:30px minmax(0,1fr) 15px;padding:13px 11px}.service-cards-v4 strong{font-size:18px}}
