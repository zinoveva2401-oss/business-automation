---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialArticleRow from '../components/EditorialArticleRow.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { categories } from '../lib/site';
import { getPublishedArticles } from '../lib/content';

const articles = await getPublishedArticles();
const featured = articles.find((item) => item.data.id === 'CNT-0026') ?? articles[0];
const supporting = articles.filter((item) => item.data.id !== featured?.data.id).slice(0, 3);
---

<BaseLayout title="Докрути — практические решения для малого бизнеса" description="Практические материалы, инструменты и помощь по задачам продаж, ассортимента, клиентов, команды, управления, маркетинга и ИИ.">
  <article class="v4-home">
    <section class="home-opening">
      <figure class="opening-photo">
        <ResponsiveImage src="/images/home-hero-editorial-approved.png" alt="Светлое рабочее пространство с ноутбуком, книгами и блокнотом" width={1916} height={821} loading="eager" fetchpriority="high" sizes="100vw" />
      </figure>
      <div class="container opening-grid">
        <div class="opening-copy">
          <p class="eyebrow">ПРАКТИЧЕСКИЕ РЕШЕНИЯ ДЛЯ МАЛОГО БИЗНЕСА</p>
          <h1>Когда в бизнесе<br class="hero-line-break" /> что-то не сходится —<br class="hero-line-break" /> <em>найдём, где именно.</em></h1>
          <p class="opening-lead">Продажи, клиенты, команда, процессы, маркетинг, ассортимент и ИИ — от проблемы к следующему понятному действию.</p>
          <div class="opening-actions">
            <a class="button button--primary" href="#problems" data-analytics-event="cta_click" data-analytics-cta-id="find_situation" data-analytics-placement="home_hero">Найти свою ситуацию</a>
            <button type="button" class="button button--outline" data-open-sheet="ask" data-analytics-event="contact_open">Описать задачу</button>
          </div>
          <div class="opening-proof" aria-label="О Докрути">
            <span><i class="ti ti-chart-line" aria-hidden="true"></i>Реальный опыт малого бизнеса</span>
            <span><i class="ti ti-checks" aria-hidden="true"></i>Практика, а не теория</span>
            <span><i class="ti ti-tool" aria-hidden="true"></i>Современные инструменты</span>
          </div>
        </div>
      </div>
    </section>

    <section class="problem-trace" id="problems" aria-labelledby="trace-title">
      <div class="container">
        <div class="trace-heading">
          <div class="trace-heading-copy"><h2 id="trace-title">Найди свою точку роста</h2><p>Семь ключевых проблем, с которых начинается рост.</p></div>
          <p class="trace-instruction">Нажмите на тему — откроется подборка статей, инструментов и решений. <span aria-hidden="true">→</span></p>
        </div>
        <nav class="trace-line" aria-label="Семь направлений">
          <svg class="trace-path" viewBox="0 0 1400 70" preserveAspectRatio="none" aria-hidden="true"><path d="M0 40 C70 40 80 22 145 22 S220 58 300 42 S380 20 445 27 S520 55 590 43 S675 24 735 32 S825 56 885 39 S980 18 1035 29 S1110 55 1175 42 S1300 24 1400 36" /></svg>
          {categories.map((item, index) => (
            <a href={'/topics/' + item.slug + '/'} data-analytics-event="topic_click" data-analytics-topic={item.slug}>
              <span class="trace-node"><i class={'ti ' + item.icon} aria-hidden="true"></i><small>0{index + 1}</small></span>
              <strong>{item.name}</strong>
            </a>
          ))}
        </nav>
      </div>
    </section>

    <section class="library-spotlight" aria-labelledby="library-title">
      <div class="container">
        <div class="section-heading library-heading">
          <div><p class="eyebrow">ПОЛЕЗНЫЕ МАТЕРИАЛЫ</p><h2 id="library-title">Разобраться глубже</h2></div>
          <a class="all-articles" href="/articles/">Все материалы ↗</a>
        </div>
        {featured && <div class="spotlight-grid">
          <div class="spotlight-feature"><EditorialArticleRow article={featured} featured imageLoading="lazy" placement="home_feature" /></div>
          <div class="spotlight-support">{supporting.map((item) => <EditorialArticleRow article={item} imageLoading="lazy" imageSizes="(max-width: 700px) 90px, 126px" placement="home_supporting" />)}</div>
        </div>}
      </div>
    </section>

    <section class="tools-teaser" aria-labelledby="tools-title">
      <div class="container teaser-grid">
        <div class="teaser-copy">
          <p class="eyebrow">ИНСТРУМЕНТЫ ДЛЯ РАБОТЫ</p>
          <h2 id="tools-title">Проверить самому</h2>
          <p>Раздел инструментов готовится. Пока начать можно с материалов в Библиотеке.</p>
          <a href="/tools/">Смотреть инструменты ↗</a>
        </div>
        <div class="teaser-evidence">
          <a class="tool-preview" href="/tools/" aria-label="Смотреть инструменты"><ResponsiveImage src="/images/home-tools-visual.webp" alt="Инструменты для анализа ситуации, проверки гипотез и пошагового планирования" width={2172} height={724} loading="lazy" sizes="(max-width: 700px) 100vw, 58vw" /></a>
        </div>
      </div>
    </section>

    <section class="founder-section" aria-labelledby="founder-title">
      <div class="container founder-grid">
        <figure class="founder-photo"><img src="/images/home-founder-portrait.webp" alt="Светлана Тарасова" width="1122" height="1402" loading="lazy" decoding="async" /></figure>
        <div class="founder-copy">
          <p class="eyebrow">КТО СТОИТ ЗА ДОКРУТИ</p>
          <h2 id="founder-title">Светлана Тарасова</h2>
          <p>Практик в продажах, управлении, маркетинге и бизнес-процессах. В «Докрути» я собираю разборы, инструменты и решения, которые помогают понять, что происходит и что делать дальше.</p>
          <ul class="founder-steps"><li>Увидеть проблему</li><li>Проверить причину</li><li>Выбрать следующий шаг</li></ul>
          <a href="/about/">История и подход ↗</a>
        </div>
      </div>
    </section>

    <section class="services-section" aria-labelledby="services-title">
      <div class="container">
        <div class="section-heading services-heading">
          <div class="services-heading-title"><p class="eyebrow">ФОРМАТЫ РАБОТЫ</p><h2 id="services-title">С чего начать</h2></div>
          <a class="services-all" href="/services/">Все услуги ↗</a>
          <p>Если нужен не только материал, а разбор вашей ситуации — можно выбрать подходящий формат работы.</p>
        </div>
        <div class="service-cards-v4">
          <article><span class="service-number">01</span><strong>Разбор одной задачи</strong><small>Когда есть конкретная ситуация и нужно понять, что проверить первым.</small></article>
          <article><span class="service-number">02</span><strong>Аудит продаж и процессов</strong><small>Когда проблема видна по результату, но причина пока не ясна.</small></article>
          <article><span class="service-number">03</span><strong>Доработка системы работы</strong><small>Когда после разбора нужно изменить порядок работы, роли или контроль.</small></article>
        </div>
      </div>
    </section>

    <section class="closing-strip">
      <div class="container">
        <h2>Не уверены, с чего начать?</h2>
        <button type="button" class="button button--primary" data-open-sheet="ask" data-analytics-event="contact_open">Описать задачу</button>
        <button type="button" class="closing-read" data-open-sheet="read">Где читать Докрути</button>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
