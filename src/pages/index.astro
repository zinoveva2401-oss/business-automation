---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditorialArticleRow from '../components/EditorialArticleRow.astro';
import { categories } from '../lib/site';
import { getPublishedArticles, getActiveServices } from '../lib/content';
const articles=await getPublishedArticles();
const services=await getActiveServices();
const featured=articles.find(item=>item.data.id==='CNT-0026') ?? articles[0];
const supporting=articles.filter(item=>item.data.id!==featured?.data.id).slice(0,3);
---
<BaseLayout title="Докрути — практические решения для малого бизнеса" description="Практические материалы, инструменты и помощь по задачам продаж, ассортимента, клиентов, команды, управления, маркетинга и ИИ.">
<article class="v4-home">
  <section class="home-opening"><div class="container opening-grid"><div class="opening-copy"><p class="eyebrow">ПРАКТИЧЕСКИЕ РЕШЕНИЯ ДЛЯ МАЛОГО БИЗНЕСА</p><h1>Когда в бизнесе что-то не сходится — <em>найдём, где именно.</em></h1><p class="opening-lead">Продажи, клиенты, команда, процессы, маркетинг, ассортимент и ИИ — от проблемы к следующему понятному действию.</p><div class="opening-actions"><a class="button button--primary" href="#problems" data-analytics-event="cta_click" data-analytics-cta-id="find_situation" data-analytics-placement="home_hero">Найти свою ситуацию ↗</a><button type="button" class="button button--outline" data-open-sheet="ask" data-analytics-event="contact_open">Описать задачу</button></div></div><div class="opening-evidence" aria-label="От ситуации к проверке и следующему действию"><div class="evidence-kicker">Где теряется результат?</div><div class="evidence-line"><span>Ситуация</span><span>Что проверить</span><strong>Следующий шаг</strong></div><div class="evidence-mark" aria-hidden="true">?</div><p>У каждого изменения есть причина. Начните с наблюдаемого факта.</p></div></div></section>
  <section class="problem-trace" id="problems"><div class="container"><div class="trace-heading"><p class="eyebrow">НАЙТИ СВОЮ СИТУАЦИЮ</p><h2>С чего начать</h2></div><div class="trace-line" aria-label="Семь направлений"><a href="/articles/?topic=sales" data-analytics-event="topic_click" data-analytics-topic="sales"><span class="point">01</span><strong>Продажи</strong></a>{categories.slice(1).map((item,index)=><a href={'/articles/?topic='+item.slug} data-analytics-event="topic_click" data-analytics-topic={item.slug}><span class="point">0{index+2}</span><strong>{item.name}</strong></a>)}</div></div></section>
  <section class="library-spotlight"><div class="container"><div class="section-heading"><div><p class="eyebrow">ПОЛЕЗНЫЕ МАТЕРИАЛЫ</p><h2>Разобраться глубже</h2></div><p>Практические разборы и материалы, которые помогают проверить причину до решения.</p></div>{featured&&<div class="spotlight-grid"><div class="spotlight-feature"><EditorialArticleRow article={featured} featured placement="home_feature"/></div><div class="spotlight-support">{supporting.map((item,index)=><EditorialArticleRow article={item} rank={index+1} placement="home_supporting"/>)}</div></div>}<div class="section-links"><a href="/articles/">Все материалы ↗</a><button type="button" data-open-sheet="read">Где читать новые разборы ↗</button></div></div></section>
  <section class="tools-teaser"><div class="container teaser-grid"><div><p class="eyebrow">ИНСТРУМЕНТЫ</p><h2>Проверить самостоятельно</h2><p>Практические инструменты и рабочие материалы для следующей проверки или действия.</p><a href="/tools/">Посмотреть инструменты ↗</a></div><div class="teaser-evidence"><span>РАБОТА С КОМАНДОЙ</span><strong>Система управления командой</strong><p>Публичного доступа к инструменту пока нет. Материалы по теме доступны в библиотеке.</p></div></div></section>
  <section class="founder-section"><div class="container founder-grid"><figure><img src="/approved/founder-home.webp" alt="Светлана Тарасова, основатель Докрути" width="900" height="1122" loading="lazy"/></figure><div><p class="eyebrow">КТО СТОИТ ЗА ДОКРУТИ</p><h2>Светлана Тарасова</h2><p>Практик и эксперт по продажам, управлению, маркетингу и бизнес-процессам; основатель бренда «Докрути» и автор практических решений для малого и среднего бизнеса.</p><div class="founder-steps"><span>Увидеть проблему</span><span>Проверить причину</span><span>Выбрать действие</span></div><a href="/about/">История и подход ↗</a></div></div></section>
  <section class="services-section"><div class="container"><div class="section-heading"><div><p class="eyebrow">ФОРМАТЫ РАБОТЫ</p><h2>С чего начать</h2></div><p>Формат зависит от ситуации и доступных данных. Объём, срок и стоимость согласуются до начала работы.</p></div><div class="service-list-v4">{services.map((item,index)=><a href={'/services/'+item.data.slug+'/'} data-analytics-event="cta_click" data-analytics-service-id={item.data.id} data-analytics-placement="home_services"><span>0{index+1}</span><strong>{item.data.title}</strong><small>{item.data.description}</small><b aria-hidden="true">↗</b></a>)}</div></div></section>
  <section class="closing-strip"><div class="container"><h2>Не уверены, с чего начать?</h2><button type="button" class="button button--primary" data-open-sheet="ask" data-analytics-event="contact_open">Описать задачу ↗</button><button type="button" class="closing-read" data-open-sheet="read">Где читать Докрути ↗</button></div></section>
</article></BaseLayout>
<style>
.v4-home{background:#fff;color:#262626}.v4-home .eyebrow{color:#d9562f}.home-opening{background:#f4f5f6}.opening-grid{display:grid;grid-template-columns:1.08fr .92fr;gap:5vw;align-items:center;min-height:520px;padding-block:52px}.opening-copy h1{max-width:720px;margin:0 0 20px;font-size:clamp(48px,5.1vw,76px);line-height:.98}.opening-copy h1 em{color:#d9562f;font-style:normal}.opening-lead{max-width:540px;margin:0;font-size:17px;line-height:1.5}.opening-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:26px}.opening-actions button{background:transparent;cursor:pointer}.opening-evidence{position:relative;display:flex;min-height:340px;flex-direction:column;justify-content:center;overflow:hidden;padding:34px;background:#17130f;color:#fff}.evidence-kicker{font:600 clamp(28px,3.2vw,46px)/1.08 var(--font-editorial);max-width:350px}.evidence-line{display:flex;justify-content:space-between;gap:8px;margin:60px 0 20px;padding-top:18px;border-top:3px solid #d9562f;font-size:12px}.evidence-line span,.evidence-line strong{position:relative;max-width:85px}.evidence-line span:before,.evidence-line strong:before{position:absolute;top:-26px;left:0;width:12px;height:12px;border:3px solid #d9562f;border-radius:50%;background:#17130f;content:''}.evidence-mark{position:absolute;right:20px;top:6px;color:#d9562f33;font:600 190px/1 var(--font-editorial)}.opening-evidence p{max-width:260px;margin:0;color:#d3d0cc;font-size:12px}.problem-trace{padding:28px 0 34px;border-bottom:1px solid #d8dde3}.trace-heading{display:flex;align-items:baseline;gap:16px}.trace-heading h2{margin:0;font-size:27px}.trace-line{display:grid;grid-template-columns:repeat(7,1fr);position:relative;margin-top:36px}.trace-line:before{position:absolute;top:20px;right:0;left:0;height:2px;background:#d9562f;content:''}.trace-line a{position:relative;display:grid;align-content:start;gap:12px;min-height:95px;padding:0 6px;color:#262626;text-align:center;text-decoration:none}.point{z-index:1;display:grid;width:42px;height:42px;place-items:center;margin:auto;border:2px solid #d9562f;border-radius:50%;background:#fff;color:#d9562f;font-size:11px;font-weight:700;transition:background .2s,color .2s}.trace-line strong{font-size:12px;line-height:1.25}.trace-line a:hover .point,.trace-line a:focus-visible .point{background:#d9562f;color:#fff}.library-spotlight,.services-section{padding:58px 0}.section-heading{display:grid;grid-template-columns:1fr .8fr;gap:40px;align-items:end;margin-bottom:24px}.section-heading h2{margin:0;font-size:clamp(34px,3.5vw,52px)}.section-heading>p{max-width:500px;margin:0;color:#53585c;font-size:15px}.spotlight-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:22px}.spotlight-support{display:grid;align-content:start}.section-links{display:flex;flex-wrap:wrap;gap:24px;margin-top:20px}.section-links a,.section-links button,.teaser-grid a,.founder-grid a{padding:8px 0;border:0;background:transparent;color:#b74323;font-size:13px;font-weight:700;text-decoration:none;cursor:pointer}.tools-teaser{padding:50px 0;background:#17130f;color:#fff}.teaser-grid{display:grid;grid-template-columns:1fr .8fr;gap:50px;align-items:center}.teaser-grid h2{margin:0 0 12px;font-size:clamp(35px,3.7vw,55px)}.teaser-grid p{max-width:550px;color:#dedbd7;font-size:15px}.teaser-grid a{color:#ff8d69}.teaser-evidence{padding:24px;border-left:3px solid #d9562f;background:#ffffff10}.teaser-evidence span{display:block;margin-bottom:15px;color:#ff8d69;font-size:11px;text-transform:uppercase}.teaser-evidence strong{display:block;font:600 28px/1.15 var(--font-editorial)}.teaser-evidence p{margin-bottom:0;font-size:13px}.founder-section{padding:50px 0;background:#f4f5f6}.founder-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:5vw;align-items:center}.founder-grid figure{height:340px;margin:0;overflow:hidden}.founder-grid img{width:100%;height:100%;object-fit:cover;object-position:16% 30%}.founder-grid h2{margin:0 0 12px;font-size:clamp(38px,4vw,58px)}.founder-grid p:not(.eyebrow){max-width:610px;margin:0;font-size:15px}.founder-steps{display:flex;flex-wrap:wrap;gap:10px 20px;margin:22px 0;border-top:1px solid #aaa;padding-top:15px;font-size:12px;font-weight:700}.founder-steps span:before{margin-right:7px;color:#d9562f;content:'●'}.service-list-v4{border-top:2px solid #262626}.service-list-v4 a{display:grid;grid-template-columns:55px 1fr 1fr 20px;gap:20px;align-items:center;min-height:94px;padding:14px 0;border-bottom:1px solid #b9bdc0;text-decoration:none}.service-list-v4 a:hover{background:#f4f5f6}.service-list-v4 span{color:#d9562f;font:600 25px var(--font-editorial)}.service-list-v4 strong{font:600 clamp(20px,2.3vw,30px)/1 var(--font-editorial)}.service-list-v4 small{max-width:400px;color:#555;font-size:13px}.service-list-v4 b{color:#d9562f}.closing-strip{padding:35px 0;background:#17130f;color:#fff}.closing-strip>.container{display:flex;align-items:center;gap:18px}.closing-strip h2{flex:1;margin:0;font-size:clamp(28px,3vw,42px)}.closing-read{min-height:50px;padding:12px;border:1px solid #fff7;background:transparent;color:#fff;cursor:pointer}@media(max-width:900px){.opening-grid{gap:22px}.trace-line strong{font-size:11px}.spotlight-grid{grid-template-columns:1fr}.spotlight-support{grid-template-columns:1fr 1fr;gap:0 18px}.founder-grid{grid-template-columns:1fr 1.2fr}}@media(max-width:700px){.opening-grid,.teaser-grid,.founder-grid,.section-heading{grid-template-columns:1fr}.opening-grid{padding-block:42px}.opening-copy h1{font-size:clamp(42px,11vw,58px)}.opening-evidence{min-height:250px}.trace-heading{display:block}.trace-line{grid-template-columns:1fr;margin-top:20px;padding-left:20px}.trace-line:before{top:0;bottom:0;left:40px;width:2px;height:auto}.trace-line a{grid-template-columns:42px 1fr;align-items:center;min-height:57px;gap:16px;text-align:left}.point{margin:0}.trace-line strong{font-size:14px}.section-heading{gap:10px}.spotlight-support{grid-template-columns:1fr}.founder-grid figure{height:350px}.closing-strip>.container{align-items:start;flex-wrap:wrap}.closing-strip h2{flex-basis:100%}.service-list-v4 a{grid-template-columns:42px 1fr 20px;gap:8px;min-height:100px}.service-list-v4 small{grid-column:2;grid-row:2}.service-list-v4 b{grid-column:3;grid-row:1/3}.library-spotlight,.services-section{padding:48px 0}}@media(prefers-reduced-motion:reduce){.point{transition:none}}
</style>
