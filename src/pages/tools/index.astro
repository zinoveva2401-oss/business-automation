---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getVisibleProducts } from '../../lib/content';
const products=await getVisibleProducts();
---
<BaseLayout title="Инструменты «Докрути» — практические решения" description="Практические цифровые инструменты для проверки рабочих задач и принятия решений."><section class="tools-page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты'}]}/><p class="eyebrow">Инструменты</p><h1>Проверить задачу на данных</h1><p class="lead">Небольшие прикладные продукты, которые помогают пройти от вопроса к понятному следующему шагу.</p><div class="tool-list">{products.map((product,index)=><ProductCard product={product} placement="tools_catalog" priority={index===0}/>)}</div></div></section></BaseLayout>
<style>.tools-page{padding-block:var(--section);background:var(--c-paper);min-height:45vh}.tools-page h1{max-width:700px;margin:.35rem 0 .8rem;font-size:clamp(3rem,6vw,5rem);line-height:.95}.lead{max-width:650px;margin:0;color:#56616a;font-size:1.05rem;line-height:1.6}.tool-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:2.5rem}.tool-list :global(.product-card){height:100%}@media(max-width:700px){.tools-page h1{font-size:3rem}.tool-list{grid-template-columns:1fr;margin-top:1.8rem}}</style>
