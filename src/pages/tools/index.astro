---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import { getCollection } from 'astro:content'; const tools=(await getCollection('tools')).filter(({data})=>data.status==='available').sort((a,b)=>a.data.order-b.data.order); const money=(value:number)=>new Intl.NumberFormat('ru-RU').format(value)+' ₽';
---
<BaseLayout title="Цифровые инструменты для магазина — Розница в цифрах" description="Практические цифровые инструменты для анализа и управления непродовольственным магазином."><section class="catalog-page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты'}]} /><p class="eyebrow">Инструменты</p><h1>Рабочие решения для розничного бизнеса</h1><div class="tool-catalog">{tools.map(tool=><article><img src={tool.data.image} alt={`Предварительный вид продукта «${tool.data.title}»`}><div><span class="status">Доступен</span><h2>{tool.data.title}</h2><p>{tool.data.description}</p><strong>{money(tool.data.price)}</strong><a class="button button--catalog" href={`/tools/${tool.id}/`} data-analytics-event="product_view">Подробнее о продукте</a></div></article>)}</div></div></section></BaseLayout>
<style>.catalog-page{min-height:62vh;padding-block:var(--section)}.catalog-page>div>h1{max-width:950px;font-family:var(--font-editorial);font-size:clamp(2.8rem,6vw,5.5rem);line-height:.95}.tool-catalog{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem}.tool-catalog article{overflow:hidden;border:1px solid var(--c-line);border-radius:var(--r-lg);background:#fff}.tool-catalog img{width:100%;aspect-ratio:16/9;object-fit:cover}.tool-catalog article>div{display:grid;gap:.8rem;padding:1.5rem}.tool-catalog h2,.tool-catalog p{margin:0}.tool-catalog strong{color:var(--c-orange);font-size:1.4rem}.status{justify-self:start;padding:.25rem .55rem;border-radius:99px;background:#e8f2ff;color:#174c8b;font-size:.72rem;font-weight:800}.button--catalog{justify-self:start;background:var(--c-blue);color:#fff}@media(max-width:760px){.tool-catalog{grid-template-columns:1fr}}</style>
