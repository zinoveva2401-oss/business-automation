---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ProductCard from '../../components/ProductCard.astro'; import { getCatalogProducts } from '../../lib/content';
const products=await getCatalogProducts();const firstPage=products.slice(0,12);const categories=[...new Set(products.map(({data})=>data.category))];const types=[...new Set(products.map(({data})=>data.type))];const pages=Math.ceil(products.length/12);
---
<BaseLayout title="Цифровые инструменты для магазина — Розница в цифрах" description="Каталог готовых цифровых продуктов и инструментов для управления непродовольственным магазином."><section class="tools-page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты'}]} /><p class="eyebrow">Цифровые продукты</p><h1>Инструменты для работы магазина</h1>{products.length>0&&<><form class="filters" data-product-filters><label>Поиск<input type="search" name="search" placeholder="Название или задача" /></label><label>Категория<select name="category"><option value="">Все категории</option>{categories.map((category)=><option value={category}>{category}</option>)}</select></label><label>Тип<select name="type"><option value="">Все типы</option>{types.map((type)=><option value={type}>{type}</option>)}</select></label></form><p data-product-count>Продуктов: {products.length}</p><div class="product-grid" data-product-results>{firstPage.map((product,index)=><ProductCard product={product} placement="tools_catalog" priority={index === 0} />)}</div>{pages>1&&<nav class="pagination" aria-label="Страницы каталога">{Array.from({length:pages},(_,index)=><a href={index===0?'/tools/':`/tools/page/${index+1}/`} aria-current={index===0?'page':undefined}>{index+1}</a>)}</nav>}</>}</div></section></BaseLayout>
<script>
  interface ProductIndexItem { id:string; slug:string; title:string; description:string; type:string; category:string; price:string; cover:string; coverAlt:string }
  const form=document.querySelector<HTMLFormElement>('[data-product-filters]');const results=document.querySelector<HTMLElement>('[data-product-results]');const counter=document.querySelector<HTMLElement>('[data-product-count]');
  if(form&&results&&counter){let all:ProductIndexItem[]=[];fetch('/tools/index.json').then((response)=>response.json()).then((data:ProductIndexItem[])=>{all=data});form.addEventListener('input',()=>{const values=Object.fromEntries(new FormData(form));const query=String(values.search||'').toLocaleLowerCase('ru');const matches=all.filter((item)=>(!query||`${item.title} ${item.description}`.toLocaleLowerCase('ru').includes(query))&&(!values.category||item.category===values.category)&&(!values.type||item.type===values.type));counter.textContent=`Найдено: ${matches.length}`;results.replaceChildren(...matches.slice(0,12).map((item)=>{const article=document.createElement('article');article.className='search-card';const imageLink=document.createElement('a');imageLink.href=`/tools/${item.slug}/`;const image=document.createElement('img');image.src=item.cover;image.alt=item.coverAlt;image.width=720;image.height=440;imageLink.append(image);const body=document.createElement('div');const type=document.createElement('p');type.className='product-type';type.textContent=item.type;const heading=document.createElement('h3');const link=document.createElement('a');link.href=`/tools/${item.slug}/`;link.textContent=item.title;heading.append(link);const description=document.createElement('p');description.textContent=item.description;const price=document.createElement('strong');price.textContent=item.price;body.append(type,heading,description,price);article.append(imageLink,body);return article}))})}
</script>
<style>.tools-page{padding-block:var(--section)}.tools-page h1{margin:.2rem 0 1.5rem;font-size:clamp(2.4rem,5vw,4.2rem);line-height:1}.filters{display:grid;grid-template-columns:2fr 1fr 1fr;gap:.75rem;margin-bottom:1rem}.filters label{display:grid;gap:.3rem;font-size:.78rem;font-weight:700}.filters input,.filters select{min-width:0;height:44px;padding:.6rem;border:1px solid var(--c-line);border-radius:var(--r-sm);background:#fff;font:inherit}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.pagination{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:2rem}.pagination a{display:grid;width:44px;height:44px;place-items:center;border:1px solid var(--c-line);border-radius:var(--r-sm);text-decoration:none}.pagination a[aria-current=page]{background:var(--c-blue);color:#fff}.search-card{display:grid;overflow:hidden;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff}.search-card>a{aspect-ratio:16/10;background:#e9edf1}.search-card img{width:100%;height:100%;object-fit:cover}.search-card>div{padding:1.2rem}.search-card h3{margin:.5rem 0}.search-card h3 a{text-decoration:none}.product-type{color:#07499c;font-size:.75rem;font-weight:800;text-transform:uppercase}@media(max-width:1024px){.product-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.product-grid{grid-template-columns:1fr}.filters{grid-template-columns:1fr}}</style>
