---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisibleProducts } from '../../lib/content';
const products=await getVisibleProducts();
---
<BaseLayout title="Инструменты «Докрути» — практические решения" description="Честный статус прикладных инструментов «Докрути»." image="/images/product-preview-workbook-mood.png">
<article class="tools-page"><section class="tools-hero"><div class="container tools-hero__copy"><p class="eyebrow">Инструменты</p><h1>Ответ, который<br/><em>выдержит проверку.</em></h1><p>Сейчас в контуре один продукт в подготовке. Не имитируем магазин: состав, выдача и условия появятся после отдельного подтверждения.</p><div class="trace-mark" aria-hidden="true"><span></span><i></i><b>от вопроса к рабочему решению</b></div></div><figure class="tools-hero__image"><img src="/images/product-preview-workbook-mood.png" alt="Редакционная mood-сцена подготовки инструмента, не скриншот продукта" width="1672" height="941" fetchpriority="high"/><figcaption>Редакционная mood-сцена · не интерфейс продукта</figcaption></figure></section>{products.map((product)=><section class="home-section paper-section"><div class="container tool-band__grid"><div><p class="eyebrow">В подготовке · не продаётся</p><h2>{product.data.title}</h2><p>{product.data.description}</p><a class="button button--outline" href={'/tools/'+product.data.slug+'/'} data-analytics-event="click_product" data-analytics-content-id={product.data.id}>Посмотреть статус ↗</a></div><div class="media-frame"><img src={product.data.cover} alt={product.data.coverAlt} width="836" height="470" loading="lazy"/></div></div></section>)}</article>
</BaseLayout>
<style>
  .tools-hero__image{position:relative;margin:0}.tools-hero__image figcaption{position:absolute;right:1rem;bottom:1rem;padding:.35rem .5rem;background:#17130fcc;color:#fff;font-size:.7rem}
  @media(min-width:901px){.tools-hero{min-height:420px}.tools-hero__copy{padding-block:52px}.tools-hero__copy>p:not(.eyebrow){max-width:460px}.tools-hero__image{margin:24px 0 24px 24px;border-left:3px solid var(--c-orange)}.tools-hero__image img{object-position:center}.tool-band__grid{align-items:center}.tool-band__grid>div:first-child{position:relative;padding-left:26px}.tool-band__grid>div:first-child:before{position:absolute;top:0;bottom:0;left:0;border-left:2px solid var(--c-orange);content:''}}
  @media(max-width:700px){.tools-hero__image{border-top:2px solid var(--c-orange)}}
</style>
