---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../../lib/content';
const related=(await getPublishedArticles()).filter(item=>['CNT-0027','CNT-0030','CNT-0034'].includes(item.data.id)).slice(0,3);
---
<BaseLayout title="Инструменты Докрути — практические решения для задач малого бизнеса" description="Практические инструменты и рабочие материалы для следующей проверки или действия.">
<article class="tools-v4"><header class="tools-hero"><div class="container hero-grid"><div><p class="eyebrow">ИНСТРУМЕНТЫ</p><h1>Проверить самостоятельно</h1><p>Практические инструменты и рабочие материалы для следующей проверки или действия.</p><a href="/articles/">Начать с материалов ↗</a></div><div class="hero-trace" aria-label="Путь от вопроса к действию"><span>Вопрос</span><span>Проверка</span><strong>Действие</strong></div></div></header><section class="container current-tool"><div><p class="eyebrow">РАБОТА С КОМАНДОЙ</p><h2>Система управления командой</h2><p>Инструмент для разбора ситуаций с сотрудниками, проверки фактов и выбора следующего управленческого действия.</p><p>Публичного доступа к инструменту пока нет. По теме команды можно начать с опубликованных материалов.</p></div><div class="tool-logic"><span>Разобрать ситуацию</span><span>Проверить факты</span><span>Выбрать следующий шаг</span></div></section>{related.length>0&&<section class="tool-reading"><div class="container"><p class="eyebrow">ЧИТАТЬ СЕЙЧАС</p><h2>Материалы по теме команды</h2><div>{related.map(item=><a href={'/articles/'+item.data.slug+'/'} data-analytics-event="content_click" data-analytics-content-id={item.data.id}><strong>{item.data.title}</strong><span aria-hidden="true">↗</span></a>)}</div></div></section>}</article>
</BaseLayout>
<style>.tools-v4{background:#fff}.tools-hero{padding:60px 0;background:#f4f5f6}.hero-grid{display:grid;grid-template-columns:1fr .75fr;gap:60px;align-items:center}.hero-grid h1{max-width:800px;margin:0 0 18px;font-size:clamp(50px,6vw,85px)}.hero-grid p:not(.eyebrow){max-width:600px;font-size:18px}.hero-grid a{font-size:14px;font-weight:700;color:#b74323;text-decoration:none}.hero-trace{display:grid;gap:20px;padding:35px;border-left:3px solid #d9562f;background:#17130f;color:#fff}.hero-trace span,.hero-trace strong{padding-bottom:14px;border-bottom:1px solid #fff7;font:600 27px var(--font-editorial)}.current-tool{display:grid;grid-template-columns:1fr .8fr;gap:70px;align-items:center;padding-top:70px;padding-bottom:70px}.current-tool h2{margin:0 0 17px;font-size:clamp(42px,5vw,70px)}.current-tool p:not(.eyebrow){max-width:650px;color:#555;line-height:1.55}.tool-logic{display:grid;gap:15px}.tool-logic span{padding:16px 18px;border-left:3px solid #d9562f;background:#f4f5f6;font:600 22px var(--font-editorial)}.tool-reading{padding:50px 0;background:#f4f5f6}.tool-reading h2{margin:0 0 22px;font-size:clamp(32px,4vw,50px)}.tool-reading a{display:flex;justify-content:space-between;gap:20px;padding:17px 0;border-top:1px solid #9fa3a6;text-decoration:none}.tool-reading a strong{font-size:15px}.tool-reading a span{color:#d9562f}@media(max-width:700px){.hero-grid,.current-tool{grid-template-columns:1fr;gap:25px}.tools-hero{padding:42px 0}.hero-grid h1{font-size:clamp(36px,11vw,65px)}.hero-trace{gap:8px;padding:20px}.hero-trace span,.hero-trace strong{font-size:20px}.current-tool{padding-top:45px;padding-bottom:45px}.current-tool h2{font-size:42px}}</style>
<style>
.tools-hero{display:block;background:#17130f;color:#fff}.hero-grid{display:block}.hero-grid>div:first-child{max-width:870px}.hero-grid a{color:#ff8d69}
.hero-trace{display:flex;justify-content:space-between;gap:20px;margin-top:42px;padding:0;border:0;border-top:2px solid #d9562f;background:transparent;color:#fff}
.hero-trace span,.hero-trace strong{position:relative;flex:1;padding:20px 0 0;border:0;font:600 19px var(--font-editorial)}
.hero-trace span::before,.hero-trace strong::before{position:absolute;top:-8px;left:0;width:13px;height:13px;border:2px solid #d9562f;border-radius:50%;background:#17130f;content:''}
@media(max-width:700px){.hero-trace{display:flex;gap:10px;margin-top:34px}.hero-trace span,.hero-trace strong{font-size:12px;line-height:1.2}}
</style>
