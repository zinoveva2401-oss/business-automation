---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialFolio from '../../components/EditorialFolio.astro';
import EditorialEvidenceTrack from '../../components/EditorialEvidenceTrack.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getVisibleProducts } from '../../lib/content';
const products = await getVisibleProducts();
---
<BaseLayout title="Инструменты «Докрути» — практические решения" description="Честный статус прикладных инструментов «Докрути»." image="/images/product-preview-workbook-mood.png">
  <article class="tools-route">
    <section class="tools-route__hero"><div class="container tools-route__hero-grid"><div><EditorialFolio number="05" label="Tools" /><p class="eyebrow">Рабочие инструменты</p><h1>Ответ, который<br /><em>выдержит проверку.</em></h1><p>Продукт в подготовке. Состав, выдача и условия появятся после отдельного подтверждения — без имитации магазина и fake dashboard.</p></div><figure><img src="/images/product-preview-workbook-mood.png" alt="Материалы продукта в подготовке" width="1200" height="800" fetchpriority="high" /><figcaption>Редакционная mood-сцена · не интерфейс продукта</figcaption></figure></div></section>
    {products.map((product) => <section class="tools-route__dossier"><div class="container dossier-grid"><div class="dossier-copy"><p class="eyebrow">Досье инструмента · {product.data.status === 'HOLD' ? 'В подготовке · не продаётся' : product.data.status}</p><h2>{product.data.title}</h2><p>{product.data.description}</p><div class="dossier-meta"><span>Тип</span><strong>{product.data.type}</strong><span>Статус</span><strong>{product.data.status}</strong></div><a class="button button--outline" href={'/tools/' + product.data.slug + '/'} data-analytics-event="click_product" data-analytics-content-id={product.data.id} data-analytics-placement="tools_dossier">Посмотреть статус <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div><figure class="dossier-image"><ResponsiveImage src={product.data.cover} alt={product.data.coverAlt} width={1200} height={800} loading="lazy" sizes="(max-width: 700px) 100vw, 52vw" /><figcaption>{product.data.coverAlt}</figcaption></figure></div></section>)}
    <EditorialEvidenceTrack dark id="tools-evidence" title="Сначала материал. Потом инструмент." lead="Инструмент нужен там, где вопрос уже сформулирован и его можно проверить на рабочих данных." />
  </article>
</BaseLayout>
<style>
  .tools-route{background:#fff;color:var(--c-graphite)}.tools-route__hero{padding:1.5rem 0 clamp(4rem,8vw,7rem);background:var(--c-paper)}.tools-route__hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);align-items:center}.tools-route__hero .editorial-folio{grid-column:1/-1}.tools-route__hero h1{margin:.45rem 0 1rem;font-size:clamp(3.2rem,6vw,6.5rem);line-height:.89;letter-spacing:-.05em}.tools-route__hero h1 em{color:var(--c-orange);font-style:normal}.tools-route__hero>div>p:not(.eyebrow){max-width:520px;color:#56616a;line-height:1.55}.tools-route__hero figure{position:relative;margin:0;border-left:3px solid var(--c-orange)}.tools-route__hero figure img{aspect-ratio:1.35;object-fit:cover}.tools-route__hero figcaption,.dossier-image figcaption{position:absolute;left:.7rem;bottom:.7rem;padding:.35rem .5rem;background:#17130fcc;color:#fff;font-size:.68rem}.tools-route__dossier{padding:clamp(4rem,8vw,8rem) 0;background:#fff}.dossier-grid{display:grid;grid-template-columns:1fr 1.08fr;gap:clamp(2rem,8vw,8rem);align-items:center}.dossier-copy{max-width:550px}.dossier-copy h2{margin:.4rem 0 .9rem;font-size:clamp(2.5rem,5vw,5rem);line-height:.94}.dossier-copy>p:not(.eyebrow){color:#56616a;line-height:1.55}.dossier-meta{display:grid;grid-template-columns:80px 1fr;gap:.45rem 1rem;margin:1.5rem 0;padding-top:1rem;border-top:1px solid var(--c-graphite);font-size:.78rem}.dossier-meta span{color:var(--c-muted)}.dossier-image{position:relative;margin:0;border-top:2px solid var(--c-orange)}.dossier-image img{aspect-ratio:1.35;object-fit:cover}.dossier-image figcaption{max-width:calc(100% - 1.4rem)}@media(max-width:700px){.tools-route__hero{padding-top:.7rem}.tools-route__hero-grid,.dossier-grid{grid-template-columns:1fr;gap:2rem}.tools-route__hero h1{font-size:clamp(3rem,12vw,4.3rem)}.tools-route__hero figure{order:-1}.dossier-image{order:-1}.dossier-copy h2{font-size:2.8rem}}
</style>
