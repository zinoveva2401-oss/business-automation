---
import BaseLayout from '../../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../../components/Breadcrumbs.astro'; import ProductCard from '../../../components/ProductCard.astro'; import { getVisibleProducts } from '../../../lib/content';
export async function getStaticPaths(){const products=await getVisibleProducts();const pages=Math.ceil(products.length/12);return Array.from({length:Math.max(0,pages-1)},(_,index)=>({params:{page:String(index+2)},props:{page:index+2}}))}
const {page}=Astro.props;const products=await getVisibleProducts();const pageProducts=products.slice((page-1)*12,page*12);const pages=Math.ceil(products.length/12);
---
<BaseLayout title={`Цифровые инструменты — страница ${page} — Розница в цифрах`} description="Каталог цифровых продуктов и инструментов для магазина."><section class="tools-page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты',href:'/tools/'},{name:`Страница ${page}`}]} /><h1>Инструменты</h1><div class="product-grid">{pageProducts.map((product)=><ProductCard product={product} placement="tools_pagination" />)}</div><nav class="pagination" aria-label="Страницы каталога">{Array.from({length:pages},(_,index)=><a href={index===0?'/tools/':`/tools/page/${index+1}/`} aria-current={index+1===page?'page':undefined}>{index+1}</a>)}</nav></div></section></BaseLayout>
<style>.tools-page{padding-block:var(--section)}.tools-page h1{font-size:clamp(2.4rem,5vw,4rem)}.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.pagination{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:2rem}.pagination a{display:grid;width:44px;height:44px;place-items:center;border:1px solid var(--c-line);border-radius:var(--r-sm);text-decoration:none}.pagination a[aria-current=page]{background:var(--c-blue);color:#fff}@media(max-width:1024px){.product-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.product-grid{grid-template-columns:1fr}}</style>
