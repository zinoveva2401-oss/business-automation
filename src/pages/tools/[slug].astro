---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { formatDate, formatPrice } from '../../lib/site';

export async function getStaticPaths(){return(await getCollection('tools')).filter(({data})=>data.status!=='draft').map((entry)=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props;
const articles=(await getCollection('articles')).filter(({data})=>!data.draft&&entry.data.relatedArticleIds.includes(data.id));
const services=(await getCollection('services')).filter(({data})=>data.active&&entry.data.relatedServiceIds.includes(data.id));
const purchasable=entry.data.status==='published'&&entry.data.purchaseStatus==='active'&&Boolean(entry.data.purchaseUrl);
const schema=purchasable?{'@context':'https://schema.org','@type':'Product',name:entry.data.title,description:entry.data.description,image:[entry.data.cover,...entry.data.screenshots.map(({src})=>src)],offers:{'@type':'Offer',price:entry.data.price,priceCurrency:'RUB',availability:'https://schema.org/InStock',url:entry.data.purchaseUrl}}:undefined;
---
<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} image={entry.data.cover} type="product" canonicalUrl={entry.data.canonicalUrl} schema={schema} noindex={!purchasable}>
<article class="product-page" data-analytics-view="view_product" data-analytics-product-id={entry.data.id} data-analytics-content-type="product" data-analytics-category={entry.data.category} data-analytics-cluster={entry.data.cluster} data-analytics-placement="product_page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты',href:'/tools/'},{name:entry.data.title}]} />
<header class="product-hero"><div><p class="eyebrow">{entry.data.type}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p><p class="format">{entry.data.deliveryType}</p>{purchasable?<div class="purchase"><strong>{formatPrice(entry.data.price,entry.data.pricePrefix)}</strong><a class="button button--primary" href={entry.data.purchaseUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="click_product_purchase" data-analytics-secondary-event="outbound_checkout" data-analytics-product-id={entry.data.id} data-analytics-destination={entry.data.purchaseChannel} data-analytics-cta-id="product_primary">Купить / Получить доступ</a></div>:<div class="status-block"><span class="status">В разработке</span><span>{formatPrice(entry.data.price,entry.data.pricePrefix)}</span></div>}</div><ResponsiveImage src={entry.data.cover} alt={entry.data.coverAlt} width={1672} height={941} loading="eager" fetchpriority="high" sizes="(max-width: 768px) 100vw, 50vw" /></header>
{entry.data.includedFormats.length>0&&<section class="formats"><p class="eyebrow">Что вы получаете</p><h2>Два материала для работы с ситуацией</h2><div>{entry.data.includedFormats.map((format)=><article><h3>{format.title}</h3><p>{format.description}</p><ul>{format.items.map((item)=><li>{item}</li>)}</ul></article>)}</div></section>}
<section class="product-intro"><p class="eyebrow">Зачем нужна система</p><h2>{entry.data.problem}</h2><p>{entry.data.problemDescription ?? entry.data.result}</p></section>
<div class="product-lists">{entry.data.managementLevels.length>0&&<section class="levels"><p class="eyebrow">Содержание</p><h2>Что разбираем в электронной книге</h2><ol>{entry.data.managementLevels.map((item,index)=><li><span>0{index+1}</span><div><strong>{item.title}</strong><p>{item.description}</p></div></li>)}</ol></section>}{entry.data.workbookSections.length>0&&<section class="workbook"><p class="eyebrow">Инструменты</p><h2>Что есть в рабочей книге Excel</h2><ol>{entry.data.workbookSections.map((item,index)=><li><span>0{index+1}</span><div><strong>{item.title}</strong><p>{item.description}</p></div></li>)}</ol></section>}</div>
{entry.data.previewSlots.length>0&&<section class="preview-slots"><p class="eyebrow">Предварительный вид рабочей книги</p><h2>Фрагменты рабочей книги</h2><div>{entry.data.previewSlots.map((slot)=><article><div class="preview-placeholder" aria-hidden="true"><span>{slot.title}</span></div><h3>{slot.title}</h3><p>{slot.description}</p></article>)}</div></section>}
<div class="product-details"><section><h2>Кому подходит</h2><ul>{entry.data.forWhom.map((item)=><li>{item}</li>)}</ul></section>{entry.data.notForWhom&&entry.data.notForWhom.length>0&&<section><h2>Кому не подходит</h2><ul>{entry.data.notForWhom.map((item)=><li>{item}</li>)}</ul></section>}<section><h2>Что получает руководитель</h2><p>{entry.data.result}</p></section><section><h2>Как работает система</h2><ol>{entry.data.workflow.map((item)=><li>{item}</li>)}</ol></section></div>
<p class="version">Версия {entry.data.version} · обновлено {formatDate(entry.data.updatedAt)}</p>{entry.data.faq.length>0&&<section class="faq"><h2>Вопросы и ответы</h2>{entry.data.faq.map((item)=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}{articles.length>0&&<section class="related"><h2>Полезные статьи</h2><div>{articles.map((article)=><ArticleCard article={article} placement="product_related" />)}</div></section>}{services.length>0&&<section class="service-next"><p class="eyebrow">Если нужен разбор</p><h2>Задать вопрос по ситуации в магазине</h2><div>{services.map((service)=><a class="button button--primary" href={`/services/#${service.data.slug}`} data-analytics-event="click_service" data-analytics-service-id={service.data.id} data-analytics-placement="product_service_next">{service.data.title} <i class="ti ti-arrow-right" aria-hidden="true"></i></a>)}</div></section>}{purchasable&&<p class="legal-links"><a href="/offer/">Оферта</a> · <a href="/payment-and-refund/">Оплата и возврат</a> · <a href="/license/">Лицензия</a></p>}</div></article></BaseLayout>
<style>
.product-page{padding-block:var(--section)}.product-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(2rem,5vw,4rem)}.product-hero h1{margin:.2rem 0 .8rem;font-size:clamp(2.3rem,5vw,4rem);line-height:1}.product-hero>div>p:not(.eyebrow){font-size:1.08rem}.product-hero>picture{width:100%;max-height:440px;overflow:hidden;border-radius:var(--r-md)}.product-hero>picture img{width:100%;height:100%;object-fit:cover}.format{font-family:var(--font-editorial);color:var(--c-blue)}.purchase,.status-block{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin-top:1.5rem}.purchase strong{font-size:1.4rem}.status-block{color:#687078}.status{display:inline-block;padding:.5rem .7rem;border-radius:var(--r-sm);background:#e9edf1;color:var(--c-ink);font-weight:700}.formats,.product-intro,.levels,.workbook,.preview-slots,.service-next{margin-top:3rem;padding:1.5rem;border-left:4px solid var(--c-orange);background:#fff}.formats h2,.product-intro h2,.levels h2,.workbook h2,.preview-slots h2,.service-next h2{margin:.2rem 0 .7rem}.formats>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.formats article{padding:1.1rem;border:1px solid var(--c-line);border-radius:var(--r-md);background:#f8fafb}.formats h3{margin:0 0 .45rem;font-size:1.1rem}.formats p{margin:0 0 .75rem;color:#555d64;line-height:1.45}.formats ul,.product-details ul,.product-details ol{margin:0;padding-left:1.2rem}.formats li,.product-details li{margin:.35rem 0}.product-intro p:last-child{max-width:70ch;font-size:1.05rem;line-height:1.6}.product-lists{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:3rem}.product-lists .levels,.product-lists .workbook{margin-top:0}.levels ol,.workbook ol{display:grid;gap:0;margin:1rem 0 0;padding:0;list-style:none}.levels li,.workbook li{display:flex;gap:.8rem;align-items:flex-start;padding:.75rem 0;border-top:1px solid var(--c-line)}.levels li span,.workbook li span{color:var(--c-orange);font:1.2rem var(--font-editorial);flex-shrink:0}.levels li strong,.workbook li strong{display:block}.levels li p,.workbook li p{margin:.25rem 0 0;color:#687078;font-size:.92rem;line-height:1.4}.product-details{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:3rem}.product-details section{padding:1.25rem;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff}.product-details h2{margin-top:0}.product-details p{line-height:1.55}.preview-slots>div{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.preview-slots article{min-width:0}.preview-placeholder{display:grid;aspect-ratio:16/10;place-items:end start;padding:.8rem;border:1px solid var(--c-line);background:#eef1f3;color:#687078;font-family:var(--font-editorial)}.preview-placeholder span{padding:.35rem .5rem;background:#fff}.preview-slots h3{margin:.7rem 0 .25rem;font-size:1rem}.preview-slots p{margin:0;color:#687078;font-size:.9rem}.faq,.related,.service-next{margin-top:3rem}.related>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.version,.legal-links{margin-top:2rem;color:#687078}.faq details{padding:1rem 0;border-top:1px solid var(--c-line)}.faq summary{font-weight:700;cursor:pointer}.service-next>div{display:flex;flex-wrap:wrap;gap:.75rem}@media(max-width:768px){.product-hero,.product-details,.product-lists,.formats>div{grid-template-columns:1fr}.product-hero>picture{max-height:300px}.product-hero>div{order:1}.product-hero>picture{order:0}.preview-slots>div,.related>div{grid-template-columns:1fr}.formats,.product-intro,.levels,.workbook,.preview-slots,.service-next{padding:1rem}.product-hero h1{font-size:clamp(2rem,9vw,2.7rem)}.product-lists{gap:0}.product-lists .workbook{margin-top:1rem}}
</style>
