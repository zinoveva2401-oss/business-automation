---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import { getCollection } from 'astro:content'; import { formatDate,formatPrice } from '../../lib/site';
export async function getStaticPaths(){return(await getCollection('tools')).filter(({data})=>data.status!=='draft').map((entry)=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props;const articles=(await getCollection('articles')).filter(({data})=>!data.draft&&entry.data.relatedArticleIds.includes(data.id));const purchasable=entry.data.status==='published'&&entry.data.purchaseStatus==='active'&&Boolean(entry.data.purchaseUrl);const schema=purchasable?{'@context':'https://schema.org','@type':'Product',name:entry.data.title,description:entry.data.description,image:[entry.data.cover,...entry.data.screenshots.map(({src})=>src)],offers:{'@type':'Offer',price:entry.data.price,priceCurrency:'RUB',availability:'https://schema.org/InStock',url:entry.data.purchaseUrl}}:undefined;
---
<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} image={entry.data.cover} type="product" canonicalUrl={entry.data.canonicalUrl} schema={schema} noindex={!purchasable}><article class="product-page" data-analytics-view="view_product" data-analytics-product-id={entry.data.id} data-analytics-content-type="product" data-analytics-category={entry.data.category} data-analytics-cluster={entry.data.cluster}><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты',href:'/tools/'},{name:entry.data.title}]} /><header class="product-hero"><div><p class="eyebrow">{entry.data.type}</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p>{purchasable?<div class="purchase"><strong>{formatPrice(entry.data.price,entry.data.pricePrefix)}</strong><a class="button button--primary" href={entry.data.purchaseUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="click_product_purchase" data-analytics-secondary-event="outbound_checkout" data-analytics-product-id={entry.data.id} data-analytics-destination={entry.data.purchaseChannel} data-analytics-cta-id="product_primary">Купить / Получить доступ</a></div>:<span class="status">Готовится к запуску</span>}</div><img src={entry.data.cover} alt={entry.data.coverAlt} width="2800" height="1800" loading="eager" /></header><div class="product-details"><section><h2>Проблема</h2><p>{entry.data.problem}</p></section><section><h2>Кому подходит</h2><ul>{entry.data.forWhom.map((item)=><li>{item}</li>)}</ul></section>{entry.data.notForWhom&&entry.data.notForWhom.length>0&&<section><h2>Кому не подходит</h2><ul>{entry.data.notForWhom.map((item)=><li>{item}</li>)}</ul></section>}<section><h2>Результат</h2><p>{entry.data.result}</p></section><section><h2>Что входит</h2><ul>{entry.data.contents.map((item)=><li>{item}</li>)}</ul></section><section><h2>Как работает</h2><ol>{entry.data.workflow.map((item)=><li>{item}</li>)}</ol></section></div>{entry.data.screenshots.length>0&&<section class="screens"><h2>Интерфейс</h2><div>{entry.data.screenshots.map((shot)=><img src={shot.src} alt={shot.alt} width="2800" height="1800" loading="lazy" />)}</div></section>}<p class="version">Версия {entry.data.version} · обновлено {formatDate(entry.data.updatedAt)}</p>{entry.data.faq.length>0&&<section class="faq"><h2>Вопросы и ответы</h2>{entry.data.faq.map((item)=><details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}{articles.length>0&&<section class="related"><h2>Полезные статьи</h2><div>{articles.map((article)=><ArticleCard article={article} placement="product_related" />)}</div></section>}{purchasable&&<p class="legal-links"><a href="/offer/">Оферта</a> · <a href="/payment-and-refund/">Оплата и возврат</a> · <a href="/license/">Лицензия</a></p>}</div></article></BaseLayout>
<style>.product-page{padding-block:var(--section)}.product-hero{display:grid;grid-template-columns:1fr 1fr;align-items:center;gap:clamp(2rem,5vw,4rem)}.product-hero h1{margin:.2rem 0 .8rem;font-size:clamp(2.3rem,5vw,4rem);line-height:1}.product-hero>div>p:not(.eyebrow){font-size:1.08rem}.product-hero img{width:100%;max-height:440px;border-radius:var(--r-md);object-fit:cover}.purchase{display:flex;flex-wrap:wrap;align-items:center;gap:1rem;margin-top:1.5rem}.purchase strong{font-size:1.4rem}.status{display:inline-block;margin-top:1rem;padding:.5rem .7rem;border-radius:var(--r-sm);background:#e9edf1;font-weight:700}.product-details{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:3rem}.product-details section{padding:1.25rem;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff}.product-details h2{margin-top:0}.screens,.faq,.related{margin-top:3rem}.screens>div,.related>div{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}.screens img{border:1px solid var(--c-line);border-radius:var(--r-md)}.version,.legal-links{margin-top:2rem;color:#687078}.faq details{padding:1rem 0;border-top:1px solid var(--c-line)}.faq summary{font-weight:700;cursor:pointer}@media(max-width:768px){.product-hero,.product-details{grid-template-columns:1fr}.screens>div,.related>div{grid-template-columns:1fr}}</style>
