---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){return (await getCollection('tools')).map(entry=>({params:{slug:entry.id},props:{entry}}))}
const {entry}=Astro.props; const {Content}=await render(entry); const money=(value:number)=>new Intl.NumberFormat('ru-RU').format(value)+' ₽';
const productSchema={'@context':'https://schema.org','@type':'Product',name:entry.data.title,description:entry.data.description,image:entry.data.image,offers:{'@type':'Offer',price:entry.data.price,priceCurrency:'RUB',availability:'https://schema.org/InStock'}};
---
<BaseLayout title={`${entry.data.title} — Розница в цифрах`} description={entry.data.description} image={entry.data.image} schema={productSchema}><article class="product-page" data-analytics-view="product_view"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты',href:'/tools/'},{name:entry.data.title}]} /><div class="product-hero"><div><p class="eyebrow">Цифровой инструмент · доступен</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p><strong>{money(entry.data.price)}</strong><div class="checkout-future" aria-label="Будущая форма заказа"><b>Онлайн-заказ готовится</b><span>Оплата и автоматическая выдача не подключены до отдельного согласования.</span></div></div><img src={entry.data.image} alt={`Предварительный вид продукта «${entry.data.title}»`}/></div><div class="product-copy"><Content/></div></div></article></BaseLayout>
<style>.product-page{padding-block:var(--section)}.product-hero{display:grid;grid-template-columns:1fr 1.15fr;align-items:center;gap:clamp(2rem,5vw,5rem)}.product-hero h1{margin:.4rem 0 1rem;font-family:var(--font-editorial);font-size:clamp(2.8rem,5vw,5rem);line-height:.96}.product-hero>div>strong{display:block;margin:1.5rem 0;color:var(--c-orange);font-size:1.7rem}.product-hero img{border-radius:var(--r-lg)}.checkout-future{display:grid;gap:.25rem;max-width:560px;padding:1rem;border-left:4px solid var(--c-orange);background:#fff}.checkout-future span{font-size:.85rem;color:#62676c}.product-copy{max-width:780px;margin-top:3rem;font-size:1.05rem}@media(max-width:760px){.product-hero{grid-template-columns:1fr}}</style>
