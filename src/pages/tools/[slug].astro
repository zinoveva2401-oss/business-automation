---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getCollection } from 'astro:content';
import { formatPrice } from '../../lib/site';

export async function getStaticPaths(){return(await getCollection('tools')).filter(({data})=>data.status!=='draft').map((entry)=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props;
const purchasable=entry.data.status==='published'&&entry.data.purchaseStatus==='active'&&Boolean(entry.data.purchaseUrl);
const schema=purchasable?{'@context':'https://schema.org','@type':'Product',name:entry.data.title,description:entry.data.description,image:[entry.data.cover,...entry.data.screenshots.map(({src})=>src)],offers:{'@type':'Offer',price:entry.data.price,priceCurrency:'RUB',availability:'https://schema.org/InStock',url:entry.data.purchaseUrl}}:undefined;
---
<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} image={entry.data.cover} type="product" canonicalUrl={entry.data.canonicalUrl} schema={schema} noindex={!purchasable}>
<article class="product-page" data-analytics-view="view_product" data-analytics-product-id={entry.data.id} data-analytics-content-type="product" data-analytics-category={entry.data.category} data-analytics-cluster={entry.data.cluster} data-analytics-placement="product_page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Инструменты',href:'/tools/'},{name:entry.data.title}]} />
<header class="compact-hero"><div class="hero-copy"><a class="back-link" href="/tools/">← Все продукты</a><p class="eyebrow">{entry.data.type}</p><h1>{entry.data.title}</h1><p class="hero-description">{entry.data.description}</p><div class="hero-meta"><span class="format">{entry.data.deliveryType}</span>{purchasable?<div class="purchase"><strong>{formatPrice(entry.data.price,entry.data.pricePrefix)}</strong><a class="button button--primary" href={entry.data.purchaseUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="click_product_purchase" data-analytics-secondary-event="outbound_checkout" data-analytics-product-id={entry.data.id} data-analytics-destination={entry.data.purchaseChannel} data-analytics-cta-id="product_primary">Купить / Получить доступ</a></div>:<div class="status-price"><span class="status">В разработке</span><span>{formatPrice(entry.data.price,entry.data.pricePrefix)}</span></div>}</div></div><div class="hero-media"><ResponsiveImage src={entry.data.cover} alt={entry.data.coverAlt} width={1672} height={941} loading="eager" fetchpriority="high" sizes="(max-width: 768px) 100vw, 60vw" /></div></header>
{entry.data.includedFormats.length>0&&<section class="formats"><p class="eyebrow">Что вы получаете</p><div>{entry.data.includedFormats.map((format)=><article><div class="format-icon" aria-hidden="true">{format.title.includes('Excel')?'X':'▤'}</div><div><h2>{format.title}</h2><p>{format.description}</p><ul>{format.items.map((item)=><li>{item}</li>)}</ul></div></article>)}</div></section>}
<section class="content-tools"><section class="content-list"><p class="eyebrow">Содержание</p><h2>Что разбираем в электронной книге</h2><ol>{entry.data.managementLevels.map((item,index)=><li><span>0{index+1}</span><div><strong>{item.title}</strong><em>{item.description}</em></div></li>)}</ol></section><section class="tools-list"><p class="eyebrow">Инструменты</p><h2>Что есть в рабочей книге Excel</h2><ol>{entry.data.workbookSections.map((item,index)=><li><span>0{index+1}</span><div><strong>{item.title}</strong><em>{item.description}</em></div></li>)}</ol></section></section>
<section class="preview-result"><div class="preview"><p class="eyebrow">Предварительный вид рабочей книги</p><h2>Фрагменты рабочей книги</h2><div class="preview-grid">{entry.data.previewSlots.map((slot)=><article><div class="preview-placeholder" aria-hidden="true"><span>{slot.title}</span></div><h3>{slot.title}</h3></article>)}</div></div><aside class="result-card"><section><h2>Кому подходит</h2><ul>{entry.data.forWhom.map((item)=><li>{item}</li>)}</ul></section><section><h2>Что получает руководитель</h2><p>{entry.data.result}</p></section><div class="result-footer"><span class="status-dot">●</span><span>Продукт в разработке</span><a href="/#question" data-analytics-event="click_contact" data-analytics-placement="product_contact">Задать вопрос <i class="ti ti-message-circle" aria-hidden="true"></i></a></div></aside></section>
</div></article></BaseLayout>
<style>
.product-page{padding-block:1rem 2.5rem;background:#f6f3ee}.product-page>.container{max-width:1180px}.product-page :global(.breadcrumbs){margin-bottom:.8rem}.compact-hero{position:relative;display:grid;min-height:460px;overflow:hidden;border-radius:12px;background:#13181d;color:#fff;isolation:isolate}.hero-media{position:absolute;inset:0;z-index:-2}.hero-media::after{position:absolute;inset:0;content:'';background:linear-gradient(90deg,#101418f5 0%,#101418de 31%,#10141882 56%,#10141822 100%)}.hero-media picture,.hero-media img{display:block;width:100%;height:100%}.hero-media img{object-fit:cover;object-position:center}.hero-copy{z-index:1;display:flex;width:min(58%,620px);flex-direction:column;justify-content:center;padding:2.5rem}.back-link{margin-bottom:1.6rem;color:#eef3f5;font-size:.9rem;text-decoration:none}.compact-hero .eyebrow{color:#ff6a17}.compact-hero h1{max-width:650px;margin:0 0 .8rem;font-size:clamp(2.8rem,5vw,5.4rem);line-height:.9;letter-spacing:-.035em}.hero-description{max-width:560px;margin:0;color:#f1f3f4;font-size:1.12rem;line-height:1.4}.hero-meta{display:flex;flex-wrap:wrap;align-items:center;gap:1.25rem;margin-top:1.5rem}.format{max-width:250px;color:#fff;font-size:.95rem;line-height:1.25}.status-price{display:flex;align-items:center;gap:.75rem;color:#fff}.status{padding:.55rem .75rem;border-radius:7px;background:#2a3035;font-weight:700}.purchase{display:flex;align-items:center;gap:.8rem}.purchase strong{font-size:1.3rem}.formats,.content-tools,.preview-result{margin-top:1rem}.formats{padding:1rem 1.2rem;background:#fff;border-radius:10px}.formats>div{display:grid;grid-template-columns:repeat(2,1fr);gap:.8rem}.formats article{display:grid;grid-template-columns:52px 1fr;gap:.75rem;align-items:start;padding:.75rem;border:1px solid #e1e5e7;border-radius:8px;background:#fbfcfc}.format-icon{display:grid;width:42px;height:42px;place-items:center;border-radius:8px;background:#1274dc;color:#fff;font:700 1.35rem var(--font-ui)}.formats article:nth-child(2) .format-icon{background:#16834b}.formats h2,.content-tools h2,.preview-result h2{margin:0 0 .35rem;font-size:1.45rem;line-height:1.05}.formats p{margin:0 0 .45rem;color:#525b61;font-size:.8rem;line-height:1.35}.formats ul{display:grid;gap:.25rem;margin:0;padding:0;list-style:none;color:#20282d;font-size:.78rem}.formats li::before{margin-right:.35rem;color:#1478dc;content:'✓';font-weight:800}.content-tools{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:#dfe4e6}.content-tools>section{padding:1.15rem 1.3rem;background:#fff}.content-tools .eyebrow,.preview .eyebrow{margin-bottom:.3rem}.content-tools ol{display:grid;gap:0;margin:0;padding:0;list-style:none}.content-tools li{display:grid;grid-template-columns:32px 1fr;gap:.5rem;padding:.5rem 0;border-top:1px solid #e4e7e8}.content-tools li>span{color:#1179e0;font-weight:800}.content-tools li strong{display:block;font-size:.84rem;line-height:1.15}.content-tools li em{display:block;margin-top:.12rem;color:#687178;font-size:.72rem;font-style:normal;line-height:1.25}.preview-result{display:grid;grid-template-columns:1.55fr .95fr;gap:1px;background:#dfe4e6}.preview,.result-card{padding:1.15rem 1.3rem;background:#fff}.preview-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.preview-placeholder{display:grid;aspect-ratio:1.4;place-items:end start;padding:.45rem;border:1px solid #dce2e5;background:#edf1f3;color:#56616a;font-family:var(--font-editorial);font-size:.78rem}.preview-placeholder span{padding:.25rem .35rem;background:#fff}.preview h3{margin:.4rem 0 0;font-size:.75rem}.result-card{display:flex;flex-direction:column;gap:1rem}.result-card section{padding-bottom:.8rem;border-bottom:1px solid #dfe4e6}.result-card h2{font-size:1.15rem}.result-card ul{display:grid;gap:.35rem;margin:0;padding-left:1.1rem;color:#4f5960;font-size:.78rem}.result-card p{margin:0;color:#263038;font-size:.8rem;line-height:1.4}.result-footer{display:flex;flex-wrap:wrap;align-items:center;gap:.35rem;margin-top:auto;color:#5e6870;font-size:.78rem}.result-footer a{display:inline-flex;align-items:center;gap:.3rem;margin-left:auto;color:#1675d1;font-weight:700;text-decoration:none}.status-dot{color:var(--c-orange);font-size:1.1rem}.status-dot+i{font-size:1rem}@media(max-width:768px){.product-page{padding:0 0 1.5rem}.product-page>.container{width:100%}.product-page :global(.breadcrumbs){margin:0;padding:.75rem 1rem;background:#f6f3ee}.compact-hero{display:flex;min-height:0;flex-direction:column;border-radius:0}.hero-copy{order:1;width:auto;padding:1.2rem 1rem 1.35rem;background:#13181d}.hero-media{position:static;order:2;height:auto}.hero-media::after{display:none}.hero-media picture,.hero-media img{height:auto}.hero-media img{aspect-ratio:16/9;object-fit:cover}.back-link{margin-bottom:1rem;font-size:.8rem}.compact-hero h1{max-width:100%;font-size:clamp(2.35rem,11vw,3.2rem);line-height:.91}.hero-description{font-size:.9rem;line-height:1.35}.hero-meta{gap:.8rem;margin-top:1rem}.format{max-width:205px;font-size:.78rem}.status-price{font-size:.78rem}.status{padding:.4rem .55rem}.formats,.content-tools,.preview-result{margin-top:.65rem}.formats{padding:.85rem 1rem;border-radius:0}.formats>div{grid-template-columns:1fr;gap:.55rem}.formats article{grid-template-columns:40px 1fr;padding:.65rem}.format-icon{width:34px;height:34px;font-size:1.1rem}.formats h2,.content-tools h2,.preview-result h2{font-size:1.2rem}.formats p,.formats ul{font-size:.75rem}.content-tools{grid-template-columns:1fr;gap:0}.content-tools>section{padding:.9rem 1rem}.content-tools li{padding:.45rem 0}.content-tools li strong{font-size:.78rem}.content-tools li em{font-size:.68rem}.preview-result{grid-template-columns:1fr;gap:0}.preview,.result-card{padding:.9rem 1rem}.preview-grid{gap:.4rem}.preview-placeholder{padding:.3rem;font-size:.65rem}.preview h3{font-size:.68rem}.result-card{gap:.75rem}.result-card h2{font-size:1.05rem}.result-card ul,.result-card p,.result-footer{font-size:.75rem}.result-footer a{margin-left:auto}}
</style>
