---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialArticleRow from '../../components/EditorialArticleRow.astro';
import { getPublishedArticles } from '../../lib/content';
import { categories } from '../../lib/site';
const articles=await getPublishedArticles();
const featured=articles.find(item=>item.data.id==='CNT-0026') ?? articles[0];
const rest=articles.filter(item=>item.data.id!==featured?.data.id);
const heroScene=rest[0]??featured;
const types=[...new Set(articles.map(item=>item.data.content_type))];
---
<BaseLayout title="Библиотека Докрути — практические материалы для малого бизнеса" description="Статьи, разборы и другие опубликованные материалы по реальным задачам бизнеса." image={featured?.data.cover}>
<article class="library-v4"><header class="library-intro"><div class="container intro-grid"><div><p class="eyebrow">ПРАКТИЧЕСКИЕ МАТЕРИАЛЫ</p><h1>Библиотека Докрути</h1><p>Практические материалы по реальным задачам бизнеса.</p></div><figure class="intro-artifact">{heroScene&&<img src={heroScene.data.cover} alt={heroScene.data.coverAlt} loading="eager" decoding="async"/>}<figcaption>Факт → проверка → следующий шаг</figcaption></figure></div></header>
<section class="container library-content"><nav class="topic-filters" aria-label="Темы материалов" data-topic-filters><a href="/articles/" data-topic="" aria-current="page">Все темы</a>{categories.map(item=><a href={'/articles/?topic='+item.slug} data-topic={item.slug} data-analytics-event="topic_click" data-analytics-topic={item.slug}>{item.name}</a>)}</nav>
{types.length>1&&<nav class="type-filters" aria-label="Форматы материалов" data-type-filters><a href="/articles/" data-type="" aria-current="page">Все форматы</a>{types.map(type=><a href={'/articles/?content_type='+encodeURIComponent(type)} data-type={type}>{type}</a>)}</nav>}
<div class="library-title"><h2>Материалы для вашей задачи</h2><p data-empty hidden>По этому фильтру пока нет опубликованных материалов.</p></div>
<div class="library-results" data-results>{featured&&<EditorialArticleRow article={featured} featured placement="library_feature"/>}{rest.map((item,index)=><EditorialArticleRow article={item} rank={index+1} placement="library_list"/>)}</div></section></article>
</BaseLayout>
<script>
 const aliases:Record<string,string>={prodazhi:'sales','assortiment-zakupki':'assortiment-i-zakupki',pokupatel:'klienty',personal:'komanda',upravlenie:'upravlenie-i-processy','ai-avtomatizatsiya':'ii-i-avtomatizaciya'};
 const cards=[...document.querySelectorAll<HTMLElement>('[data-article-card]')];const empty=document.querySelector<HTMLElement>('[data-empty]');
 const update=()=>{const url=new URL(location.href);let topic=url.searchParams.get('topic')||url.searchParams.get('category')||'';topic=aliases[topic]||topic;const type=url.searchParams.get('content_type')||'';let shown=0;cards.forEach(card=>{const visible=(!topic||card.dataset.topic===topic)&&(!type||card.dataset.contentType===type);card.hidden=!visible;if(visible)shown++});if(empty)empty.hidden=shown!==0;document.querySelectorAll<HTMLElement>('[data-topic]').forEach(el=>{if(el.dataset.topic===topic)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current')});document.querySelectorAll<HTMLElement>('[data-type]').forEach(el=>{if(el.dataset.type===type)el.setAttribute('aria-current','page');else el.removeAttribute('aria-current')});const robots=document.querySelector<HTMLMetaElement>('meta[name=robots]');if(robots&&!robots.content.includes('nofollow'))robots.content=url.search?'noindex,follow':'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1';};
 document.querySelectorAll<HTMLAnchorElement>('[data-topic],[data-type]').forEach(link=>link.addEventListener('click',event=>{event.preventDefault();const url=new URL(location.href);if(link.dataset.topic!==undefined){const topic=link.dataset.topic;topic?url.searchParams.set('topic',topic):url.searchParams.delete('topic');url.searchParams.delete('category')}if(link.dataset.type!==undefined){const type=link.dataset.type;type?url.searchParams.set('content_type',type):url.searchParams.delete('content_type')}history.pushState(null,'',url);update()}));addEventListener('popstate',update);update();
</script>
<style>.library-v4{background:#fff}.library-intro{padding:58px 0;background:#f4f5f6}.intro-grid{display:grid;grid-template-columns:1fr .65fr;gap:40px;align-items:center}.intro-grid h1{max-width:800px;margin:0 0 18px;font-size:clamp(50px,6vw,85px)}.intro-grid p:last-child{max-width:600px;font-size:18px}.intro-artifact{position:relative;min-height:270px;margin:0;overflow:hidden;border-left:3px solid #d9562f;background:#17130f}.intro-artifact img{display:block;width:100%;height:270px;object-fit:cover}.intro-artifact figcaption{position:absolute;right:0;bottom:0;left:0;padding:24px;color:#fff;background:linear-gradient(transparent,#17130fe8);font:600 22px var(--font-editorial)}.library-content{padding-top:30px;padding-bottom:65px}.topic-filters,.type-filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:18px}.topic-filters a,.type-filters a{display:inline-flex;min-height:44px;align-items:center;padding:8px 12px;border:1px solid #bfc4c9;font-size:12px;text-decoration:none}.topic-filters a[aria-current=page],.type-filters a[aria-current=page]{border-color:#17130f;background:#17130f;color:#fff}.library-title h2{margin:34px 0 24px;font-size:clamp(32px,4vw,50px)}.library-results{display:grid;grid-template-columns:1fr 1fr;gap:0 22px}.library-results :global(.editorial-article-row--featured){grid-column:1/-1;margin-bottom:20px}.library-results :global(.editorial-article-row[hidden]){display:none}@media(max-width:700px){.intro-grid,.library-results{grid-template-columns:1fr}.library-intro{padding:42px 0}.intro-grid h1{font-size:clamp(45px,11vw,65px)}.intro-artifact{display:none}.library-results :global(.editorial-article-row--featured){grid-column:1}.library-content{padding-bottom:45px}}</style>
