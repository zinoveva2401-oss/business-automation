---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
const articles = (await getCollection('articles')).filter(({data}) => !data.draft).sort((a,b)=>b.data.publishedAt.valueOf()-a.data.publishedAt.valueOf());
---
<BaseLayout title="Статьи о розничном бизнесе — Розница в цифрах" description="Практические материалы о продажах, товаре, покупателях, персонале, управлении, маркетинге и автоматизации."><section class="article-catalog"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Статьи'}]} /><p class="eyebrow">База знаний</p><h1>Статьи о системном управлении розницей</h1>{articles.length ? <div class="article-list">{articles.map(({id,data})=><article><span>{data.category}</span><h2><a href={`/articles/${id}/`}>{data.title}</a></h2><p>{data.description}</p><small>{data.publishedAt.toLocaleDateString('ru-RU')} · {data.readingTime} мин чтения</small></article>)}</div> : <p>Первый практический материал готовится. Каталог автоматически наполнится после публикации утверждённых статей.</p>}</div></section></BaseLayout>
<style>.article-catalog{min-height:62vh;padding-block:var(--section)}.article-catalog h1{max-width:1000px;font-family:var(--font-editorial);font-size:clamp(2.8rem,6vw,5.5rem);line-height:.96}.article-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.article-list article{padding:1.5rem;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff}.article-list span{color:#174c8b;font-size:.75rem;font-weight:800;text-transform:uppercase}.article-list h2{font-family:var(--font-editorial)}.article-list h2 a{text-decoration:none}.article-list small{color:#666}@media(max-width:900px){.article-list{grid-template-columns:repeat(2,1fr)}}@media(max-width:620px){.article-list{grid-template-columns:1fr}}</style>
