---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialFolio from '../../components/EditorialFolio.astro';
import EditorialProblemMap from '../../components/EditorialProblemMap.astro';
import EditorialArticleRow from '../../components/EditorialArticleRow.astro';
import { getPublishedArticles } from '../../lib/content';
import { categories } from '../../lib/site';
const articles = await getPublishedArticles();
const featuredArticle = articles.find(({ data }) => data.id === 'CNT-0007') ?? articles[0];
const supportingArticles = featuredArticle ? articles.filter((article) => article.data.id !== featuredArticle.data.id) : articles;
const clusters = [...new Set(articles.map(({ data }) => data.cluster))];
const selectedCategory = Astro.url.searchParams.get('category') ?? '';
---
<BaseLayout title="Библиотека «Докрути» — статьи и разборы" description="Практические материалы о продажах, клиентах, команде, управлении, маркетинге и автоматизации." image={featuredArticle?.data.cover ?? '/images/home-hero-editorial.png'}>
  <article class="library-route">
    <div class="container library-route__top"><Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: 'Библиотека' }]} /><EditorialFolio number="03" label="Library" /></div>
    <section class="library-route__intro"><div class="container"><p class="eyebrow">Свежие материалы</p><h1>Сначала увидеть причину.<br /><em>Потом выбрать действие.</em></h1><p>Разборы рабочих ситуаций, в которых важно начать с наблюдаемого факта и одной следующей проверки.</p></div></section>
    <section class="library-route__map"><div class="container"><EditorialProblemMap currentSlug={selectedCategory} /></div></section>
    <section class="library-route__desk"><div class="container">
      <form class="editorial-filters" data-article-filters><label>Поиск<input type="search" name="search" placeholder="Название или вопрос" /></label><label>Тема<select name="category"><option value="">Все темы</option>{categories.map((topic) => <option value={topic.slug}>{topic.name}</option>)}</select></label><label>Кластер<select name="cluster"><option value="">Все кластеры</option>{clusters.map((cluster) => <option value={cluster}>{cluster}</option>)}</select></label><label>Сортировка<select name="sort"><option value="new">Сначала новые</option><option value="old">Сначала старые</option><option value="featured">Сначала избранные</option></select></label></form>
      <p class="result-count" data-result-count>Материалов: {articles.length}</p>
      <div class="library-results" data-article-results>
        {featuredArticle && <EditorialArticleRow article={featuredArticle} featured placement="articles_featured" />}
        {supportingArticles.map((article, index) => <EditorialArticleRow article={article} rank={index + 1} placement="articles_catalog" />)}
      </div>
    </div></section>
  </article>
</BaseLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('[data-article-filters]');
  const results = document.querySelector<HTMLElement>('[data-article-results]');
  const counter = document.querySelector<HTMLElement>('[data-result-count]');
  if (form && results && counter) {
    const cards = [...results.querySelectorAll<HTMLElement>('[data-article-card]')];
    const aliases = new Map([['sales', 'Продажи'], ['prodazhi', 'Продажи'], ['assortiment-i-zakupki', 'Ассортимент и закупки'], ['assortiment-zakupki', 'Товар'], ['tovar', 'Товар'], ['klienty', 'Клиенты'], ['pokupatel', 'Покупатель'], ['komanda', 'Команда'], ['personal', 'Персонал'], ['upravlenie-i-processy', 'Управление'], ['upravlenie', 'Управление'], ['ii-i-avtomatizaciya', 'ИИ и автоматизация'], ['ai-avtomatizatsiya', 'ИИ и автоматизация']]);
    const apply = () => {
      const values = new FormData(form);
      const search = String(values.get('search') || '').trim().toLocaleLowerCase('ru');
      const category = String(values.get('category') || '');
      const cluster = String(values.get('cluster') || '');
      const sort = String(values.get('sort') || 'new');
      const ordered = [...cards].sort((a, b) => sort === 'old' ? Number(a.dataset.timestamp) - Number(b.dataset.timestamp) : sort === 'featured' ? Number(b.dataset.featured) - Number(a.dataset.featured) : Number(b.dataset.timestamp) - Number(a.dataset.timestamp));
      ordered.forEach((card) => results.append(card));
      let visible = 0;
      cards.forEach((card) => {
        const matchSearch = !search || (card.dataset.search || '').includes(search);
        const matchCategory = !category || (card.dataset.category || '') === category || aliases.get(category) === card.dataset.category;
        const matchCluster = !cluster || card.dataset.cluster === cluster;
        const show = matchSearch && matchCategory && matchCluster;
        card.hidden = !show;
        if (show) visible += 1;
      });
      counter.textContent = 'Материалов: ' + visible;
    };
    form.addEventListener('input', apply);
    form.addEventListener('change', apply);
    const initial = new URLSearchParams(window.location.search).get('category');
    if (initial) { const select = form.elements.namedItem('category'); if (select instanceof HTMLSelectElement) select.value = initial; }
    apply();
  }
</script>
<style>
  .library-route{background:#fff;color:var(--c-graphite)}.library-route__top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:1rem}.library-route__intro{padding:clamp(3rem,7vw,6rem) 0;background:var(--c-paper)}.library-route__intro h1{max-width:900px;margin:.45rem 0 1rem;font-size:clamp(3.2rem,6.4vw,6.5rem);line-height:.9;letter-spacing:-.05em}.library-route__intro h1 em{color:var(--c-orange);font-style:normal}.library-route__intro p:last-child{max-width:570px;margin:0;color:#56616a;font-size:1.08rem;line-height:1.55}.library-route__map{padding:2rem 0;background:var(--c-paper)}.library-route__map .editorial-problem-map__rows{display:grid;grid-template-columns:repeat(7,1fr);border-left:1px solid var(--c-graphite)}.library-route__map .editorial-problem-map__row{grid-template-columns:1fr;grid-template-rows:auto 1fr 20px;gap:.5rem;min-height:136px;padding:.75rem;border-right:1px solid var(--c-graphite)}.library-route__map .editorial-problem-map__row>b{text-align:left}.library-route__desk{padding:clamp(3rem,7vw,7rem) 0}.editorial-filters{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:.8rem;align-items:end;margin-bottom:1.2rem}.editorial-filters label{display:grid;gap:.35rem;color:var(--c-muted);font-size:.68rem;font-weight:800;text-transform:uppercase}.editorial-filters input,.editorial-filters select{width:100%;min-height:42px;padding:.55rem .65rem;border:1px solid var(--c-graphite);border-radius:0;background:#fff;color:var(--c-graphite);font:inherit;font-size:.82rem;text-transform:none}.result-count{margin:0 0 1rem;color:var(--c-muted);font-size:.75rem}.library-results{border-top:1px solid var(--c-graphite)}.library-results .editorial-article-row{border-top:0;border-bottom:1px solid var(--c-graphite)}.library-results .editorial-article-row--featured{margin-bottom:1.8rem;border:0;border-top:3px solid var(--c-orange)}.library-results .editorial-article-row--featured+ .editorial-article-row{border-top:1px solid var(--c-graphite)}.library-results .editorial-article-row[hidden]{display:none}@media(max-width:900px){.editorial-filters{grid-template-columns:1fr 1fr}.library-route__map .editorial-problem-map__rows{grid-template-columns:repeat(4,1fr)}.library-route__map .editorial-problem-map__row:nth-child(n+5){border-top:1px solid var(--c-graphite)}}@media(max-width:700px){.library-route__top{align-items:start;flex-direction:column}.library-route__intro h1{font-size:clamp(3rem,12vw,4.3rem)}.library-route__map .editorial-problem-map__rows{grid-template-columns:repeat(2,1fr)}.library-route__map .editorial-problem-map__row:nth-child(n+3){border-top:1px solid var(--c-graphite)}.editorial-filters{grid-template-columns:1fr}.library-route__desk{padding-top:3.5rem}}
</style>
