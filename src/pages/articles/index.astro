---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Breadcrumbs from '../../components/Breadcrumbs.astro'; import ArticleCard from '../../components/ArticleCard.astro'; import { getPublishedArticles } from '../../lib/content'; import { categories } from '../../lib/site';
const articles=await getPublishedArticles(); const clusters=[...new Set(articles.map(({data})=>data.cluster))];
---
<BaseLayout title="Статьи и разборы — Розница в цифрах" description="Практические материалы о торговле, управлении, продажах, маркетинге и работе с ИИ."><section class="catalog" style="background:#f3f5f7"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Статьи'}]} /><header><p class="eyebrow">База знаний</p><h1>Статьи и разборы</h1><p class="catalog-lead">Практические материалы о торговле, управлении, продажах, маркетинге и работе с ИИ.</p></header><form class="filters" data-article-filters><label>Поиск<input type="search" name="search" placeholder="Название или тема" /></label><label>Категория<select name="category"><option value="">Все категории</option>{categories.map(({name,slug})=><option value={slug}>{name}</option>)}</select></label><label>Кластер<select name="cluster"><option value="">Все кластеры</option>{clusters.map((cluster)=><option value={cluster}>{cluster}</option>)}</select></label><label>Сортировка<select name="sort"><option value="new">Сначала новые</option><option value="old">Сначала старые</option><option value="featured">Сначала избранные</option></select></label></form><p class="result-count" data-result-count>{articles.length ? `Материалов: ${articles.length}` : 'Опубликованных материалов пока нет.'}</p><div class="article-grid" data-article-results>{articles.map((article,index)=><ArticleCard article={article} placement="articles_catalog" priority={index === 0} />)}</div></div></section></BaseLayout>
<script>
const form=document.querySelector<HTMLFormElement>('[data-article-filters]'); const results=document.querySelector<HTMLElement>('[data-article-results]'); const counter=document.querySelector<HTMLElement>('[data-result-count]');
if(form&&results&&counter){const cards=[...results.querySelectorAll<HTMLElement>('[data-article-card]')];const categoryNames=new Map([['prodazhi','Продажи'],['tovar','Товар'],['pokupatel','Покупатель'],['personal','Персонал'],['upravlenie','Управление'],['marketing','Маркетинг'],['ai-avtomatizatsiya','ИИ и автоматизация']]);const applyFilters=()=>{const values=Object.fromEntries(new FormData(form));const query=String(values.search||'').toLocaleLowerCase('ru');const category=categoryNames.get(String(values.category))||'';const cluster=String(values.cluster||'');const matches=cards.filter((card)=>(!query||(card.dataset.search||'').includes(query))&&(!category||card.dataset.category===category)&&(!cluster||card.dataset.cluster===cluster));cards.sort((a,b)=>values.sort==='old'?Number(a.dataset.timestamp)-Number(b.dataset.timestamp):values.sort==='featured'?Number(b.dataset.featured)-Number(a.dataset.featured)||Number(b.dataset.timestamp)-Number(a.dataset.timestamp):Number(b.dataset.timestamp)-Number(a.dataset.timestamp));cards.forEach((card)=>{card.hidden=!matches.includes(card);results.append(card)});counter.textContent=`Найдено: ${matches.length}`;const params=new URLSearchParams();if(values.category)params.set('category',String(values.category));if(values.cluster)params.set('cluster',String(values.cluster));if(values.search)params.set('search',String(values.search));if(values.sort&&values.sort!=='new')params.set('sort',String(values.sort));history.replaceState(null,'',`${location.pathname}${params.size?`?${params}`:''}`)};const params=new URLSearchParams(location.search);for(const name of ['category','cluster','search','sort']){const field=form.elements.namedItem(name);if(field instanceof HTMLInputElement||field instanceof HTMLSelectElement){const value=params.get(name);if(value!==null)field.value=value}}form.addEventListener('input',applyFilters);applyFilters()}
</script>
<style>.catalog{padding-block:var(--section);background:#f3f5f5}.catalog header{max-width:850px}.catalog h1{margin:.2rem 0 .7rem;font-size:clamp(2.4rem,5vw,4.2rem);line-height:1}.catalog-lead{max-width:720px;margin:0;color:#505b63;font-size:1.05rem;line-height:1.55}.filters{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:.75rem;margin:1.5rem 0}.filters label{display:grid;gap:.3rem;font-size:.78rem;font-weight:700}.filters input,.filters select{min-width:0;height:46px;padding:.65rem;border:1px solid var(--c-line);border-radius:var(--r-sm);background:#fff;font:inherit}.result-count{color:#646b72}.article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.pagination{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:2rem}.pagination a{display:grid;width:44px;height:44px;place-items:center;border:1px solid var(--c-line);border-radius:var(--r-sm);text-decoration:none}.pagination a[aria-current=page]{background:var(--c-blue);color:#fff}.search-card{overflow:hidden;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff;transition:border-color .2s,transform .2s}.search-card:hover{transform:translateY(-2px);border-color:#aeb8bf}.search-card>a{display:grid;height:100%;grid-template-rows:auto 1fr;color:inherit;text-decoration:none}.search-card>a:focus-visible{outline:3px solid var(--c-orange);outline-offset:-3px}.search-card__image{aspect-ratio:16/9;overflow:hidden;background:#edf1f4}.search-card__image img{width:100%;height:100%;object-fit:cover;object-position:center}.search-card__image--placeholder{display:grid;place-items:center;color:#7890a6}.search-card__image--placeholder i{font-size:2.3rem}.search-card__body{padding:.8rem .9rem .9rem}.search-card h3{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3;margin:.4rem 0 0;font-size:1.02rem;line-height:1.22}.search-meta{color:var(--c-blue);font-size:.75rem;font-weight:800}@media(max-width:1024px){.filters{grid-template-columns:1fr 1fr}.article-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:768px){.article-grid{grid-template-columns:1fr}}@media(max-width:430px){.filters{grid-template-columns:1fr}.catalog h1{font-size:2.45rem}}</style>
