---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../lib/content';
import { categories } from '../../lib/site';
const articles=await getPublishedArticles();
const clusters=[...new Set(articles.map(({data})=>data.cluster))];
---
<BaseLayout title="Библиотека «Докрути» — статьи и разборы" description="Практические материалы о продажах, клиентах, команде, управлении, маркетинге и автоматизации."><section class="catalog"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Библиотека'}]}/><header><p class="eyebrow">Библиотека</p><h1>Материалы для следующего шага</h1><p class="catalog-lead">Разборы рабочих ситуаций, в которых важно сначала найти причину, а потом выбирать действие.</p></header><form class="filters" data-article-filters><label>Поиск<input type="search" name="search" placeholder="Название или вопрос"/></label><label>Тема<select name="category"><option value="">Все темы</option>{categories.map((topic)=><option value={topic.slug}>{topic.name}</option>)}</select></label><label>Кластер<select name="cluster"><option value="">Все кластеры</option>{clusters.map((cluster)=><option value={cluster}>{cluster}</option>)}</select></label><label>Сортировка<select name="sort"><option value="new">Сначала новые</option><option value="old">Сначала старые</option><option value="featured">Сначала избранные</option></select></label></form><p class="result-count" data-result-count>Материалов: {articles.length}</p><div class="article-grid" data-article-results>{articles.map((article,index)=><ArticleCard article={article} placement="articles_catalog" priority={index===0}/>)}</div></div></section></BaseLayout>
<script>const form=document.querySelector<HTMLFormElement>('[data-article-filters]');const results=document.querySelector<HTMLElement>('[data-article-results]');const counter=document.querySelector<HTMLElement>('[data-result-count]');if(form&&results&&counter){const cards=[...results.querySelectorAll<HTMLElement>('[data-article-card]')];const aliases=new Map([['prodazhi','Продажи'],['assortiment-zakupki','Товар'],['tovar','Товар'],['klienty','Покупатель'],['pokupatel','Покупатель'],['komanda','Персонал'],['personal','Персонал'],['upravlenie','Управление'],['marketing','Маркетинг'],['ai-avtomatizatsiya','ИИ и автоматизация']]);const apply=()=>{const values=Object.fromEntries(new FormData(form));const query=String(values.search||'').toLocaleLowerCase('ru');const category=aliases.get(String(values.category))||'';const cluster=String(values.cluster||'');const matches=cards.filter((card)=>(!query||(card.dataset.search||'').includes(query))&&(!category||card.dataset.category===category)&&(!cluster||card.dataset.cluster===cluster));cards.sort((a,b)=>values.sort==='old'?Number(a.dataset.timestamp)-Number(b.dataset.timestamp):values.sort==='featured'?Number(b.dataset.featured)-Number(a.dataset.featured):Number(b.dataset.timestamp)-Number(a.dataset.timestamp));cards.forEach((card)=>{card.hidden=!matches.includes(card);results.append(card)});counter.textContent='Найдено: '+matches.length;const params=new URLSearchParams();if(values.category)params.set('category',String(values.category));if(values.cluster)params.set('cluster',String(values.cluster));if(values.search)params.set('search',String(values.search));if(values.sort&&values.sort!=='new')params.set('sort',String(values.sort));history.replaceState(null,'',location.pathname+(params.size?'?'+params:''))};const params=new URLSearchParams(location.search);for(const name of ['category','cluster','search','sort']){const field=form.elements.namedItem(name);const value=params.get(name);if(value!==null&&field instanceof HTMLInputElement||value!==null&&field instanceof HTMLSelectElement)field.value=value||''}form.addEventListener('input',apply);apply()}</script>
<style>.catalog{padding-block:var(--section);background:var(--c-paper)}.catalog header{max-width:780px}.catalog h1{margin:.3rem 0 .7rem;font-size:clamp(2.6rem,5vw,4.5rem);line-height:.96}.catalog-lead{max-width:650px;margin:0;color:#505b63;font-size:1rem;line-height:1.55}.filters{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:.75rem;margin:2rem 0 1rem}.filters label{display:grid;gap:.35rem;color:var(--c-muted);font-size:.75rem;font-weight:700}.filters input,.filters select{min-width:0;height:45px;padding:.6rem;border:1px solid var(--c-line);border-radius:0;background:#fff;color:var(--c-graphite);font:inherit}.result-count{color:var(--c-muted);font-size:.8rem}.article-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-top:1.2rem}@media(max-width:1024px){.filters{grid-template-columns:1fr 1fr}.article-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.filters{grid-template-columns:1fr}.article-grid{grid-template-columns:1fr}.catalog h1{font-size:2.7rem}}</style>
