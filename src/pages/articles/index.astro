---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorialArticleRow from '../../components/EditorialArticleRow.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getPublishedArticles } from '../../lib/content';
import { categories } from '../../lib/site';

const articles = await getPublishedArticles();
const featured = articles.find((item) => item.data.id === 'CNT-0026') ?? articles[0];
const remaining = articles.filter((item) => item.data.id !== featured?.data.id);
const initialBatch = 6;
---

<BaseLayout
  title="Библиотека Докрути — практические материалы для малого бизнеса"
  description="Разборы, статьи и рабочие материалы по реальным задачам бизнеса — от проблемы к проверке и следующему действию."
  image={featured?.data.cover}
>
  <article class="library-page">
    <header class="library-hero">
      <div class="library-hero__image" aria-hidden="true">
        <ResponsiveImage
          src="/images/home-hero-editorial-approved.png"
          alt=""
          width={2048}
          height={683}
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
          class="library-hero__photo"
        />
      </div>
      <div class="library-hero__wash" aria-hidden="true"></div>
      <div class="container library-hero__content">
        <p class="eyebrow">ПРАКТИЧЕСКИЕ МАТЕРИАЛЫ</p>
        <h1>Библиотека Докрути</h1>
        <p class="library-hero__lead">Разборы, статьи и рабочие материалы по реальным задачам бизнеса — от проблемы к проверке и следующему действию.</p>
      </div>
    </header>

    <section class="container library-content" aria-label="Материалы библиотеки">
      <nav class="topic-filters" aria-label="Темы материалов" data-topic-filters>
        <a href="/articles/" data-topic-filter="" aria-current="page">Все темы</a>
        {categories.map((item) => (
          <a
            href={'/articles/?topic=' + item.slug}
            data-topic-filter={item.slug}
            data-analytics-event="topic_click"
            data-analytics-topic={item.slug}
          >
            {item.name}
          </a>
        ))}
      </nav>

      <div class="library-list-heading">
        <h2>Материалы</h2>
        <button class="load-more" type="button" data-load-more hidden aria-controls="library-results">Показать ещё</button>
      </div>
      <p class="library-empty" data-empty hidden>По этому фильтру пока нет опубликованных материалов.</p>
      <div class="library-results" id="library-results" data-results>
        {featured && <EditorialArticleRow article={featured} featured showIndex={false} placement="library_feature" imageSizes="(max-width: 700px) 100vw, 40vw" />}
        {remaining.map((item, index) => (
          <EditorialArticleRow
            article={item}
            rank={index}
            showIndex={false}
            initiallyHidden={index >= initialBatch}
            placement="library_list"
            imageSizes="(max-width: 700px) 84px, 112px"
          />
        ))}
      </div>
      <div class="load-more-bottom">
        <button class="load-more" type="button" data-load-more hidden aria-controls="library-results">Показать ещё</button>
      </div>
    </section>
  </article>
</BaseLayout>

<script>
  const initialBatch = 6;
  const aliases: Record<string, string> = {
    prodazhi: 'sales',
    'assortiment-zakupki': 'assortiment-i-zakupki',
    pokupatel: 'klienty',
    personal: 'komanda',
    upravlenie: 'upravlenie-i-processy',
    'ai-avtomatizatsiya': 'ii-i-avtomatizaciya',
  };
  const cards = [...document.querySelectorAll<HTMLElement>('[data-article-card]')];
  const featuredCard = cards.find((card) => card.classList.contains('editorial-article-row--featured'));
  const empty = document.querySelector<HTMLElement>('[data-empty]');
  const loadMoreButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-load-more]')];
  let visibleCount = initialBatch;

  const update = () => {
    const url = new URL(location.href);
    const rawTopic = url.searchParams.get('topic') || url.searchParams.get('category') || '';
    const topic = aliases[rawTopic] || rawTopic;
    const remainingCards = cards.filter((card) => card !== featuredCard);
    const matching = remainingCards.filter((card) => !topic || card.dataset.topic === topic);
    const featuredMatches = !!featuredCard && (!topic || featuredCard.dataset.topic === topic);
    let shown = 0;

    if (featuredCard) {
      featuredCard.hidden = !featuredMatches;
      if (featuredMatches) shown += 1;
    }
    let matchedIndex = 0;
    remainingCards.forEach((card) => {
      const cardMatches = !topic || card.dataset.topic === topic;
      card.hidden = !cardMatches || matchedIndex >= visibleCount;
      if (cardMatches) matchedIndex += 1;
      if (!card.hidden) shown += 1;
    });

    if (empty) empty.hidden = shown > 0;
    const hasMore = matching.length > visibleCount;
    loadMoreButtons.forEach((button) => { button.hidden = !hasMore; });
    document.querySelectorAll<HTMLAnchorElement>('[data-topic-filter]').forEach((link) => {
      const selected = link.dataset.topicFilter === topic;
      if (selected) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
    const robots = document.querySelector<HTMLMetaElement>('meta[name=robots]');
    if (robots && !robots.content.includes('nofollow')) {
      robots.content = url.search ? 'noindex,follow' : 'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1';
    }
  };

  document.querySelectorAll<HTMLAnchorElement>('[data-topic-filter]').forEach((link) => {
    link.addEventListener('click', (event) => {
      event.preventDefault();
      const url = new URL(location.href);
      const topic = link.dataset.topicFilter || '';
      if (topic) url.searchParams.set('topic', topic);
      else url.searchParams.delete('topic');
      url.searchParams.delete('category');
      url.searchParams.delete('content_type');
      history.pushState(null, '', url);
      visibleCount = initialBatch;
      update();
    });
  });

  loadMoreButtons.forEach((button) => button.addEventListener('click', () => {
    visibleCount += initialBatch;
    update();
  }));
  addEventListener('popstate', () => { visibleCount = initialBatch; update(); });
  update();
</script>

<style>
  .library-page{background:#fff;color:#25292c}
  .library-hero{position:relative;isolation:isolate;min-height:390px;overflow:hidden;background:#f4f5f6}
  .library-hero__image,.library-hero__image picture,.library-hero__image img{position:absolute;inset:0;display:block;width:100%;height:100%}
  .library-hero__image img{object-fit:cover;object-position:68% 54%}
  .library-hero__wash{position:absolute;z-index:1;inset:0;background:linear-gradient(90deg,rgba(244,245,246,.98) 0%,rgba(244,245,246,.94) 29%,rgba(244,245,246,.65) 43%,rgba(244,245,246,.08) 63%,transparent 77%);pointer-events:none}
  .library-hero__content{position:relative;z-index:2;display:flex;min-height:390px;flex-direction:column;justify-content:center;padding-block:42px}
  .library-hero__content .eyebrow{margin:0 0 13px;color:#c64b2c;font-size:12px;font-weight:700;letter-spacing:.11em}
  .library-hero h1{max-width:750px;margin:0;color:#191919;font:600 clamp(48px,6.1vw,82px)/.96 var(--font-editorial);letter-spacing:-.045em}
  .library-hero__lead{max-width:660px;margin:19px 0 0;color:#34383a;font-size:17px;line-height:1.5}

  .library-content{padding-top:25px;padding-bottom:70px}
  .topic-filters{display:flex;flex-wrap:nowrap;gap:clamp(5px,.65vw,8px);margin:0 0 27px;padding:0 0 4px;overflow-x:auto;overscroll-behavior-x:contain;scrollbar-width:thin;white-space:nowrap}
  .topic-filters a{display:inline-flex;min-height:44px;flex:0 0 auto;align-items:center;padding:8px clamp(9px,.8vw,12px);border:1px solid #d0d4d7;border-radius:999px;color:#34383a;font-size:clamp(10px,.78vw,12px);font-weight:600;text-decoration:none;white-space:nowrap;transition:background-color .16s ease,border-color .16s ease,color .16s ease}
  .topic-filters a:hover,.topic-filters a:focus-visible{border-color:#d9562f;outline:none}
  .topic-filters a[aria-current=page]{border-color:#17130f;background:#17130f;color:#fff}
  .library-list-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin:0 0 13px}
  .library-list-heading h2{margin:0;font:600 clamp(27px,3vw,38px)/1.08 var(--font-editorial);letter-spacing:-.025em}
  .load-more{display:inline-flex;min-height:44px;align-items:center;justify-content:center;padding:9px 15px;border:1px solid #c94f30;border-radius:999px;background:#fff;color:#a43d24;font-size:12px;font-weight:700;cursor:pointer}
  .load-more:hover,.load-more:focus-visible{background:#fff2ed;outline:2px solid #c94f30;outline-offset:2px}
  .load-more[hidden]{display:none}
  .library-empty{margin:0 0 20px;color:#596065;font-size:14px}
  .library-results{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 18px}
  .library-results :global(.editorial-article-row){min-width:0;border:1px solid #e1e4e6;background:#fff}
  .library-results :global(.editorial-article-row[hidden]){display:none!important}
  .library-results :global(.editorial-article-row--featured){grid-column:1/-1;border:0;background:#f4f5f6}
  .library-results :global(.editorial-article-row .editorial-article-row__link){grid-template-columns:112px minmax(0,1fr) 18px!important;gap:13px;min-height:120px;padding:9px}
  .library-results :global(.editorial-article-row__image){min-width:0;width:100%;min-height:100px;aspect-ratio:16/10}
  .library-results :global(.editorial-article-row__body){gap:6px;padding:4px 0}
  .library-results :global(.editorial-article-row__body>strong){font-size:16px;line-height:1.16}
  .library-results :global(.editorial-article-row__meta){gap:7px;font-size:10px}
  .library-results :global(.editorial-article-row__description){display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;font-size:11px;line-height:1.4}
  .library-results :global(.editorial-article-row--featured .editorial-article-row__link){grid-template-columns:minmax(240px,.9fr) minmax(0,1.1fr) 20px!important;min-height:250px;padding:0}
  .library-results :global(.editorial-article-row--featured .editorial-article-row__image){min-width:0;height:250px;aspect-ratio:auto}
  .library-results :global(.editorial-article-row--featured .editorial-article-row__body){padding:20px 10px}
  .library-results :global(.editorial-article-row--featured .editorial-article-row__body>strong){font-size:clamp(26px,3vw,40px);line-height:1.02}
  .library-results :global(.editorial-article-row--featured .editorial-article-row__description){display:block;font-size:13px}
  .library-results :global(.editorial-article-row__arrow){padding-right:9px}
  .load-more-bottom{display:flex;justify-content:center;margin-top:22px}

  @media(max-width:1000px){
    .library-hero{min-height:350px}
    .library-hero__content{min-height:350px}
    .library-results{gap:9px 12px}
    .library-results :global(.editorial-article-row .editorial-article-row__link){grid-template-columns:90px minmax(0,1fr) 16px!important;gap:10px}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__link){grid-template-columns:minmax(190px,.9fr) minmax(0,1.1fr) 18px!important;min-height:220px}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__image){height:220px}
  }
  @media(max-width:700px){
    .library-hero{min-height:0;padding-bottom:0}
    .library-hero__image{top:auto;height:auto;aspect-ratio:3/1}
    .library-hero__image img{object-fit:contain;object-position:center}
    .library-hero__wash{background:linear-gradient(180deg,#f4f5f6 0%,rgba(244,245,246,.98) 49%,rgba(244,245,246,.8) 68%,rgba(244,245,246,.12) 100%)}
    .library-hero__content{min-height:360px;justify-content:flex-start;padding-block:30px 125px}
    .library-hero__content .eyebrow{margin-bottom:10px;font-size:10px}
    .library-hero h1{max-width:360px;font-size:clamp(43px,11.7vw,54px);line-height:.98}
    .library-hero__lead{max-width:520px;margin-top:13px;font-size:14px;line-height:1.45}
    .library-content{padding-top:17px;padding-bottom:45px}
    .topic-filters{gap:7px;margin:0 -16px 21px;padding:0 16px 8px;scroll-snap-type:x proximity}
    .topic-filters a{min-height:42px;padding:8px 12px;font-size:11px;scroll-snap-align:start}
    .library-list-heading{margin-bottom:11px}
    .library-list-heading h2{font-size:29px}
    .library-list-heading .load-more{min-height:40px;padding:8px 12px;font-size:11px}
    .library-results{grid-template-columns:1fr;gap:8px}
    .library-results :global(.editorial-article-row .editorial-article-row__link){grid-template-columns:minmax(0,1fr) 84px 16px!important;gap:10px;min-height:106px;padding:8px}
    .library-results :global(.editorial-article-row__image){grid-column:2;grid-row:1;min-width:0;width:100%;min-height:88px;aspect-ratio:4/3}
    .library-results :global(.editorial-article-row__body){grid-column:1;grid-row:1;padding:3px 0}
    .library-results :global(.editorial-article-row__body>strong){font-size:14px}
    .library-results :global(.editorial-article-row__description){display:none}
    .library-results :global(.editorial-article-row__meta){font-size:9px}
    .library-results :global(.editorial-article-row__arrow){grid-column:3;grid-row:1;padding:0}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__link){grid-template-columns:minmax(0,1fr) 18px!important;grid-template-rows:155px auto;min-height:0;padding:0}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__image){grid-column:1/3;grid-row:1;height:155px;aspect-ratio:auto}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__body){grid-column:1;grid-row:2;padding:12px 14px 14px}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__body>strong){font-size:26px}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__description){display:block;font-size:11px}
    .library-results :global(.editorial-article-row--featured .editorial-article-row__arrow){grid-column:2;grid-row:2;align-self:end;padding:0 8px 15px 0}
    .load-more-bottom{margin-top:16px}
  }
  @media(prefers-reduced-motion:reduce){.topic-filters a{transition:none}}
</style>
