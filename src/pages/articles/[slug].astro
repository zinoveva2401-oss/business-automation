---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import ArticleFunctionalBlocks from '../../components/ArticleFunctionalBlocks.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticleTableOfContents from '../../components/ArticleTableOfContents.astro';
import Cnt0027Editorial from '../../components/Cnt0027Editorial.astro';
import { getCollection, render } from 'astro:content';
import { categoryByName } from '../../lib/site';
export async function getStaticPaths(){return(await getCollection('articles')).filter(({data})=>!data.draft).map((entry)=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props;const {Content,headings}=await render(entry);const toc=headings.filter(({depth})=>depth===2);const allArticles=(await getCollection('articles')).filter(({data})=>!data.draft);const allProducts=await getCollection('tools');const relatedArticles=allArticles.filter(({data})=>entry.data.relatedArticleIds.includes(data.id));const relatedProducts=allProducts.filter(({data})=>entry.data.relatedProductIds.includes(data.id)&&data.status==='published'&&data.purchaseStatus==='active'&&data.purchaseUrl);const category=categoryByName.get(entry.data.category);const pageUrl=Astro.url.href;const isCnt0027=entry.data.id==='CNT-0027';const schema={'@context':'https://schema.org','@graph':[{'@type':'Article',headline:entry.data.title,description:entry.data.description,datePublished:entry.data.publishedAt.toISOString(),dateModified:(entry.data.updatedAt||entry.data.publishedAt).toISOString(),mainEntityOfPage:pageUrl,author:{'@type':'Person',name:entry.data.author,url:new URL('/about/',Astro.url).href},image:entry.data.ogImage||entry.data.cover},{'@type':'Person',name:entry.data.author,url:new URL('/about/',Astro.url).href},{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Главная',item:new URL('/',Astro.url).href},{'@type':'ListItem',position:2,name:'Статьи',item:new URL('/articles/',Astro.url).href},{'@type':'ListItem',position:3,name:entry.data.title,item:pageUrl}]}]};
---
<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} image={entry.data.ogImage||entry.data.cover} type="article" canonicalUrl={entry.data.canonicalUrl} schema={schema}>
<article class="article-page" style="background:#f3f5f7" data-analytics-view="view_article" data-analytics-content-id={entry.data.id} data-analytics-content-type="article" data-analytics-category={entry.data.category} data-analytics-cluster={entry.data.cluster}><div class="container article-container">
<Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Статьи',href:'/articles/'},{name:entry.data.title}]} />
{isCnt0027 ? <Cnt0027Editorial /> : <>
<ArticleHero category={entry.data.category} cluster={entry.data.cluster} title={entry.data.title} lead={entry.data.description} categoryHref={`/articles/?category=${category?.slug}`} />
{entry.data.cover&&<img class="cover" src={entry.data.cover} alt={entry.data.coverAlt||''} width="1200" height="675" loading="eager" />}
<ArticleTableOfContents headings={toc} />
{entry.data.id!=='CNT-0024'&&<ArticleFunctionalBlocks articleId={entry.data.id} />}<div class="prose"><Content /></div>
</>}
{relatedProducts.length>0&&<aside class="related"><h2>Связанный инструмент</h2><div class="product-grid">{relatedProducts.map((product)=><ProductCard product={product} placement="article_related" />)}</div></aside>}{relatedArticles.length>0&&<aside class="related"><h2>Продолжить чтение</h2><div class="article-grid">{relatedArticles.map((article)=><ArticleCard article={article} placement="article_related" />)}</div></aside>}
</div></article><script>if(matchMedia('(max-width:700px)').matches){document.querySelectorAll('.article-toc').forEach((toc)=>toc.removeAttribute('open'))}</script></BaseLayout>
<style>.article-page{padding-block:var(--section)}.article-container{max-width:900px}.article-page header>a{color:#07499c;font-weight:700;text-decoration:none}.article-page h1{max-width:20ch;margin:.5rem 0 1rem;font-size:clamp(2.25rem,4.1vw,3.55rem);line-height:1.04}.article-page header>p{font-size:1.15rem;line-height:1.55}.meta{display:flex;flex-wrap:wrap;gap:.5rem 1rem;color:#687078;font-size:.82rem}.meta a{color:inherit}.cover{width:100%;max-height:520px;margin:2rem 0;border-radius:var(--r-md);object-fit:cover}.article-toc{margin:2rem 0;padding:1rem 1.2rem;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff}.article-toc summary{font-weight:800;cursor:pointer}.article-toc ol{display:grid;gap:.45rem;margin:.8rem 0 0;padding-left:1.3rem}.article-toc a{color:#33404a;text-decoration-thickness:1px;text-underline-offset:3px}.prose{font-size:1.0625rem;line-height:1.72}.prose :global(p),.prose :global(li){max-width:72ch}.prose :global(h2){margin-top:2.8rem;padding-top:.4rem;font-size:1.8rem}.prose :global(h3){margin-top:2rem;font-size:1.35rem}.prose :global(blockquote){margin:1.6rem 0;padding:1rem 1.2rem;border-left:4px solid var(--c-orange);background:#e9eef2}.prose :global(blockquote p){margin:.3rem 0;font-size:1.08rem}.prose :global(ul),.prose :global(ol){display:grid;gap:.45rem;padding-left:1.4rem}.prose :global(table){width:100%;margin:1.5rem 0;border-collapse:collapse;background:#fff}.prose :global(th),.prose :global(td){padding:.8rem;border:1px solid var(--c-line);text-align:left;vertical-align:top}.prose :global(th){background:#e9eef2}.diagnostic-bridge{margin-top:3rem;padding:1.4rem;border-left:5px solid var(--c-orange);background:var(--c-ink);color:#fff}.diagnostic-bridge>p:first-child{margin:0 0 .45rem;color:#9db9dc;font-weight:800;text-transform:uppercase}.diagnostic-bridge h2{margin:.2rem 0 .65rem;font-size:1.75rem}.diagnostic-bridge a{display:inline-flex;min-height:44px;align-items:center;margin-top:.4rem;padding:.65rem 1rem;border-radius:var(--r-sm);background:var(--c-orange);color:#fff;font-weight:700;text-decoration:none}.diagnostic-bridge a:hover{background:#e75f00}.diagnostic-bridge h2{margin:.2rem 0 .65rem;font-size:1.75rem}.article-grid,.product-grid{grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:3rem}.article-grid{grid-template-columns:repeat(2,1fr);gap:1rem}.article-grid{grid-template-columns:1fr}
.scene--ab{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1rem,2vw,1.5rem);margin:2rem 0}.scene--ab>div{padding:1.25rem;border-radius:var(--r-sm);border-top:4px solid var(--c-line)}.scene--ab h3{margin:.25rem 0 .5rem;font-size:1.2rem;font-family:var(--font-editorial)}.scene--ab p{margin:.15rem 0;font-size:.95rem;line-height:1.5}.impulses{margin:1.25rem 0;padding-left:1.25rem;border-left:2px solid #c8d3df}.impulses p{margin:.4rem 0}.three-lines>div{display:flex;gap:1rem;align-items:start;padding:.75rem 0;border-bottom:1px solid var(--c-line)}.three-lines span{font:800 1.1rem var(--font-editorial);color:var(--c-orange);flex-shrink:0;min-width:2.5rem}.three-lines div>strong{display:block}.three-lines div>span{font-size:.95rem;line-height:1.5;color:var(--c-coal);display:block;margin-top:.25rem}.causal-path{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:.5rem 1rem;margin:1.5rem 0;font-size:1.0625rem;font-weight:600;color:var(--c-ink)}.causal-path .causal-arrow{color:var(--c-orange);font-weight:700}.product-bridge-light{border-left:3px solid var(--c-orange);background:#fff;padding:.75rem 1rem;margin:1.25rem 0;border-radius:0 var(--r-md) var(--r-md) 0}.product-bridge-light p{color:var(--c-coal);font-size:1rem;line-height:1.6;margin-bottom:.5rem}:global(.ai-role-grid){display:grid;gap:1rem}@media(max-width:390px){:global(.ai-role-grid){grid-template-columns:1fr!important}}@media(max-width:700px){.article-page{padding-top:1.4rem}.article-page h1{max-width:none;font-size:clamp(2rem,9vw,2.55rem)}.article-page header>p,.prose{font-size:1rem}.article-toc{margin:1.4rem 0;padding:.85rem 1rem}.prose :global(h2){margin-top:2.25rem;font-size:1.6rem;line-height:1.15}.prose :global(h3){margin-top:1.65rem;font-size:1.25rem}.prose :global(p),.prose :global(li){line-height:1.65}.prose :global(table),.prose :global(tbody),.prose :global(tr),.prose :global(td){display:block}.prose :global(thead){position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.prose :global(tr){margin:.8rem 0;border:1px solid var(--c-line);border-radius:var(--r-sm);background:#fff}.prose :global(td){border:0;border-bottom:1px solid var(--c-line)}.prose :global(td:last-child){border-bottom:0}.diagnostic-bridge{padding:1.1rem}.diagnostic-bridge h2{font-size:1.45rem}.article-grid,.product-grid{grid-template-columns:1fr}.scene--ab{grid-template-columns:1fr}.three-lines>div{flex-direction:column;gap:.5rem}.causal-path{flex-direction:column;gap:.25rem}.causal-path .causal-arrow{transform:rotate(90deg)}}</style>
