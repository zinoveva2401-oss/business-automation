---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import EditorialFolio from '../../components/EditorialFolio.astro';
import EditorialArticleRow from '../../components/EditorialArticleRow.astro';
import { render } from 'astro:content';
import { getPublishedArticles } from '../../lib/content';
import { categoryByName } from '../../lib/site';
export async function getStaticPaths(){return (await getPublishedArticles()).map((entry)=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props; const {Content,headings}=await render(entry); const all=await getPublishedArticles(); const related=all.filter((item)=>entry.data.relatedArticleIds.includes(item.data.id)); const topic=categoryByName.get(entry.data.category); const image=entry.data.ogImage||entry.data.cover; const published=entry.data.publishedAt; const schema={'@context':'https://schema.org','@type':'Article',headline:entry.data.title,description:entry.data.description,author:{'@type':'Person',name:entry.data.author,url:new URL('/about/',Astro.url).href},...(published?{datePublished:published.toISOString(),dateModified:(entry.data.updatedAt||published).toISOString()}:{}),...(image?{image:new URL(image,Astro.url).href}:{}),mainEntityOfPage:Astro.url.href};
---
<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} image={image} type="article" schema={schema}>
  <article class="article-route" data-analytics-content-id={entry.data.id} data-analytics-content-type={entry.data.content_type} data-analytics-topic={topic?.slug}>
    <div class="container article-route__top"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Библиотека',href:'/articles/'},{name:entry.data.title}]} /><EditorialFolio number="04" label="Article" /></div>
    <header class="container article-route__hero">
      <aside><p class="eyebrow">Одна статья — одна рабочая проверка.</p><p>{topic?.name ?? entry.data.category}</p><p class="article-route__aside-note">Факт → причина → проверка → действие</p></aside>
      <div class="article-route__copy"><p class="eyebrow">{entry.data.content_type} · {topic?.name ?? entry.data.category}</p><h1>{entry.data.title}</h1><p class="article-route__description">{entry.data.description}</p><div class="article-route__meta"><span>{entry.data.author}</span>{published&&<time datetime={published.toISOString()}>{published.toLocaleDateString('ru-RU')}</time>}</div></div>
      {image&&<figure class="article-route__image"><ResponsiveImage src={image} alt={entry.data.coverAlt||''} width={1200} height={800} loading="eager" fetchpriority="high" sizes="(max-width: 700px) 100vw, 42vw" /></figure>}
    </header>
    <div class="container article-reading-grid">
      <aside class="article-route__rail"><EditorialFolio number="04" label="Reading" />{headings.filter((heading)=>heading.depth===2).length>=5&&<details class="article-toc"><summary>В этом материале</summary><ol>{headings.filter((heading)=>heading.depth===2).map((heading)=><li><a href={'#'+heading.slug}>{heading.text}</a></li>)}</ol></details>}</aside>
      <div class="prose"><Content /></div>
    </div>
    <section class="article-next"><div><p class="eyebrow">Следующий шаг</p><h2>Вопрос по вашей ситуации?</h2></div><div><p>Коротко опишите факты и уже сделанные шаги.</p><button class="button button--primary" type="button" data-open-sheet="ask" data-analytics-event="contact_open" data-analytics-placement="article_next_step">Задать вопрос ↗</button></div></section>
    {related.length>0&&<section class="container article-related"><div class="route-screen__title"><div><EditorialFolio number="03" label="Next reading" /><h2>Следующий материал.</h2></div><a class="route-link" href="/articles/">Вся библиотека <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div><div>{related.map((item,index)=><EditorialArticleRow article={item} rank={index} placement="article_related" />)}</div></section>}
  </article>
</BaseLayout>
<style>
  .article-route{background:#fff;color:var(--c-graphite);padding-bottom:0}.article-route__top{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding-top:1rem}.article-route__hero{display:grid;grid-template-columns:180px minmax(0,1fr) minmax(300px,.78fr);gap:clamp(1.5rem,4vw,4rem);align-items:stretch;padding-top:clamp(3rem,7vw,6rem);padding-bottom:clamp(3rem,7vw,6rem)}.article-route__hero>aside{border-top:2px solid var(--c-orange);padding-top:.8rem;color:#56616a;font-size:.8rem}.article-route__hero>aside p{margin:0 0 .8rem}.article-route__aside-note{color:var(--c-orange);font-size:.7rem;font-weight:800}.article-route__copy{align-self:center}.article-route__copy h1{max-width:760px;margin:.5rem 0 1rem;font-size:clamp(3rem,5.4vw,6rem);line-height:.91;letter-spacing:-.05em}.article-route__description{max-width:650px;color:#56616a;font-size:1.05rem;line-height:1.55}.article-route__meta{display:flex;flex-wrap:wrap;gap:1rem;margin-top:1.4rem;color:var(--c-muted);font-size:.75rem}.article-route__image{position:relative;margin:0;border-top:3px solid var(--c-orange);background:#dfe5e9}.article-route__image img{height:100%;min-height:360px;object-fit:cover}.article-route__image figcaption{position:absolute;left:.7rem;bottom:.7rem;padding:.32rem .45rem;background:#17130fcc;color:#fff;font-size:.66rem}.article-reading-grid{display:grid;grid-template-columns:220px minmax(0,780px);gap:clamp(2rem,8vw,8rem);align-items:start;padding-bottom:clamp(4rem,8vw,8rem)}.article-route__rail{position:sticky;top:1.5rem;border-top:1px solid var(--c-graphite);padding-top:.8rem;color:#56616a;font-size:.8rem}.article-route__rail>.editorial-folio{margin-bottom:1rem}.article-route__rail p{line-height:1.45}.article-route__rail>ol{display:grid;gap:.35rem;margin:1rem 0;padding:0;list-style:none;color:var(--c-graphite);font-size:.75rem}.article-route__rail>ol li{padding:.35rem 0;border-bottom:1px solid var(--c-line)}.article-route__rail>ol li::before{margin-right:.5rem;color:var(--c-orange);content:'→'}.article-toc{margin-top:1.5rem;padding:1rem 0;border-top:1px solid var(--c-graphite);border-bottom:1px solid var(--c-graphite)}.article-toc summary{font-weight:800;cursor:pointer}.article-toc ol{display:grid;gap:.45rem;margin:.8rem 0 0;padding-left:1.1rem}.article-toc a{color:inherit;font-size:.75rem}.article-route .prose{max-width:none;margin:0;font-size:1.05rem;line-height:1.78}.article-route .prose h2{margin-top:3.5rem;font-size:clamp(1.9rem,3.2vw,3rem);line-height:1}.article-route .prose h3{margin-top:2.4rem}.article-route .prose blockquote,.article-route .prose table{background:var(--c-paper)}.article-route .prose table{display:block;max-width:100%;overflow-x:auto}.article-next{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);padding:clamp(3.5rem,7vw,6rem) max(var(--gutter),calc((100vw - var(--page)) / 2));background:var(--c-navy);color:#fff}.article-next h2{margin:.4rem 0;font-size:clamp(2.3rem,4.2vw,4.2rem);line-height:.94}.article-next p:not(.eyebrow){max-width:470px;color:#e2e8ef;line-height:1.55}.article-next .button{margin-top:.7rem}.article-related{padding-top:clamp(4rem,8vw,7rem);padding-bottom:clamp(4rem,8vw,7rem)}.article-related .route-screen__title{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-bottom:1.5rem}.article-related .route-screen__title h2{margin:.5rem 0 0;font-size:clamp(2.4rem,4.5vw,4.5rem);line-height:.94}.article-related .route-link{white-space:nowrap}@media(max-width:900px){.article-route__hero{grid-template-columns:120px minmax(0,1fr)}.article-route__image{grid-column:2}.article-reading-grid{grid-template-columns:170px minmax(0,1fr);gap:2rem}}@media(max-width:700px){.article-route__top{align-items:start;flex-direction:column}.article-route__hero{display:flex;flex-direction:column;padding-top:3rem}.article-route__hero>aside{order:2}.article-route__copy h1{font-size:clamp(2.3rem,10vw,4.2rem)}.article-route__image{order:1}.article-route__image img{min-height:250px}.article-route__hero>aside{order:3}.article-reading-grid{display:block;padding-bottom:3.5rem}.article-route__rail{position:static;margin-bottom:2rem}.article-route .prose{font-size:1rem}.article-next{grid-template-columns:1fr;padding-inline:var(--gutter);gap:1rem}.article-related{padding-top:3.5rem;padding-bottom:3.5rem}.article-related .route-screen__title{align-items:start;flex-direction:column;gap:.5rem}}
</style>
<style is:global>.article-route .prose table{display:block;max-width:100%;overflow-x:auto}</style>
