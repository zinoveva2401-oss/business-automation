---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHero from '../../components/ArticleHero.astro';
import ArticlePresentation from '../../components/ArticlePresentation.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { render } from 'astro:content';
import { getPublishedArticles } from '../../lib/content';
import { categoryByName } from '../../lib/site';

export async function getStaticPaths() {
  return (await getPublishedArticles()).map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const all = await getPublishedArticles();
const related = all.filter((item) => entry.data.relatedArticleIds.includes(item.data.id)).slice(0, 3);
const topic = categoryByName.get(entry.data.category);
const cover = entry.data.cover || entry.data.ogImage;
const image = entry.data.ogImage || cover;
const published = entry.data.publishedAt;
const articleHeadings = headings.filter((heading) => heading.depth === 2);
const presentationMap = entry.data.presentationMap;
const publicHeadings = articleHeadings.filter((heading) => !presentationMap.some((item) => item.heading === heading.text && item.hideHeading));
const mappedHeadings = new Set(presentationMap.map((item) => item.heading));
const missingPresentation = articleHeadings.filter((heading) => !mappedHeadings.has(heading.text));
const stalePresentation = presentationMap.filter((item) => !articleHeadings.some((heading) => heading.text === item.heading));

if (missingPresentation.length || stalePresentation.length) {
  throw new Error(`Article presentation map mismatch for ${entry.data.id}: missing=${missingPresentation.map((item) => item.text).join('|')}; stale=${stalePresentation.map((item) => item.heading).join('|')}`);
}

const breadcrumbs = [
  { name: 'Главная', href: '/' },
  { name: 'Библиотека', href: '/articles/' },
  { name: entry.data.title },
];
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  author: { '@type': 'Person', name: entry.data.author, url: new URL('/about/', Astro.url).href },
  ...(published ? { datePublished: published.toISOString(), dateModified: (entry.data.updatedAt || published).toISOString() } : {}),
  ...(image ? { image: new URL(image, Astro.url).href } : {}),
  mainEntityOfPage: Astro.url.href,
};
---

<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} image={image} type="article" schema={schema}>
  <article class="article-route" data-analytics-content-id={entry.data.slug} data-analytics-content-type={entry.data.content_type} data-analytics-topic={topic?.slug}>
    <ArticleHero
      category={topic?.name ?? entry.data.category}
      categoryHref={topic ? `/articles/?topic=${topic.slug}` : '/articles/'}
      title={entry.data.title}
      lead={entry.data.description}
      image={cover}
      imageAlt={entry.data.coverAlt || ''}
      breadcrumbs={breadcrumbs}
    />

    <div class="article-reading-shell">
      <div class="article-reading-main">
        {publicHeadings.length > 1 && <details class="article-toc article-toc--compact">
          <summary>В этой статье</summary>
          <ol>{publicHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
        </details>}
        <div class="article-prose prose">
          <ArticlePresentation headings={articleHeadings} presentationMap={presentationMap}>
            <Content />
          </ArticlePresentation>
        </div>
      </div>

      {publicHeadings.length > 1 && <aside class="article-toc-aside" aria-label="Оглавление статьи">
        <p>В этой статье</p>
        <ol>{publicHeadings.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol>
      </aside>}
    </div>

    <section class="article-author" aria-label="Автор материала">
      <span class="article-author__rule" aria-hidden="true"></span>
      <p class="article-author__label">Автор материала</p>
      <p class="article-author__name">{entry.data.author}</p>
    </section>

    {related.length > 0 && <section class="container article-related" aria-labelledby="article-related-title">
      <div class="article-related__head"><h2 id="article-related-title">Материалы по теме</h2></div>
      <div class="article-related__grid">
        {related.map((item) => <a class="article-related-card" href={`/articles/${item.data.slug}/`} data-analytics-event="content_click" data-analytics-content-id={item.data.slug} data-analytics-placement="article_related">
          <span class="article-related-card__image">
            {item.data.cover && <ResponsiveImage src={item.data.cover} alt={item.data.coverAlt || ''} width={640} height={360} loading="lazy" sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 45vw, 460px" />}
          </span>
          <span class="article-related-card__copy"><strong>{item.data.title}</strong><span>{item.data.description}</span></span>
          <span class="article-related-card__arrow" aria-hidden="true">↗</span>
        </a>)}
      </div>
    </section>}

    <section class="container article-contact-strip" aria-labelledby="article-contact-title">
      <h2 id="article-contact-title">Не уверены, с чего начать?</h2>
      <div class="article-contact-strip__actions">
        <button type="button" data-open-sheet="ask" data-analytics-event="contact_open">Описать задачу</button>
        <button type="button" data-open-sheet="read">Где читать Докрути</button>
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .article-route{padding:0 0 clamp(2.5rem,5vw,4rem);background:#fff;color:var(--c-graphite)}
  .article-reading-shell{display:grid;grid-template-columns:minmax(0,800px) minmax(0,190px);gap:clamp(1.8rem,3vw,2.6rem);align-items:start;width:min(calc(100% - 2 * var(--gutter)),1040px);margin:clamp(2rem,4vw,3.5rem) auto 0}
  .article-reading-main{min-width:0;width:100%}
  .article-toc-aside{position:sticky;top:88px;max-height:calc(100vh - 108px);overflow:auto;padding:.55rem 0 .2rem .95rem;border-left:1px solid var(--c-line)}
  .article-toc-aside p,.article-toc--compact summary{margin:0 0 .55rem;color:var(--c-graphite);font-size:.74rem;font-weight:750}
  .article-toc-aside ol,.article-toc--compact ol{display:grid;gap:.28rem;margin:0;padding:0;list-style:none}
  .article-toc-aside a,.article-toc--compact a{color:#56616a;font-size:.72rem;line-height:1.35;text-decoration:none}
  .article-toc-aside a:hover,.article-toc--compact a:hover{color:var(--c-orange)}
  .article-toc--compact{display:none}
  .article-prose{min-width:0;max-width:800px;margin:0;font-size:1.04rem;line-height:1.75;overflow-wrap:anywhere}
  .article-prose :global(> p:first-child){margin-top:0}
  .article-prose :global(p){margin:0 0 1.1rem}
  .article-prose :global(h2){max-width:28ch;margin:2.45rem 0 .85rem;font-size:clamp(1.65rem,2.25vw,2rem);line-height:1.12;letter-spacing:-.03em}
  .article-prose :global(h3){margin:1.6rem 0 .55rem;font-size:1.22rem;line-height:1.25;letter-spacing:-.02em}
  .article-prose :global(strong){color:var(--c-graphite);font-weight:750}
  .article-prose :global(a){text-decoration-thickness:1px;text-underline-offset:3px}
  .article-prose :global(blockquote){margin:1.4rem 0;padding:.9rem 1rem;border-left:2px solid var(--c-orange);background:#f4f5f6;font-family:var(--font-editorial);font-size:1.1rem;line-height:1.5}
  .article-prose :global(ul),.article-prose :global(ol){display:grid;gap:.48rem;margin:.9rem 0 1.4rem;padding-left:1.35rem}
  .article-prose :global(li){padding-left:.15rem}
  .article-prose :global(table){display:table;width:100%;max-width:100%;margin:1rem 0 1.35rem;border-collapse:collapse;background:#fff;font-size:.88rem;line-height:1.42}
  .article-prose :global(th),.article-prose :global(td){padding:.55rem .65rem;border:1px solid var(--c-line);text-align:left;vertical-align:top}
  .article-prose :global(th){background:#f4f5f6;font-weight:700}
  .article-author{display:grid;grid-template-columns:28px auto;column-gap:.7rem;align-items:center;width:min(calc(100% - 2 * var(--gutter)),800px);margin:2.2rem auto 0;padding-top:.8rem;border-top:1px solid var(--c-line)}
  .article-author__rule{grid-row:span 2;width:24px;height:2px;background:var(--c-orange)}
  .article-author__label{margin:0;color:var(--c-muted);font-size:.65rem;letter-spacing:.07em;text-transform:uppercase}
  .article-author__name{margin:.1rem 0 0;font-family:var(--font-editorial);font-size:1.15rem;font-weight:600;line-height:1.1}
  .article-related{padding-top:clamp(2.2rem,4vw,3rem)}
  .article-related__head{margin-bottom:.8rem;padding-bottom:.65rem;border-bottom:1px solid var(--c-graphite)}
  .article-related__head h2{margin:0;font-size:clamp(1.45rem,2.2vw,1.85rem);line-height:1.12;letter-spacing:-.03em}
  .article-related__grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:.8rem;max-width:1040px;margin-inline:auto}
  .article-related-card{display:grid;grid-template-columns:150px minmax(0,1fr) 20px;gap:.9rem;align-items:stretch;min-width:0;min-height:132px;border-top:1px solid var(--c-line);border-bottom:1px solid var(--c-line);color:inherit;text-decoration:none}
  .article-related-card:hover{background:#f8f9fa}
  .article-related-card__image{display:block;min-width:0;overflow:hidden;background:#f4f5f6}
  .article-related-card__image img{width:100%;height:100%;object-fit:cover}
  .article-related-card__copy{display:grid;align-content:center;gap:.45rem;min-width:0;padding:.75rem 0}
  .article-related-card__copy strong{font-size:1rem;line-height:1.2}
  .article-related-card__copy>span{display:-webkit-box;overflow:hidden;color:var(--c-muted);font-size:.78rem;line-height:1.4;-webkit-box-orient:vertical;-webkit-line-clamp:2}
  .article-related-card__arrow{align-self:center;color:var(--c-orange);font-size:1.1rem}
  .article-contact-strip{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin-top:2rem;padding:1.1rem 1.3rem;background:#f4f5f6}
  .article-contact-strip h2{margin:0;font-size:clamp(1.25rem,2vw,1.65rem);line-height:1.15}
  .article-contact-strip__actions{display:flex;flex-wrap:wrap;gap:.55rem}
  .article-contact-strip__actions button{min-height:42px;padding:.55rem .9rem;border:1px solid var(--c-graphite);border-radius:999px;background:transparent;color:var(--c-graphite);font:700 .78rem var(--font-ui);cursor:pointer}
  .article-contact-strip__actions button:first-child{border-color:var(--c-orange);background:var(--c-orange);color:#fff}
  @media(max-width:1080px){.article-reading-shell{display:block;width:min(calc(100% - 2 * var(--gutter)),820px)}.article-toc-aside{display:none}.article-toc--compact{display:block;margin:0 0 1.2rem;padding:.7rem .85rem;border:1px solid var(--c-line);background:#fff}.article-toc--compact summary{cursor:pointer;list-style:none}.article-toc--compact summary::-webkit-details-marker{display:none}.article-toc--compact summary::after{float:right;color:var(--c-orange);content:'+'}.article-toc--compact[open] summary::after{content:'−'}.article-toc--compact ol{margin-top:.7rem}.article-toc--compact a{font-size:.82rem}}
  @media(max-width:700px){.article-reading-shell{width:min(calc(100% - 2 * var(--gutter)),800px);margin-top:1.15rem}.article-prose{font-size:1rem;line-height:1.7}.article-prose :global(h2){max-width:none;margin:1.85rem 0 .65rem;font-size:1.62rem;line-height:1.1}.article-prose :global(h3){margin:1.4rem 0 .5rem;font-size:1.18rem}.article-prose :global(table){display:block;overflow-x:auto;font-size:.8rem}.article-prose :global(th),.article-prose :global(td){min-width:88px;padding:.5rem}.article-author{margin-top:1.55rem}.article-related{padding-top:2rem}.article-related__grid{grid-template-columns:1fr;gap:.6rem}.article-related-card{grid-template-columns:1fr 20px;grid-template-rows:auto auto;gap:0 .6rem;min-height:0}.article-related-card__image{grid-column:1 / -1;grid-row:1;aspect-ratio:16 / 7;max-height:160px}.article-related-card__copy{grid-column:1;grid-row:2;padding:.7rem 0}.article-related-card__copy strong{font-size:.98rem}.article-related-card__arrow{grid-column:2;grid-row:2}.article-contact-strip{align-items:flex-start;flex-direction:column;gap:.8rem;margin-top:1.4rem;padding:.95rem}.article-contact-strip__actions{width:100%}.article-contact-strip__actions button{flex:1;min-width:0;padding:.5rem .65rem;font-size:.72rem}}
</style>

<style is:global>
  @media(max-width:600px){body:has(article.article-route) .mobile-action{display:none}}
</style>
