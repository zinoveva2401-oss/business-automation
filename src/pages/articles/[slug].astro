---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { render } from 'astro:content';
import { getPublishedArticles } from '../../lib/content';
import { categoryByName } from '../../lib/site';
export async function getStaticPaths(){return (await getPublishedArticles()).map((entry)=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props; const {Content,headings}=await render(entry); const all=await getPublishedArticles(); const related=all.filter((item)=>entry.data.relatedArticleIds.includes(item.data.id)); const topic=categoryByName.get(entry.data.category); const image=entry.data.ogImage||entry.data.cover; const published=entry.data.publishedAt; const schema={'@context':'https://schema.org','@type':'Article',headline:entry.data.title,description:entry.data.description,author:{'@type':'Person',name:entry.data.author,url:new URL('/about/',Astro.url).href},...(published?{datePublished:published.toISOString(),dateModified:(entry.data.updatedAt||published).toISOString()}:{}),...(image?{image:new URL(image,Astro.url).href}:{}),mainEntityOfPage:Astro.url.href};
---
<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} image={image} type="article" schema={schema}>
<article class="article-page" data-analytics-view="view_article" data-analytics-content-id={entry.data.id} data-analytics-content-type="article" data-analytics-category={entry.data.category}><div class="container article-container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Библиотека',href:'/articles/'},{name:entry.data.title}]}/><header class="article-hero"><div class="article-hero__copy"><div class="article-taxonomy"><a href={'/topics/'+(topic?.slug??'sales')+'/'}>{topic?.name??entry.data.category}</a><span>/</span><span>{entry.data.cluster}</span></div><h1>{entry.data.title}</h1><p>{entry.data.description}</p><div class="trace-mark" aria-hidden="true"><span></span><i></i><b>факт → проверка → действие</b></div><div class="article-meta"><span>{entry.data.author}</span><span>{entry.data.readingTime} мин чтения</span>{published&&<span>{published.toLocaleDateString('ru-RU')}</span>}</div></div>{image&&<div class="article-hero__image"><img src={image} alt={entry.data.coverAlt||''} width="1672" height="941" fetchpriority="high"/></div>}</header><div class="article-reading-grid"><aside class="article-sidebar"><div class="article-sidebar__marker">След</div><p>Материал помогает пройти путь от наблюдаемого факта к следующей проверке.</p><ol class="article-route"><li>Факт</li><li>Причина</li><li>Проверка</li><li>Действие</li></ol>{headings.filter((heading)=>heading.depth===2).length>0&&<details class="article-toc" open><summary>В этом материале</summary><ol>{headings.filter((heading)=>heading.depth===2).map((heading)=><li><a href={'#'+heading.slug}>{heading.text}</a></li>)}</ol></details>}</aside><div class="prose"><Content /></div></div><section class="article-next-step"><div><p class="eyebrow">Следующий шаг</p><h2>Проверка начинается<br/>с вашей ситуации.</h2></div><div><p>Если вопрос из материала похож на то, что происходит у вас, опишите факты и уже сделанные шаги.</p><a class="button button--primary" href="/contacts/">Задать вопрос ↗</a></div></section>{related.length>0&&<section class="home-section recs"><div class="section-head"><h2>Следующий материал</h2><a class="section-link" href="/articles/">Вся библиотека</a></div><div class="article-grid">{related.map((item)=><a class="article-tile" href={'/articles/'+item.data.slug+'/'} data-analytics-event="click_related_article" data-analytics-content-id={item.data.id}><div class="article-tile__image"><img src={item.data.cover!} alt={item.data.coverAlt||''} loading="lazy" width="800" height="450"/></div><h3>{item.data.title}</h3><p>{item.data.description}</p></a>)}</div></section>}</div></article>
</BaseLayout>
