---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { getPublishedArticles } from '../../lib/content';
import { categories, topicDescriptions, topicForCategory } from '../../lib/site';
const articles=await getPublishedArticles();
const topicImages=Object.fromEntries(categories.map((topic)=>[topic.slug,articles.find((article)=>topicForCategory(article.data.category)?.slug===topic.slug)?.data.cover]));
---
<BaseLayout title="Темы «Докрути» — найти рабочую задачу" description="Семь направлений, в которых можно найти причину бизнес-проблемы и следующий шаг.">
<section class="page-hero"><div class="container"><p class="eyebrow">Темы</p><h1>С какой<br/><em style="color:var(--orange);font-style:normal">задачи начать?</em></h1><p>Выберите место, где результат уже виден, но пока непонятно, почему он такой.</p></div></section>
<section class="home-section paper-section"><div class="container topic-overview-grid">{categories.map((topic,index)=><a class:list={{'topic-overview-card':true,'topic-overview-card--wide':index===0||index===4}} href={'/topics/'+topic.slug+'/'} data-analytics-event="click_topic" data-analytics-content-id={topic.slug} data-analytics-placement="topics_index"><div class="topic-overview-card__image">{topicImages[topic.slug]&&<ResponsiveImage src={topicImages[topic.slug]!} alt={`${topic.name}: ${topicDescriptions[topic.slug]}`} width={800} height={450} loading="lazy"/>}</div><div class="topic-overview-card__copy"><span class="topic-overview-card__number">0{index+1}</span><span class:list={{'topic-overview-card__icon':true,[topic.icon]:true}} aria-hidden="true"></span><h3>{topic.name}</h3><p>{topicDescriptions[topic.slug]}</p><strong>Открыть тему ↗</strong></div></a>)}</div></section>
</BaseLayout>
