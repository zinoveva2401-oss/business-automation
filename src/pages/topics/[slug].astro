---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ProductCard from '../../components/ProductCard.astro';
import { categories } from '../../lib/site';
import { getPublishedArticles, getVisibleProducts, getActiveServices } from '../../lib/content';
const serviceMap:Record<string,string[]>={prodazhi:['single-store-problem','store-sales-audit'],upravlenie:['store-work-system'],marketing:['single-store-problem'],klienty:['single-store-problem'],komanda:['store-work-system']};
export function getStaticPaths(){return categories.map((topic)=>({params:{slug:topic.slug},props:{topic}}))}
const {topic}=Astro.props;
const articles=(await getPublishedArticles()).filter(({data})=>data.category===topic.legacy);
const products=(await getVisibleProducts()).filter(({data})=>data.category===topic.legacy);
const services=(await getActiveServices()).filter(({data})=>(serviceMap[topic.slug]||[]).includes(data.id));
---
<BaseLayout title={topic.name + ' — «Докрути»'} description={'Материалы и решения «Докрути» по теме: ' + topic.name + '.'}><section class="topic-page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:topic.name}]}/><p class="eyebrow">Публичная тема</p><h1>{topic.name}</h1><p class="lead">Собранные материалы для ситуации, в которой важно понять причину и выбрать следующий шаг.</p>{articles.length>0&&<section class="topic-section"><div class="section-head"><h2>Статьи</h2><span>{articles.length} материала</span></div><div class="article-grid">{articles.map((article,index)=><ArticleCard article={article} placement="topic_articles" priority={index===0}/>)}</div></section>}{products.length>0&&<section class="topic-section"><div class="section-head"><h2>Инструменты</h2><span>{products.length} решения</span></div><div class="product-grid">{products.map((product)=><ProductCard product={product} placement="topic_tools"/>)}</div></section>}{services.length>0&&<section class="topic-section"><div class="section-head"><h2>Услуги</h2><span>Если нужен разбор</span></div><div class="service-list">{services.map((service)=><a href={'/services/#' + service.data.id}><strong>{service.data.title}</strong><span>{service.data.description}</span><i class="ti ti-arrow-up-right" aria-hidden="true"></i></a>)}</div></section>}{articles.length===0&&products.length===0&&services.length===0&&<p class="empty-topic">Для этой темы пока нет опубликованных материалов.</p>}</div></section></BaseLayout>
<style>.topic-page{padding-block:var(--section);background:var(--c-paper);min-height:50vh}.topic-page h1{margin:.35rem 0 .8rem;font-size:clamp(3rem,6vw,5rem);line-height:.95}.lead{max-width:620px;margin:0;color:#56616a;font-size:1.05rem;line-height:1.6}.topic-section{margin-top:var(--section)}.topic-section .section-head{border-bottom:1px solid var(--c-graphite);padding-bottom:.7rem}.topic-section h2{margin:0;font-size:2rem}.topic-section .section-head span{color:var(--c-muted);font-size:.78rem}.article-grid,.product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.product-grid{grid-template-columns:repeat(2,1fr)}.service-list{border-top:1px solid var(--c-graphite)}.service-list a{display:grid;grid-template-columns:1fr 1.2fr 24px;gap:1rem;align-items:center;padding:1rem 0;border-bottom:1px solid var(--c-graphite);text-decoration:none}.service-list a:hover{color:var(--c-orange)}.service-list span{color:#56616a;font-size:.9rem}.service-list i{color:var(--c-orange)}.empty-topic{margin-top:var(--section);color:var(--c-muted)}@media(max-width:900px){.article-grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:700px){.topic-page h1{font-size:3.2rem}.article-grid,.product-grid{grid-template-columns:1fr}.service-list a{grid-template-columns:1fr 22px;gap:.35rem}.service-list span{grid-column:1;font-size:.85rem}.service-list i{grid-column:2;grid-row:1/3}}</style>
