---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles } from '../../lib/content';
import { categories, topicDescriptions, topicForCategory } from '../../lib/site';
const checksByTopic:Record<string,string[]>={sales:['Поток людей, число покупок и средний чек','Момент воронки, где появился разрыв','Какие данные подтверждают изменение','Один показатель для первой проверки'],'assortiment-i-zakupki':['Товар, остаток и срок принятия решения','Где деньги застревают до заказа','Что уже известно о спросе','Один критерий для следующей закупки'],klienty:['Момент выбора и причина отказа','Где клиенту не хватает ясности','Что видно из вопросов и отзывов','Один шаг до следующего контакта'],komanda:['Задача, роль и ожидаемый результат','Где ответственность возвращается руководителю','Что уже договорено и проверено','Один ритм для следующей недели'],'upravlenie-i-processy':['Задача, срок и точка контроля','Где процесс останавливается','Что уже проверено в работе','Один следующий шаг без перестройки всего'],marketing:['Обещание, канал и действие клиента','Где сообщение перестаёт работать','Какие сигналы уже видны','Одна гипотеза для проверки'],'ii-i-avtomatizaciya':['Вопрос, данные и границы ответа','Где версия подменяет факт','Что можно проверить независимо','Один безопасный следующий шаг']};
const checkDescriptionsByTopic:Record<string,string[]>={sales:['Сопоставьте поток людей с числом покупок и средним чеком.','Отметьте участок пути, где интерес не превращается в покупку.','Сверьте изменение с наблюдаемыми данными продаж.','Выберите один показатель для первой проверки.'],'assortiment-i-zakupki':['Соберите в одну картину товар, остаток и срок решения.','Найдите, где средства задерживаются до следующего заказа.','Отделите известный спрос от предположения.','Зафиксируйте один критерий для следующей закупки.'],'klienty':['Опишите момент выбора и причину, по которой клиент останавливается.','Проверьте, какой информации не хватает перед решением.','Соберите повторяющиеся вопросы и отзывы.','Выберите один шаг до следующего контакта.'],'komanda':['Сверьте задачу, роль и ожидаемый результат.','Найдите место, где ответственность снова уходит руководителю.','Зафиксируйте, что уже договорено и проверено.','Определите один рабочий ритм на следующую неделю.'],'upravlenie-i-processy':['Разложите задачу по сроку и точке контроля.','Отметьте, на каком шаге процесс останавливается.','Проверьте, что уже работает в ежедневной практике.','Выберите следующий шаг без перестройки всей системы.'],'marketing':['Сверьте обещание, канал и действие клиента.','Найдите момент, когда сообщение перестаёт помогать выбору.','Соберите сигналы, которые уже видны в работе.','Сформулируйте одну гипотезу для проверки.'],'ii-i-avtomatizaciya':['Уточните вопрос, данные и границы ответа.','Отделите рабочую версию от подтверждённого факта.','Проверьте вывод независимым способом.','Выберите безопасный следующий шаг.']};
const topicImages:Record<string,string>={sales:'/images/service-sales-audit.png','assortiment-i-zakupki':'/images/cnt-0007-store-path.png',klienty:'/images/about-editorial-workspace.png',komanda:'/images/cnt-0034-task-before-after.png','upravlenie-i-processy':'/images/home-hero-editorial.png',marketing:'/images/cnt-0017-metric-lens.png','ii-i-avtomatizaciya':'/images/cnt-0020-stock-decision.png'};
export function getStaticPaths(){return categories.map((topic)=>({params:{slug:topic.slug},props:{topic}}))}
const {topic}=Astro.props; const articles=(await getPublishedArticles()).filter((article)=>topicForCategory(article.data.category)?.slug===topic.slug);
const checks=checksByTopic[topic.slug]??checksByTopic.sales;
const checkDescriptions=checkDescriptionsByTopic[topic.slug]??checkDescriptionsByTopic.sales;
---
<BaseLayout title={topic.name + ' — материалы «Докрути»'} description={topicDescriptions[topic.slug]} darkHeader>
<article class="topic-page"><section class="topic-hero"><div class="topic-hero__copy"><p class="eyebrow">Тема · {topic.name}</p><h1>{topic.name}</h1><p>{topicDescriptions[topic.slug]}</p><div class="trace-mark" aria-hidden="true"><span></span><i></i><b>следующая проверка</b></div></div><div class="topic-hero__image"><img src={topicImages[topic.slug]} alt={`${topic.name}: ${topicDescriptions[topic.slug]}`} width="836" height="470" fetchpriority="high"/></div></section><section class="checks"><div class="container"><div class="section-head"><div><p class="eyebrow">Сначала проверьте</p><h2>Не лечить<br/>не ту причину.</h2></div><a class="section-link" href="/contacts/">Задать вопрос</a></div><div class="checks-grid">{checks.map((check,index)=><article class="check"><span>0{index+1}</span><h3>{check}</h3><p>{checkDescriptions[index]}</p></article>)}</div></div></section><section class="topic-materials"><div class="container"><div class="section-head"><div><p class="eyebrow">Материалы по теме</p><h2>Есть с чего<br/>начать.</h2></div><a class="section-link" href="/articles/">Вся библиотека</a></div><div class="article-grid">{articles.map((article)=><a class="article-tile" href={'/articles/'+article.data.slug+'/'} data-analytics-event="click_article" data-analytics-content-id={article.data.id} data-analytics-placement="topic_materials"><div class="article-tile__image"><img src={article.data.cover!} alt={article.data.coverAlt!} width="800" height="450" loading="lazy"/></div><div class="article-tile__meta"><span>{article.data.readingTime} мин чтения</span></div><h3>{article.data.title}</h3><p>{article.data.description}</p></a>)}</div></div></section></article>
</BaseLayout>
