---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActiveServices } from '../../lib/content';
export function getStaticPaths(){return getActiveServices().then((items)=>items.map((entry)=>({params:{slug:entry.data.slug},props:{entry}})))}
const {entry}=Astro.props; const title=entry.data.h1 ?? entry.data.title;
---
<BaseLayout title={entry.data.title+' — «Докрути»'} description={entry.data.description ?? ''}>
<article class="service-page"><section class="service-detail-hero"><div class="container service-detail-hero__copy"><p class="eyebrow">Услуга / {entry.data.title}</p><h1>{title}</h1><p>{entry.data.description}</p><a class="button button--primary" href="/contacts/" data-analytics-event="click_contact" data-analytics-placement="service_detail">Описать задачу ↗</a></div><aside class="service-detail-logic" aria-label="Последовательность работы"><span>РАБОЧАЯ ПОСЛЕДОВАТЕЛЬНОСТЬ</span><ol>{['Ситуация','Проверка','Следующий шаг'].map((step,index)=><li><b>0{index+1}</b>{step}</li>)}</ol></aside></section><section class="home-section paper-section"><div class="container service-detail-body"><div><p class="eyebrow">Кому подходит</p><h2>Когда проблема уже видна.</h2></div><div><p class="service-detail-lead">{entry.data.description}</p><p class="muted">Состав, срок и стоимость обсуждаются после описания задачи.</p></div></div></section><section class="steps-band"><div class="container"><p class="eyebrow" style="color:#e7a6b5">След</p><h2>От вопроса<br/>к применению.</h2><div class="steps">{['Описать ситуацию','Проверить исходные данные','Собрать разбор','Договориться о следующем шаге'].map((step,index)=><div><span>0{index+1}</span><p>{step}</p></div>)}</div></div></section></article>
</BaseLayout>
<style>
  .service-detail-logic{display:grid;align-content:center;gap:1.2rem;padding:2rem;border-left:2px solid var(--c-orange);color:var(--c-graphite)}.service-detail-logic>span{color:var(--c-muted);font-size:.62rem;font-weight:800;letter-spacing:.1em}.service-detail-logic ol{display:grid;gap:0;margin:0;padding:0;list-style:none}.service-detail-logic li{display:grid;grid-template-columns:40px 1fr;gap:.6rem;align-items:center;padding:.75rem 0;border-top:1px solid var(--c-line);font:600 1.1rem var(--font-editorial)}.service-detail-logic li:last-child{border-bottom:1px solid var(--c-line)}.service-detail-logic b{color:var(--c-orange);font:600 .8rem var(--font-editorial)}
  @media(max-width:700px){.service-detail-hero{grid-template-columns:1fr;min-height:0}.service-detail-hero__copy{padding-block:48px 20px}.service-detail-hero h1{font-size:clamp(44px,12vw,64px)}.service-detail-logic{margin:0 var(--gutter) 32px;padding:1.2rem 0 0;border-top:1px solid var(--c-line);border-left:0}}
</style>
