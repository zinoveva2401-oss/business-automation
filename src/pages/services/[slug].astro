---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActiveServices } from '../../lib/content';
const images:Record<string,string>={'razbor-odnoy-zadachi':'/images/service-single-task.png','audit-prodazh-i-processov':'/images/service-sales-audit.png','sistema-raboty-komandy':'/images/service-team-system.png'};
export function getStaticPaths(){return getActiveServices().then((items)=>items.map((entry)=>({params:{slug:entry.data.slug},props:{entry}})))}
const {entry}=Astro.props; const title=entry.data.h1 ?? entry.data.title;
---
<BaseLayout title={entry.data.title+' — «Докрути»'} description={entry.data.description ?? ''}>
<article class="service-page"><section class="service-detail-hero"><div class="container service-detail-hero__copy"><p class="eyebrow">Услуга / {entry.data.title}</p><h1>{title}</h1><p>{entry.data.description}</p><a class="button button--primary" href="/contacts/" data-analytics-event="click_contact" data-analytics-placement="service_detail">Описать задачу ↗</a></div><div class="service-detail-hero__image"><img src={images[entry.data.slug]} alt="" width="836" height="470" fetchpriority="high"/></div></section><section class="home-section paper-section"><div class="container service-detail-body"><div><p class="eyebrow">Кому подходит</p><h2>Когда проблема уже видна.</h2></div><div><p class="service-detail-lead">{entry.data.description}</p><p class="muted">Состав, срок и стоимость обсуждаются после описания задачи.</p></div></div></section><section class="steps-band"><div class="container"><p class="eyebrow" style="color:#e7a6b5">След</p><h2>От вопроса<br/>к применению.</h2><div class="steps">{['Описать ситуацию','Проверить исходные данные','Собрать разбор','Договориться о следующем шаге'].map((step,index)=><div><span>0{index+1}</span><p>{step}</p></div>)}</div></div></section></article>
</BaseLayout>
