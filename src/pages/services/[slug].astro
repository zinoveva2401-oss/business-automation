---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getActiveServices } from '../../lib/content';
export async function getStaticPaths(){return (await getActiveServices()).map(entry=>({params:{slug:entry.data.slug},props:{entry}}))}
const {entry}=Astro.props;
const schema={'@context':'https://schema.org','@type':'Service',name:entry.data.title,description:entry.data.description,provider:{'@type':'Person',name:'Светлана Тарасова'}};
---
<BaseLayout title={entry.data.seoTitle} description={entry.data.seoDescription} schema={schema}><article class="service-detail-v4"><header class="detail-hero"><div class="container"><a href="/services/">← Все услуги</a><p class="eyebrow">ФОРМАТ РАБОТЫ</p><h1>{entry.data.title}</h1><p>{entry.data.description}</p><button class="button button--primary" type="button" data-open-sheet="ask" data-analytics-event="contact_open" data-analytics-service-id={entry.data.id}>Описать задачу ↗</button></div></header><section class="container detail-body"><div class="detail-intro"><p class="eyebrow">КАК ЭТО РАБОТАЕТ</p><h2>От ситуации к согласованному шагу</h2></div><dl><div><dt>Когда подходит</dt><dd>{entry.data.situation || entry.data.description}</dd></div><div><dt>Что происходит</dt><dd>{entry.data.process}</dd></div><div><dt>Что получается</dt><dd>{entry.data.output}</dd></div><div><dt>Что нужно от вас</dt><dd>{entry.data.clientInput}</dd></div></dl></section><section class="detail-next"><div class="container"><h2>Начнём с описания задачи</h2><p>Светлана проверит, подходит ли формат и какие данные нужны. Объём, срок и стоимость согласуются до начала работы.</p><button class="button button--primary" type="button" data-open-sheet="ask" data-analytics-event="contact_open">Задать вопрос ↗</button></div></section></article></BaseLayout>
<style>.service-detail-v4{background:#fff}.detail-hero{padding:45px 0 60px;background:#f4f5f6}.detail-hero a{display:inline-block;margin-bottom:35px;font-size:13px;text-decoration:none}.detail-hero h1{max-width:900px;margin:0 0 20px;font-size:clamp(55px,6vw,88px)}.detail-hero p:not(.eyebrow){max-width:600px;font-size:18px}.detail-hero button{margin-top:15px;cursor:pointer}.detail-body{display:grid;grid-template-columns:.7fr 1fr;gap:70px;padding-top:70px;padding-bottom:70px}.detail-body h2{margin:0;font-size:clamp(38px,4vw,58px)}.detail-body dl{margin:0}.detail-body dl>div{display:grid;grid-template-columns:160px 1fr;gap:20px;padding:18px 0;border-top:1px solid #bfc4c9}.detail-body dt{color:#b74323;font-size:12px;font-weight:700;text-transform:uppercase}.detail-body dd{margin:0;font-size:15px}.detail-next{padding:50px 0;background:#17130f;color:#fff}.detail-next h2{margin:0;font-size:clamp(35px,4vw,56px)}.detail-next p{max-width:570px}.detail-next button{cursor:pointer}@media(max-width:700px){.detail-hero{padding:30px 0 45px}.detail-hero h1{font-size:clamp(48px,11vw,65px)}.detail-body{grid-template-columns:1fr;gap:20px;padding-top:45px;padding-bottom:45px}.detail-body dl>div{grid-template-columns:1fr;gap:5px}}</style>
