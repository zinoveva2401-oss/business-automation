---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const services = [
  {
    number: '01', slug: 'single-store-problem', title: 'Разбор одной проблемы магазина',
    short: 'Разбираем одну конкретную проблему, находим причину и определяем дальнейшие действия.',
    image: '/service-cards/ChatGPT Image 24 авг. 2026 г., 16_29_15 (1).png',
    heading: 'Когда нужен разбор одной проблемы',
    intro: [
      'Иногда не требуется масштабный аудит. Есть одна конкретная ситуация, которая мешает работе магазина, и сначала нужно разобраться именно с ней.',
      'Например, снизились продажи, изменился средний чек, сотрудники не выполняют стандарты, акция не дала результата, выросли остатки или вы видите проблему, но не понимаете ее истинную причину.',
      'Здесь мы не разбираем весь магазин целиком. Берем одну задачу, отделяем факты от предположений и смотрим, что именно происходит.',
    ],
    scopeTitle: 'Что разбираем',
    scope: ['одну конкретную проблему или показатель', 'данные и факты, связанные с ней', 'возможные причины', 'действия, которые уже предпринимались', 'то, что имеет смысл изменить в первую очередь'],
    process: ['Вы описываете ситуацию и передаете имеющиеся на данный момент данные. Я изучаю контекст, задаю необходимые уточняющие вопросы и анализирую причинно-следственные связи.', 'Задача не в том, чтобы дать общий совет, а в том, чтобы понять, что происходит именно в вашей ситуации и что имеет смысл делать дальше.'],
    result: ['понятное объяснение проблемы', 'основные причины или рабочие гипотезы', 'приоритетные действия', 'рекомендации, с чего начать', 'понимание того, нужен ли более глубокий аудит'],
    final: 'Подходит, если проблема локальная и ее можно рассмотреть отдельно от всей системы магазина.',
  },
  {
    number: '02', slug: 'store-sales-audit', title: 'Аудит продаж и работы магазина',
    short: 'Комплексный анализ продаж, показателей и рабочих процессов магазина.',
    image: '/service-cards/ChatGPT Image 24 авг. 2026 г., 16_29_15 (2).png',
    heading: 'Когда одного показателя уже недостаточно',
    intro: [
      'Бывает, что проблема одна, а причин у нее несколько.',
      'Продажи могут снижаться одновременно из-за ассортимента, остатков, трафика, работы продавцов, выкладки, цен, акций или управленческих решений.',
      'В такой ситуации бессмысленно исправлять первый попавшийся показатель. Сначала нужно увидеть магазин целиком и понять, где именно происходит потеря результата.',
    ],
    scopeTitle: 'Что смотрим',
    scope: ['динамику продаж и ключевых показателей', 'средний чек, конверсию и другие доступные показатели', 'ассортимент и остатки', 'путь покупателя', 'работу продавцов и руководителя', 'действующие акции и механики продаж', 'основные рабочие процессы', 'точки, в которых магазин теряет деньги или эффективность'],
    scopeNote: 'Анализируем только те показатели, по которым доступны данные.',
    process: ['Сначала мы собираем данные и описание ситуации. Затем я сопоставляю цифры с тем, как магазин работает на практике.', 'Задача аудита — не просто найти слабые места. Нужно отделить причины от следствий и понять, что действительно влияет на результат, а что только кажется проблемой.'],
    result: ['картину текущего состояния магазина', 'перечень обнаруженных проблем', 'объяснение основных причин', 'приоритеты по степени влияния', 'рекомендации по исправлению', 'последовательность дальнейших действий'],
    final: 'Подходит, когда результат ухудшился, причин может быть несколько или непонятно, с какой проблемы вообще начинать.',
  },
  {
    number: '03', slug: 'store-work-system', title: 'Система работы магазина',
    short: 'Выстраиваем понятную систему управления и операционной работы магазина.',
    image: '/service-cards/ChatGPT Image 24 авг. 2026 г., 16_29_15 (3).png',
    heading: 'Когда проблема уже не в одном показателе',
    intro: [
      'Иногда магазин работает, но слишком многое держится на конкретных людях, ручном контроле и постоянном «тушении пожаров».',
      'Задачи теряются. Сотрудники работают каждый по-своему. Руководитель большую часть времени контролирует текучку. Правила существуют частично или только в голове у сотрудников.',
      'В таком формате задача уже не в том, чтобы найти одну ошибку, а в том, чтобы выстроить понятную систему работы магазина.',
    ],
    scopeTitle: 'С чем мы можем работать',
    scope: ['распределение обязанностей', 'ежедневная работа руководителя', 'контроль задач', 'показатели и точки контроля', 'стандарты работы сотрудников', 'продажи и обслуживание', 'регламенты и чек-листы', 'обучение команды', 'рабочие совещания и пятиминутки', 'повторяющиеся операционные процессы', 'инструменты автоматизации там, где они действительно полезны'],
    process: ['Сначала мы определяем, где система дает сбой или слишком сильно зависит от ручного управления.', 'После этого мы собираем рабочую модель: кто за что отвечает, что и когда контролируется, какие нужны правила, какие показатели используются и какие инструменты помогают поддерживать систему в рабочем состоянии.', 'Не нужно создавать документы ради документов. Каждый регламент, чек-лист или инструмент должен решать конкретную рабочую задачу.'],
    resultLead: 'Состав зависит от задачи магазина, но может включать:',
    result: ['структуру рабочих процессов', 'распределение зон ответственности', 'систему контроля', 'регламенты', 'чек-листы', 'стандарты', 'рабочие формы и шаблоны', 'рекомендации по показателям', 'план внедрения изменений'],
    final: 'Подходит, когда нужно не исправить отдельную проблему, а изменить сам принцип работы магазина.',
  },
];
---

<BaseLayout title="Услуги для собственников магазинов — Розница в цифрах" description="Практическая помощь для розницы на основе опыта и аналитики.">
  <main class="services-page">
    <section class="services-hero">
      <div class="container hero-content">
        <Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: 'Услуги' }]} />
        <div class="hero-copy"><h1>Услуги</h1><p>Практическая помощь для розницы<br />на основе опыта и аналитики</p></div>
      </div>
    </section>

    <section class="service-story" aria-label="Форматы работы">
      <div class="container story-line">
        {services.map((service, index) => (
          <article class:list={['service-episode', { reverse: index === 1 }]} id={service.slug}>
            <div class="service-visual">
              <img src={service.image} alt="" width="1792" height="1024" loading={index === 0 ? 'eager' : 'lazy'} />
              <div class="visual-shade"></div>
              <div class="visual-copy"><span>{service.number}</span><div><h2>{service.title}</h2><p>{service.short}</p></div></div>
            </div>

            <div class="service-detail">
              <header><span>{service.number} / СИТУАЦИЯ</span><h3>{service.heading}</h3></header>
              <div class="intro-copy">{service.intro.map((paragraph) => <p>{paragraph}</p>)}</div>
              <div class="detail-grid">
                <section><h4><i class="ti ti-list-check" aria-hidden="true"></i>{service.scopeTitle}</h4><ul>{service.scope.map((item) => <li>{item}</li>)}</ul>{service.scopeNote && <p class="detail-note">{service.scopeNote}</p>}</section>
                <section><h4><i class="ti ti-route" aria-hidden="true"></i>Как проходит работа</h4>{service.process.map((paragraph) => <p>{paragraph}</p>)}</section>
                <section><h4><i class="ti ti-checks" aria-hidden="true"></i>Что вы получаете</h4>{service.resultLead && <p class="result-lead">{service.resultLead}</p>}<ul>{service.result.map((item) => <li>{item}</li>)}</ul></section>
              </div>
              <p class="fit-note"><strong>Подходит:</strong> {service.final.replace(/^Подходит, /, '').replace(/^Подходит, если /, 'если ')}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="choice-section">
      <div class="container choice-grid">
        <div><p class="eyebrow">Как выбрать формат</p><h2>От одной задачи<br />к системе работы</h2></div>
        <div class="choice-copy">
          <p>Если проблема уже ясна, можно начать с разбора одной задачи. Если причин несколько или пока непонятно, что именно мешает достижению результата, подойдет аудит. Если нужно перестроить работу магазина целиком, рассматриваем системную работу.</p>
          <ol class="choice-path"><li><span>01</span>Одна понятная проблема <strong>Разбор</strong></li><li><span>02</span>Несколько причин или причина непонятна <strong>Аудит</strong></li><li><span>03</span>Нужно менять способ работы магазина <strong>Система</strong></li></ol>
          <a class="button button--primary" href="/contacts/" data-analytics-event="click_contact" data-analytics-placement="services_choice">Обсудить задачу <i class="ti ti-arrow-right" aria-hidden="true"></i></a>
          <small>Опишите ситуацию. Сначала разберемся, какой формат действительно нужен.</small>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .services-page{overflow:hidden;background:#f3f5f7;color:var(--c-ink)}
  .services-hero{position:relative;min-height:330px;background:#0e1114 url('/hero-retail-investigation.png.png') center 56%/cover no-repeat;color:#fff}
  .services-hero::before{position:absolute;inset:0;background:linear-gradient(90deg,#080b0ee8 0%,#0c1014c4 42%,#0c10145c 76%,#0c101430);content:''}
  .services-hero::after{position:absolute;right:-4%;bottom:24px;width:55%;height:2px;background:var(--c-orange);content:'';opacity:.9;transform:rotate(-3deg)}
  .hero-content{position:relative;z-index:1;padding-top:1rem}.hero-content :global(.breadcrumbs){color:#c7ccd0}.hero-copy{padding-top:3.2rem}.hero-copy h1{margin:0;font-family:var(--font-editorial);font-size:clamp(3.7rem,6vw,5.8rem);font-weight:500;line-height:.95}.hero-copy p{margin:1rem 0 0;font-size:1.08rem;line-height:1.45}
  .service-story{position:relative;padding:2.2rem 0 3rem;background:#f3f5f7}.service-story::before{position:absolute;top:-16px;left:0;width:100%;height:18px;background:#f3f5f7;clip-path:polygon(0 35%,8% 58%,17% 28%,26% 60%,36% 36%,47% 66%,58% 31%,69% 59%,80% 34%,90% 61%,100% 37%,100% 100%,0 100%);content:''}
  .story-line{position:relative}.story-line::before{position:absolute;z-index:0;top:4rem;bottom:4rem;left:50%;border-left:2px dashed #ff6a0066;content:''}
  .service-episode{position:relative;z-index:1;display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(2rem,4.5vw,4.5rem);align-items:start;padding:1rem 0 3.2rem}.service-episode+ .service-episode{padding-top:2.6rem;border-top:1px solid #cfd5d9}.service-episode.reverse .service-visual{grid-column:2}.service-episode.reverse .service-detail{grid-row:1;grid-column:1}
  .service-visual{position:sticky;top:1rem;min-height:430px;overflow:hidden;border-radius:10px;background:#0e1114;color:#fff}.service-episode:nth-child(1) .service-visual{transform:translateX(-18px)}.service-episode:nth-child(2) .service-visual{transform:translateX(18px)}.service-episode:nth-child(3) .service-visual{transform:translateX(-18px)}
  .service-visual img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.service-episode:nth-child(1) img{object-position:62% center}.service-episode:nth-child(3) img{object-position:62% center}.visual-shade{position:absolute;inset:0;background:linear-gradient(180deg,#080c101f 10%,#080c10df 100%)}.visual-copy{position:absolute;right:0;bottom:0;left:0;display:grid;grid-template-columns:68px 1fr;gap:1rem;align-items:start;padding:1.5rem}.visual-copy>span{color:var(--c-orange);font-family:var(--font-editorial);font-size:3.25rem;line-height:.9}.visual-copy h2{margin:0 0 .55rem;font-family:var(--font-editorial);font-size:2rem;font-weight:500;line-height:1.04}.visual-copy p{max-width:390px;margin:0;color:#dce1e4;font-size:.94rem;line-height:1.45}
  .service-detail{min-width:0}.service-detail header>span{color:var(--c-blue);font-size:.72rem;font-weight:800;letter-spacing:.12em}.service-detail h3{margin:.35rem 0 .9rem;font-family:var(--font-editorial);font-size:clamp(2rem,3vw,2.75rem);font-weight:500;line-height:1.05}.intro-copy{columns:2;column-gap:1.5rem}.intro-copy p{break-inside:avoid;margin:0 0 .7rem;font-size:.94rem;line-height:1.5}.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:1.25rem 1.6rem;margin-top:1.25rem;padding-top:1.2rem;border-top:1px solid #cfd5d9}.detail-grid section:first-child{grid-row:span 2}.detail-grid h4{display:flex;align-items:center;gap:.45rem;margin:0 0 .55rem;font-family:var(--font-editorial);font-size:1.15rem}.detail-grid h4 i{color:var(--c-blue);font-size:1.25rem}.detail-grid p,.detail-grid li{color:#49545c;font-size:.85rem;line-height:1.42}.detail-grid p{margin:.35rem 0}.detail-grid ul{display:grid;gap:.32rem;margin:0;padding:0;list-style:none}.detail-grid li{position:relative;padding-left:1rem}.detail-grid li::before{position:absolute;top:.56em;left:0;width:5px;height:5px;border-radius:50%;background:var(--c-blue);content:''}.detail-note{padding:.55rem .65rem;border-left:2px solid var(--c-orange);background:#e9eef2}.result-lead{font-weight:700}.fit-note{margin:1.15rem 0 0;padding:.8rem 1rem;border-left:3px solid var(--c-orange);background:#e9eef2;font-size:.9rem;line-height:1.45}.fit-note strong{color:var(--c-orange)}
  .choice-section{padding:2.7rem 0 3rem;background:#e9eef2}.choice-grid{display:grid;grid-template-columns:.78fr 1.22fr;gap:clamp(2rem,7vw,7rem);align-items:start}.choice-grid .eyebrow{margin:0 0 .55rem;color:#68737b}.choice-grid h2{margin:0;font-family:var(--font-editorial);font-size:clamp(2.2rem,3.4vw,3.35rem);font-weight:500;line-height:1.03}.choice-copy{padding-left:1.4rem;border-left:3px solid var(--c-orange)}.choice-copy>p{max-width:720px;margin:0 0 1.1rem;font-size:1rem;line-height:1.55}.choice-path{display:grid;gap:.55rem;margin:0 0 1.25rem;padding:0;list-style:none}.choice-path li{display:grid;grid-template-columns:32px 1fr auto;gap:.6rem;align-items:center;padding-bottom:.5rem;border-bottom:1px solid #cad1d5;font-size:.88rem}.choice-path span{color:var(--c-orange);font-family:var(--font-editorial);font-size:1.15rem}.choice-path strong{color:#27343d}.choice-copy .button{min-height:46px}.choice-copy small{display:block;margin-top:.55rem;color:#59656d;font-size:.78rem}
  :global(.site-footer .footer-grid>div:last-child a[href="/cookie-policy/"]),:global(.site-footer .footer-grid>div:last-child button[data-cookie-settings]){display:none!important}:global(.site-footer .footer-grid>div:last-child strong){order:0}:global(.site-footer .footer-grid>div:last-child a[href="/privacy/"]){order:1;font-size:0!important}:global(.site-footer .footer-grid>div:last-child a[href="/user-agreement/"]){order:2;font-size:0!important}:global(.site-footer .footer-grid>div:last-child a[href="/offer/"]){order:3}:global(.site-footer .footer-grid>div:last-child a[href="/privacy/"]::after){content:'Политика конфиденциальности';font-size:.875rem}:global(.site-footer .footer-grid>div:last-child a[href="/user-agreement/"]::after){content:'Пользовательское соглашение';font-size:.875rem}
  @media(max-width:980px){.service-episode{grid-template-columns:1fr;gap:1.5rem}.service-episode.reverse .service-visual,.service-episode.reverse .service-detail{grid-row:auto;grid-column:auto}.service-visual{position:relative;top:auto;min-height:390px}.service-episode:nth-child(n) .service-visual{transform:none}.story-line::before{left:1rem}.intro-copy{columns:1}.detail-grid{grid-template-columns:1fr 1fr}.detail-grid section:first-child{grid-row:auto}.choice-grid{grid-template-columns:1fr;gap:1.3rem}}
  @media(max-width:480px){.services-hero{min-height:250px;background-position:66% center}.services-hero::before{background:linear-gradient(90deg,#080b0ef2 0%,#0c1014c7 72%,#0c101457)}.services-hero::after{right:-28%;bottom:22px;width:92%}.hero-content{padding-top:.65rem}.hero-copy{padding-top:1.9rem}.hero-copy h1{font-size:2.65rem}.hero-copy p{margin-top:.65rem;font-size:1rem;line-height:1.4}.service-story{padding:1.15rem 0 1.8rem}.story-line::before{left:50%;opacity:.45}.service-episode{gap:1rem;padding:.45rem 0 2.1rem}.service-episode+ .service-episode{padding-top:1.5rem}.service-visual{width:94%;min-height:245px}.service-episode:nth-child(odd) .service-visual{justify-self:start}.service-episode:nth-child(even) .service-visual{justify-self:end}.service-visual img,.service-episode:nth-child(1) img,.service-episode:nth-child(3) img{object-position:center}.visual-copy{grid-template-columns:43px 1fr;gap:.55rem;padding:1rem}.visual-copy>span{font-size:2.35rem}.visual-copy h2{margin-bottom:.4rem;font-size:1.45rem}.visual-copy p{font-size:1rem;line-height:1.45}.service-detail{position:relative;padding:.1rem .1rem 0}.service-detail header>span{font-size:.68rem}.service-detail h3{margin-bottom:1.05rem;font-size:1.85rem}.intro-copy p{margin-bottom:.9rem;font-size:1rem;line-height:1.58}.detail-grid{grid-template-columns:1fr;gap:1.75rem;margin-top:1.35rem;padding-top:1.25rem}.detail-grid section+section{padding-top:.2rem}.detail-grid h4{margin-bottom:.8rem;font-size:1.16rem;line-height:1.25}.detail-grid p,.detail-grid li{font-size:1rem;line-height:1.55}.detail-grid p{margin:.5rem 0}.detail-grid ul{gap:.55rem}.detail-note{margin-top:.8rem}.fit-note{margin-top:1.35rem;font-size:1rem;line-height:1.55}.choice-section{padding:1.9rem 0 2.1rem}.choice-grid{gap:1rem}.choice-grid h2{font-size:2rem}.choice-copy{padding-left:1rem}.choice-copy>p{font-size:1rem;line-height:1.55}.choice-path{gap:.7rem}.choice-path li{grid-template-columns:30px 1fr;gap:.35rem .55rem;font-size:1rem;line-height:1.45}.choice-path strong{grid-column:2}.choice-copy .button{min-height:46px}.choice-copy small{font-size:.8rem}:global(.site-footer .footer-grid>div:not(.footer-about)){display:grid;gap:.4rem}:global(.site-footer .footer-grid>div:not(.footer-about) a){display:block!important}:global(.site-footer .footer-grid>div:not(.footer-about) strong:after){display:none}}
</style>
