---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EditorialFolio from '../../components/EditorialFolio.astro';
import EditorialEvidenceTrack from '../../components/EditorialEvidenceTrack.astro';
import { getActiveServices } from '../../lib/content';
const services = await getActiveServices();
---
<BaseLayout title="Услуги «Докрути» — помощь с рабочей задачей" description="Разбор одной задачи, аудит продаж и процессов, доработка системы работы со Светланой Тарасовой.">
  <article class="services-route">
    <header class="services-route__intro"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Услуги'}]} /><EditorialFolio number="06" label="Services" /><p class="eyebrow">Формат под задачу</p><h1>Сначала ситуация.<br /><em>Потом формат.</em></h1><p>Опишите вопрос или проблему. До начала работы я предложу подходящий формат, объём, срок и стоимость.</p></div></header>
    <section class="services-route__list"><div class="container"><div class="services-route__heading"><h2>Три рабочих маршрута</h2><p>Каждый начинается с наблюдаемого факта и заканчивается согласованным следующим шагом.</p></div><div class="service-dossiers">{services.map((service,index)=><article id={service.data.id}><span class="service-dossiers__number">0{index+1}</span><div><p class="eyebrow">Решение {index+1}</p><h3>{service.data.title}</h3><p>{service.data.description}</p><div class="service-dossiers__evidence"><span>Причина</span><span>Проверка</span><span>Действие</span></div></div><a class="route-link" href="#question" data-analytics-event="click_service" data-analytics-content-id={service.data.id} data-analytics-placement="services_route">Описать задачу <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></article>)}</div></div></section>
    <EditorialEvidenceTrack dark id="services-evidence" title="Прозрачный рабочий маршрут." lead="Сначала описание ситуации и доступных данных. Затем — fit, формат, срок и стоимость. Работа начинается после согласования." />
    <section class="services-route__question" id="question"><div class="container"><EditorialFolio number="06" label="Next action" dark /><h2>Опишите задачу.</h2><p>Коротко расскажите, что происходит. Я отвечу, могу ли быть полезна и какой формат подойдёт.</p><a class="button button--primary" href="mailto:hello@dokruti.ru" data-analytics-event="click_email" data-analytics-placement="services_question">Задать вопрос <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></section>
  </article>
</BaseLayout>
<style>
  .services-route{background:#fff;color:var(--c-graphite)}.services-route__intro{padding:1rem 0 clamp(4rem,8vw,7rem);background:var(--c-paper)}.services-route__intro .editorial-folio{margin:2rem 0}.services-route__intro h1{max-width:850px;margin:.5rem 0 1rem;font-size:clamp(3.3rem,6.5vw,6.7rem);line-height:.88;letter-spacing:-.05em}.services-route__intro h1 em{color:var(--c-orange);font-style:normal}.services-route__intro>div>p:last-child{max-width:580px;margin:0;color:#56616a;font-size:1.08rem;line-height:1.55}.services-route__list{padding:clamp(4rem,8vw,8rem) 0;background:#fff}.services-route__heading{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);align-items:end;margin-bottom:2rem}.services-route__heading h2{margin:0;font-size:clamp(2.5rem,4.6vw,4.6rem);line-height:.94}.services-route__heading p{max-width:470px;margin:0;color:#56616a;line-height:1.55}.service-dossiers{border-top:2px solid var(--c-graphite)}.service-dossiers article{display:grid;grid-template-columns:72px minmax(0,1fr) auto;gap:1.5rem;padding:1.4rem 0;border-bottom:1px solid var(--c-graphite)}.service-dossiers__number{color:var(--c-orange);font:600 2rem/.9 var(--font-editorial)}.service-dossiers h3{margin:.35rem 0 .7rem;font-size:clamp(1.8rem,3.1vw,3rem);line-height:1}.service-dossiers p:not(.eyebrow){max-width:600px;margin:0;color:#56616a;line-height:1.5}.service-dossiers .route-link{margin-top:.15rem;white-space:nowrap}.service-dossiers__evidence{display:flex;flex-wrap:wrap;gap:.4rem;margin-top:1.2rem}.service-dossiers__evidence span{padding:.35rem .5rem;border:1px solid var(--c-line);color:var(--c-muted);font-size:.67rem}.services-route__question{padding:clamp(4rem,8vw,7rem) 0;background:var(--c-navy);color:#fff}.services-route__question h2{margin:1rem 0 .8rem;font-size:clamp(3rem,6vw,6rem);line-height:.9}.services-route__question p:not(.eyebrow){max-width:510px;color:#e2e8ef;line-height:1.55}.services-route__question .button{margin-top:.8rem}@media(max-width:700px){.services-route__intro h1{font-size:clamp(3rem,12vw,4.3rem)}.services-route__heading{grid-template-columns:1fr;gap:1rem}.service-dossiers article{grid-template-columns:42px minmax(0,1fr);gap:.8rem}.service-dossiers .route-link{grid-column:2}.service-dossiers h3{font-size:1.7rem}}
</style>
