---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getActiveServices } from '../../lib/content';
const services=await getActiveServices();
---
<BaseLayout title="Услуги «Докрути» — помощь с рабочей задачей" description="Разбор одной задачи, аудит продаж и процессов, доработка системы работы со Светланой Тарасовой."><section class="services-page"><div class="container services-intro"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Услуги'}]}/><p class="eyebrow">Формат под задачу</p><h1>Как я могу быть полезна</h1><p class="lead">Если у вас есть вопрос, задача или проблема — опишите её. Я посмотрю, могу ли быть полезна, и до начала работы предложу подходящий формат, объём, срок и стоимость.</p></div><section class="formats"><div class="container"><div class="format-list">{services.map((service,index)=><article id={service.data.id}><span class="format-index">0{index+1}</span><div><h2>{service.data.title}</h2><p>{service.data.description}</p></div><a class="format-link" href="#question">Описать задачу <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></article>)}</div></div></section><section class="how"><div class="container how-grid"><div><p class="eyebrow">Прозрачный процесс</p><h2>Как это работает</h2></div><ol><li><span>01</span>Клиент описывает ситуацию.</li><li><span>02</span>Светлана оценивает задачу и доступные данные.</li><li><span>03</span>Если есть fit — предлагает формат, срок и стоимость.</li><li><span>04</span>Работа начинается после согласования.</li></ol></div></section><section class="services-question" id="question"><div class="container question-inner"><h2>Опишите задачу</h2><p>Коротко расскажите, что происходит. Я отвечу, могу ли быть полезна и какой формат подойдёт.</p><a class="button button--primary" href="mailto:hello@dokruti.ru">Задать вопрос <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></section></section></BaseLayout>
<style>.services-page{background:#fff;color:var(--c-graphite)}.services-intro{padding:1rem var(--gutter) var(--section)}.services-intro h1{max-width:760px;margin:.35rem 0 .9rem;font-size:clamp(3rem,6vw,5.6rem);line-height:.95}.lead{max-width:680px;margin:0;color:#56616a;font-size:1.05rem;line-height:1.6}.formats{padding:0 0 var(--section);background:var(--c-paper)}.format-list{border-top:1px solid var(--c-graphite)}.format-list article{display:grid;grid-template-columns:72px 1fr auto;gap:1.5rem;align-items:start;padding:1.5rem 0;border-bottom:1px solid var(--c-graphite)}.format-index{color:var(--c-orange);font:600 2.4rem/.9 var(--font-editorial)}.format-list h2{margin:0 0 .35rem;font-size:clamp(1.6rem,2.8vw,2.5rem)}.format-list p{max-width:600px;margin:0;color:#56616a}.format-link{display:inline-flex;align-items:center;gap:.35rem;padding-top:.25rem;color:var(--c-graphite);font-size:.8rem;font-weight:700;text-decoration:none;white-space:nowrap}.format-link:hover{color:var(--c-orange)}.how{padding:var(--section) 0;background:#e8edf2}.how-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,8vw,8rem)}.how h2,.services-question h2{margin:.3rem 0 0;font-size:clamp(2.2rem,4vw,3.8rem);line-height:1}.how ol{display:grid;gap:.6rem;margin:0;padding:0;list-style:none}.how li{display:grid;grid-template-columns:42px 1fr;gap:.8rem;padding-bottom:.6rem;border-bottom:1px solid #b9c2c9;font-size:1rem}.how li span{color:var(--c-orange);font:600 1.1rem var(--font-editorial)}.services-question{padding:var(--section) 0;background:var(--c-chocolate);color:#fff}.question-inner{max-width:760px}.services-question h2{font-size:clamp(2.5rem,5vw,4.5rem)}.services-question p{max-width:510px;margin:1rem 0;color:#d8d4cf}.services-question .button{margin-top:.4rem}@media(max-width:700px){.services-intro{padding-top:.7rem}.services-intro h1{font-size:3.2rem}.format-list article{grid-template-columns:42px 1fr;gap:.8rem;padding:1.15rem 0}.format-index{font-size:1.9rem}.format-link{grid-column:2;padding-top:.1rem}.how-grid{grid-template-columns:1fr;gap:1.5rem}.how li{font-size:.95rem}}@media(max-width:430px){.services-intro h1{font-size:2.7rem}.lead{font-size:.98rem}.format-list h2{font-size:1.55rem}.format-list p{font-size:.92rem}}</style>
