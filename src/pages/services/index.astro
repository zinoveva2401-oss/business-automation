---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Услуги — Розница в цифрах">
  <Header slot="header" />
  
  <!-- Техническая заглушка страницы услуг -->
  <section class="page-placeholder">
    <div class="container">
      <h1>Индивидуальные услуги</h1>
      <p>Экспертная помощь в системном управлении розничным бизнесом.</p>
      <p class="placeholder-note">Это техническая заглушка. Описание услуг будет добавлено позже.</p>
    </div>
  </section>

  <Footer slot="footer" />
</Layout>

<style>
  .page-placeholder {
    padding: var(--spacing-3xl) 0;
    min-height: 50vh;
  }

  .page-placeholder h1 {
    font-size: var(--text-4xl);
    margin-bottom: var(--spacing-md);
    color: var(--color-dark-base);
  }

  .page-placeholder p {
    font-size: var(--text-lg);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-md);
  }

  .placeholder-note {
    font-size: var(--text-sm);
    color: var(--color-analytics-blue);
    font-style: italic;
  }
</style>