---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const personSchema={'@context':'https://schema.org','@type':'Person',name:'Светлана Тарасова',jobTitle:'Основатель, практик, эксперт',image:'/about/about-hero-desktop.webp'};
---
<BaseLayout title="Светлана Тарасова — основатель «Докрути»" description="Светлана Тарасова — практик, эксперт и основатель «Докрути». Помогает находить причины рабочих проблем и доводить решения до применения." image="/about/about-hero-desktop.webp" schema={personSchema}><article class="about-page"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Обо мне'}]}/><section class="about-intro"><div><p class="eyebrow">Основатель «Докрути»</p><h1>Светлана<br/><em>Тарасова</em></h1><p class="lead">Практик. Эксперт. Основатель «Докрути».</p><p>Многолетний опыт в торговле, управлении и рабочих процессах помогает мне смотреть не на отдельный симптом, а на всю последовательность, которая приводит к результату.</p><a class="button button--primary" href="/#question">Задать вопрос <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div><figure><img src="/about/about-hero-desktop.webp" alt="Светлана Тарасова в рабочем пространстве рядом с аналитической схемой" width="1799" height="1063" fetchpriority="high"/><figcaption>Работа начинается с наблюдения, данных и точного вопроса.</figcaption></figure></section></div><section class="approach"><div class="container approach-grid"><div><p class="eyebrow">Как я работаю</p><h2>Не угадывать.<br/><em>Разобраться.</em></h2></div><div class="approach-copy"><p>«Докрути» появился из простой идеи: не давать ещё один общий совет, а находить причину проблемы и доводить решение до применения.</p><ol><li><span>01</span><strong>Увидеть</strong><small>что происходит на самом деле</small></li><li><span>02</span><strong>Понять</strong><small>где возникает отклонение</small></li><li><span>03</span><strong>Докрутить</strong><small>следующий шаг до результата</small></li></ol></div></div></section><section class="about-close"><div class="container"><p class="eyebrow">С чем можно прийти</p><h2>Продажи, ассортимент, клиенты, команда, управление, маркетинг и ИИ.</h2><p>Если готового материала пока нет, опишите ситуацию — я предложу формат, срок и стоимость до начала работы.</p><a class="text-link" href="/services/">Посмотреть форматы работы <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></section></article></BaseLayout>
<style>.about-page{background:#fff;color:var(--c-graphite)}.about-page em{color:var(--c-orange);font-style:normal}.about-page>.container{padding-bottom:var(--section)}.about-intro{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,8vw,8rem);align-items:center;padding-top:2.5rem}.about-intro h1{margin:.35rem 0 1rem;font-size:clamp(3.4rem,7vw,6.8rem);line-height:.86}.about-intro .lead{margin:0 0 1rem;font-size:1.2rem;font-weight:600}.about-intro p:not(.eyebrow):not(.lead){max-width:430px;color:#56616a;line-height:1.6}.about-intro figure{margin:0}.about-intro figure img{width:100%;aspect-ratio:1.7;object-fit:cover}.about-intro figcaption{margin-top:.55rem;color:var(--c-muted);font-size:.75rem}.about-intro .button{margin-top:1rem}.approach{padding:var(--section) 0;background:var(--c-paper)}.approach-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,8vw,8rem)}.approach h2,.about-close h2{margin:.3rem 0 0;font-size:clamp(2.5rem,5vw,4.8rem);line-height:.98}.approach-copy>p{max-width:560px;margin:0;color:#4f5961;font-size:1.08rem;line-height:1.6}.approach ol{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin:2rem 0 0;padding:0;list-style:none;border-top:1px solid var(--c-graphite)}.approach li{display:grid;gap:.25rem;padding-top:.7rem;border-right:1px solid var(--c-graphite)}.approach li:last-child{border:0}.approach li span{color:var(--c-orange);font:600 1.15rem var(--font-editorial)}.approach li strong{font-size:.95rem}.approach li small{color:var(--c-muted);font-size:.75rem;line-height:1.35}.about-close{padding:var(--section) 0;background:#e8edf2}.about-close h2{max-width:900px}.about-close p:not(.eyebrow){max-width:600px;margin:1rem 0 0;color:#56616a}.text-link{display:inline-flex;align-items:center;gap:.4rem;margin-top:1rem;font-weight:700;text-decoration:none}.text-link:hover{color:var(--c-orange)}@media(max-width:700px){.about-intro,.approach-grid{grid-template-columns:1fr;gap:1.7rem}.about-intro{padding-top:1.5rem}.about-intro h1{font-size:4.1rem}.approach ol{gap:.6rem}.approach li{padding-right:.5rem}}@media(max-width:430px){.about-intro h1{font-size:3.5rem}.about-intro .lead{font-size:1.05rem}.approach h2{font-size:2.7rem}.approach-copy>p{font-size:1rem}.approach ol{grid-template-columns:1fr;gap:0}.approach li{grid-template-columns:34px 1fr;padding:1rem 0;border-right:0;border-bottom:1px solid var(--c-graphite)}.approach li span{grid-row:span 2}}</style>
