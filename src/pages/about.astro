---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';
import EditorialFolio from '../components/EditorialFolio.astro';
import EditorialEvidenceTrack from '../components/EditorialEvidenceTrack.astro';
const personSchema={'@context':'https://schema.org','@type':'Person',name:'Светлана Тарасова',jobTitle:'Основатель, практик, эксперт',image:'/images/about-editorial-workspace.png'};
---
<BaseLayout title="Светлана Тарасова — основатель «Докрути»" description="Светлана Тарасова — практик, эксперт и основатель «Докрути». Помогает находить причины рабочих проблем и доводить решения до применения." image="/images/about-editorial-workspace.png" schema={personSchema}>
  <article class="about-route-page">
    <header class="about-route__intro"><div class="container"><Breadcrumbs items={[{name:'Главная',href:'/'},{name:'Обо мне'}]} /><EditorialFolio number="07" label="About" /><div class="about-route__hero-grid"><div><p class="eyebrow">Основатель «Докрути»</p><h1>Светлана<br /><em>Тарасова</em></h1><p class="about-route__lead">Практик. Эксперт. Основатель «Докрути».</p><p>Многолетний опыт в торговле, управлении и рабочих процессах помогает смотреть не на отдельный симптом, а на всю последовательность, которая приводит к результату.</p><a class="button button--primary" href="/contacts/" data-analytics-event="click_contact" data-analytics-placement="about_intro">Задать вопрос <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div><figure><ResponsiveImage src="/images/about-editorial-workspace.png" alt="Рабочая схема проекта «Докрути» на столе" width={1200} height={800} loading="eager" fetchpriority="high" sizes="(max-width: 700px) 100vw, 55vw" /><figcaption>Работа начинается с наблюдения, данных и точного вопроса. Фото основателя ожидает согласования.</figcaption></figure></div></div></header>
    <section class="about-route__method"><div class="container"><div class="about-route__method-heading"><div><p class="eyebrow">Как я работаю</p><h2>Не угадывать.<br /><em>Разобраться.</em></h2></div><p>«Докрути» появился из простой идеи: не давать ещё один общий совет, а находить причину проблемы и доводить решение до применения.</p></div><ol>{[['01','Увидеть','что происходит на самом деле'],['02','Понять','где возникает отклонение'],['03','Проверить','какой факт это подтверждает'],['04','Докрутить','следующий шаг до результата']].map((step)=><li><span>{step[0]}</span><strong>{step[1]}</strong><small>{step[2]}</small></li>)}</ol></div></section>
    <EditorialEvidenceTrack id="about-evidence" title="Рабочая система, а не совет." lead="В каждой задаче важно оставить след: что наблюдали, что проверили и какое действие можно повторить." />
    <section class="about-route__close"><div class="container"><EditorialFolio number="07" label="Continuation" /><h2>Продажи, ассортимент, клиенты, команда, управление, маркетинг и ИИ.</h2><p>Если готового материала пока нет, опишите ситуацию — я предложу формат, срок и стоимость до начала работы.</p><a class="route-link" href="/services/">Посмотреть форматы работы <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></section>
  </article>
</BaseLayout>
<style>
  .about-route-page{background:#fff;color:var(--c-graphite)}.about-route__intro{padding:1rem 0 clamp(4rem,8vw,7rem);background:var(--c-paper)}.about-route__intro .editorial-folio{margin:2rem 0}.about-route__hero-grid{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,8vw,8rem);align-items:center}.about-route__hero-grid h1{margin:.45rem 0 1rem;font-size:clamp(3.7rem,7vw,7rem);line-height:.84;letter-spacing:-.05em}.about-route__hero-grid h1 em,.about-route__method h2 em{color:var(--c-orange);font-style:normal}.about-route__hero-grid>div>p:not(.eyebrow):not(.about-route__lead){max-width:440px;color:#56616a;line-height:1.55}.about-route__lead{margin:0 0 1rem;font-size:1.15rem;font-weight:700}.about-route__hero-grid figure{margin:0;border-left:3px solid var(--c-orange)}.about-route__hero-grid figure img{aspect-ratio:1.42;object-fit:cover}.about-route__hero-grid figcaption{margin-top:.55rem;color:var(--c-muted);font-size:.72rem}.about-route__hero-grid .button{margin-top:1rem}.about-route__method{padding:clamp(4rem,8vw,8rem) 0;background:#fff}.about-route__method-heading{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(2rem,8vw,8rem);align-items:end}.about-route__method-heading h2{margin:.45rem 0 0;font-size:clamp(2.8rem,5vw,5rem);line-height:.93}.about-route__method-heading>p{max-width:560px;margin:0;color:#56616a;line-height:1.55}.about-route__method ol{display:grid;grid-template-columns:repeat(4,1fr);margin:3rem 0 0;padding:0;border-top:2px solid var(--c-orange);list-style:none}.about-route__method li{display:grid;gap:.35rem;padding:1rem 1rem 0 0;border-right:1px solid var(--c-graphite)}.about-route__method li+li{padding-left:1rem}.about-route__method li:last-child{border-right:0}.about-route__method li span{color:var(--c-orange);font:600 1.2rem/.9 var(--font-editorial)}.about-route__method li strong{font-size:1.05rem}.about-route__method li small{color:var(--c-muted);font-size:.78rem;line-height:1.4}.about-route__close{padding:clamp(4rem,8vw,7rem) 0;background:var(--c-paper)}.about-route__close h2{max-width:940px;margin:1rem 0;font-size:clamp(2.3rem,4.5vw,4.5rem);line-height:.95}.about-route__close p:not(.eyebrow){max-width:600px;color:#56616a;line-height:1.55}.about-route__close .route-link{display:inline-flex;align-items:center;gap:.45rem;color:inherit;font-weight:800;text-decoration:none}.about-route__close .route-link:hover{color:var(--c-orange)}@media(max-width:700px){.about-route__intro .editorial-folio{margin:1.5rem 0}.about-route__hero-grid,.about-route__method-heading{grid-template-columns:1fr;gap:1.8rem}.about-route__hero-grid h1{font-size:clamp(3.5rem,16vw,5rem)}.about-route__hero-grid figure{order:-1}.about-route__method ol{grid-template-columns:1fr;margin-top:2rem}.about-route__method li,.about-route__method li+li{grid-template-columns:36px 1fr;padding:1rem 0;border-right:0;border-bottom:1px solid var(--c-line)}.about-route__method li:last-child{border-bottom:0}.about-route__method li span{grid-row:span 2}.about-route__close h2{font-size:2.6rem}}
</style>
