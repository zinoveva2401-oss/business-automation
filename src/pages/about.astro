---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readingChannels } from '../lib/channels';
const schema={'@context':'https://schema.org','@type':'Person',name:'Светлана Тарасова',description:'Основатель Докрути, практик по продажам, управлению, маркетингу и бизнес-процессам',image:new URL('/approved/founder-about.webp',Astro.url).href};
---
<BaseLayout title="Светлана Тарасова и Докрути — практика для малого бизнеса" description="Светлана Тарасова — основатель Докрути и практик по продажам, управлению, маркетингу и бизнес-процессам." image="/approved/founder-about.webp" schema={schema}>
<article class="about-v4"><header class="about-hero"><div class="container about-hero-grid"><div><p class="eyebrow">ОБО МНЕ</p><h1>Светлана Тарасова</h1><p>Помогаю владельцу малого бизнеса понять, почему привычные действия перестали давать нужный результат, что проверить и какой шаг сделать дальше.</p><button class="button button--primary" type="button" data-open-sheet="ask" data-analytics-event="contact_open">Описать задачу ↗</button></div><figure><img src="/approved/founder-about.webp" alt="Светлана Тарасова, основатель Докрути" width="900" height="1122" fetchpriority="high"/></figure></div></header><section class="container about-practice"><div><p class="eyebrow">ПРАКТИКА</p><h2>Работа с реальными процессами</h2></div><div><p>Моя основная профессиональная база — торговля, управление сетями, продажи, закупки и рабочие процессы. Также я работала в опте, швейном производстве и смежных операционных задачах.</p><p>Этот опыт помогает видеть связь между показателями, действиями команды и тем, что происходит с клиентом.</p></div></section><section class="about-method"><div class="container"><p class="eyebrow">КАК РАЗБИРАЮ ЗАДАЧУ</p><h2>От наблюдения к проверке</h2><ol><li><span>01</span><strong>Увидеть ситуацию</strong><p>Что происходит и где это видно.</p></li><li><span>02</span><strong>Проверить причину</strong><p>Какие факты подтверждают или опровергают версию.</p></li><li><span>03</span><strong>Выбрать действие</strong><p>Какой шаг подходит после проверки.</p></li><li><span>04</span><strong>Вернуться к результату</strong><p>Что изменилось после действия.</p></li></ol></div></section><section class="container about-boundary"><div><p class="eyebrow">ПРИНЦИП РАБОТЫ</p><h2>У задачи есть границы</h2></div><p>Там, где ответ зависит от отраслевого права, технологии производства или другой специальной области, нужна отдельная профессиональная проверка. Практический опыт — отправная точка, которую важно сопоставлять с фактами.</p></section><section class="about-channels"><div class="container"><p class="eyebrow">ГДЕ ЧИТАТЬ</p><h2>Продолжить знакомство</h2>{readingChannels.map(channel=><a href={channel.href} target="_blank" rel="noopener noreferrer" data-analytics-event="channel_subscribe_click" data-analytics-channel-id={channel.id}><strong>{channel.label}</strong><span>{channel.reason}</span><b aria-hidden="true">↗</b></a>)}</div></section></article>
</BaseLayout>
<style>.about-v4{background:#fff}.about-hero{padding:55px 0;background:#f4f5f6}.about-hero-grid{display:grid;grid-template-columns:.8fr 1fr;gap:5vw;align-items:center}.about-hero h1{margin:0 0 20px;font-size:clamp(55px,6vw,85px)}.about-hero p:not(.eyebrow){max-width:550px;font-size:17px}.about-hero button{margin-top:17px;cursor:pointer}.about-hero figure{height:500px;margin:0;overflow:hidden}.about-hero img{width:100%;height:100%;object-fit:cover;object-position:62% 40%}.about-practice,.about-boundary{display:grid;grid-template-columns:.85fr 1fr;gap:60px;align-items:start;padding-top:65px;padding-bottom:65px}.about-practice h2,.about-boundary h2,.about-method h2,.about-channels h2{margin:0;font-size:clamp(37px,4vw,57px)}.about-practice p:not(.eyebrow),.about-boundary p:not(.eyebrow){margin-top:0;font-size:17px;line-height:1.6}.about-method{padding:55px 0;background:#17130f;color:#fff}.about-method ol{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin:35px 0 0;padding:0;list-style:none}.about-method li{padding-top:15px;border-top:2px solid #d9562f}.about-method li span{display:block;color:#ff8d69;font:600 22px var(--font-editorial)}.about-method li strong{display:block;margin:15px 0 8px;font-size:16px}.about-method li p{margin:0;color:#d2ceca;font-size:13px}.about-channels{padding:50px 0;background:#f4f5f6}.about-channels h2{margin-bottom:24px}.about-channels a{display:grid;grid-template-columns:1fr 1.5fr 22px;gap:18px;max-width:750px;padding:16px 0;border-top:1px solid #bfc4c9;text-decoration:none}.about-channels a span{font-size:13px}.about-channels a b{color:#d9562f}@media(max-width:700px){.about-hero-grid,.about-practice,.about-boundary{grid-template-columns:1fr;gap:20px}.about-hero{padding:42px 0}.about-hero h1{font-size:clamp(48px,11vw,68px)}.about-hero figure{height:390px}.about-practice,.about-boundary{padding-top:45px;padding-bottom:45px}.about-method ol{grid-template-columns:1fr 1fr}.about-channels a{grid-template-columns:1fr 22px}.about-channels a span{grid-column:1}.about-channels a b{grid-column:2;grid-row:1/3}}</style>
<style>
.about-hero img{object-position:62% 0}
@media(max-width:700px){.about-hero figure{height:350px}.about-hero img{object-position:65% 0;transform:scale(1.75);transform-origin:67% 12%}}
</style>
