---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import EditorialFolio from '../components/EditorialFolio.astro';
import ContactLinks from '../components/ContactLinks.astro';
---
<BaseLayout title="Контакты «Докрути» — задать вопрос" description="Личные и проектные каналы «Докрути», чтобы описать рабочую задачу и выбрать следующий шаг.">
  <article class="contacts-route">
    <header class="contacts-route__hero"><div class="container"><Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: 'Контакты' }]} /><EditorialFolio number="07" label="Contact" dark /><p class="eyebrow">Если готового материала нет</p><h1>Опишите задачу.<br /><em>Начнём с фактов.</em></h1><p>Выберите удобный канал. Личные контакты — для вопроса и рабочей ситуации; проектные — чтобы читать материалы «Докрути».</p></div></header>
    <section class="contacts-route__body"><div class="container"><div class="contacts-route__heading"><div><EditorialFolio number="07" label="Channels" /><h2>Один прямой<br /><em>маршрут.</em></h2></div><p>Без собственной формы: выберите активный канал и опишите, что происходит. Следующий шаг начинается с конкретной ситуации.</p></div><ContactLinks placement="contacts_route" /><div class="contacts-route__cta"><div><p class="eyebrow">Прямой канал</p><h2>Можно начать с письма.</h2></div><a class="button button--primary" href="mailto:hello@dokruti.ru" data-analytics-event="click_email" data-analytics-placement="contacts_route">hello@dokruti.ru <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></div></section>
  </article>
</BaseLayout>
<style>
  .contacts-route{background:#fff;color:var(--c-graphite)}.contacts-route__hero{padding:1rem 0 clamp(4rem,9vw,8rem);background:var(--c-navy);color:#fff}.contacts-route__hero .editorial-folio{margin:2rem 0 3rem}.contacts-route__hero h1{max-width:900px;margin:.5rem 0 1.2rem;font-size:clamp(3.2rem,7vw,7rem);line-height:.88;letter-spacing:-.05em}.contacts-route__hero h1 em,.contacts-route__heading h2 em{color:#e7a6b5;font-style:normal}.contacts-route__hero>div>p:last-child{max-width:600px;margin:0;color:#e2e8ef;font-size:1.08rem;line-height:1.55}.contacts-route__body{padding:clamp(4rem,8vw,8rem) 0;background:var(--c-paper)}.contacts-route__heading{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem);align-items:end;margin-bottom:3rem}.contacts-route__heading h2{margin:.5rem 0 0;font-size:clamp(2.8rem,5vw,5rem);line-height:.92}.contacts-route__heading>p{max-width:480px;margin:0;color:#56616a;line-height:1.55}.contacts-route :global(.contact-groups){display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,8vw,8rem)}.contacts-route :global(.contact-groups section){min-width:0}.contacts-route :global(.contact-groups h2){margin:.4rem 0 1rem;font-size:clamp(1.8rem,3vw,3rem);line-height:.95}.contacts-route :global(.contact-groups h2 em){color:var(--c-orange)}.contacts-route :global(.link-list){display:grid;gap:0}.contacts-route :global(.link-list a){display:grid;width:100%;min-width:0;min-height:62px;grid-template-columns:32px minmax(0,1fr) 20px;align-items:center;gap:.8rem;padding:.7rem 0;border:0;border-top:1px solid var(--c-graphite);border-radius:0;background:transparent;color:var(--c-graphite);text-decoration:none}.contacts-route :global(.link-list a:last-child){border-bottom:1px solid var(--c-graphite)}.contacts-route :global(.link-list a:hover){background:#fff}.contacts-route :global(.link-list i){display:grid;width:30px;height:30px;place-items:center;border:1px solid var(--c-blue);border-radius:0;background:transparent;color:var(--c-blue);font-size:1.05rem}.contacts-route :global(.link-list b){color:var(--c-orange)}.contacts-route__cta{display:flex;align-items:end;justify-content:space-between;gap:2rem;margin-top:clamp(4rem,8vw,7rem);padding-top:2rem;border-top:2px solid var(--c-graphite)}.contacts-route__cta h2{margin:.35rem 0 0;font-size:clamp(2.2rem,4vw,4rem);line-height:.95}.contacts-route__cta .button{flex:0 0 auto}@media(max-width:700px){.contacts-route__hero .editorial-folio{margin:1.5rem 0 2.5rem}.contacts-route__hero h1{font-size:clamp(3rem,12vw,4.4rem)}.contacts-route__heading{grid-template-columns:1fr;gap:1rem;margin-bottom:2rem}.contacts-route :global(.contact-groups){grid-template-columns:1fr;gap:3rem}.contacts-route__cta{display:grid;align-items:start}.contacts-route__cta .button{width:max-content;max-width:100%}}
</style>
