---
import ResponsiveImage from './ResponsiveImage.astro';
import { formatDate, topicForCategory } from '../lib/site';
const { article, placement = 'editorial_route', rank = 0, featured = false } = Astro.props;
const topic = topicForCategory(article.data.category);
const search = (article.data.title + ' ' + article.data.description + ' ' + article.data.primarySearchQuestion).toLocaleLowerCase('ru');
---
<article class:list={['editorial-article-row', { 'editorial-article-row--featured': featured }]} data-article-card data-category={article.data.category} data-cluster={article.data.cluster} data-search={search} data-timestamp={article.data.publishedAt?.valueOf() ?? 0} data-featured={article.data.featured ? '1' : '0'}>
  <a class="editorial-article-row__link" href={'/articles/' + article.data.slug + '/'} data-analytics-event="click_related_article" data-analytics-content-id={article.data.id} data-analytics-category={article.data.category} data-analytics-placement={placement}>
    <span class="editorial-article-row__index">0{rank + 1}</span>
    <span class="editorial-article-row__image">{article.data.cover ? <ResponsiveImage src={article.data.cover} alt={article.data.coverAlt || ''} width={720} height={405} loading={featured ? 'eager' : 'lazy'} fetchpriority={featured ? 'high' : 'auto'} sizes={featured ? '(max-width: 700px) 100vw, 42vw' : '(max-width: 700px) 100vw, 180px'} /> : <i class="ti ti-file-description" aria-hidden="true"></i>}</span>
    <span class="editorial-article-row__body"><span class="editorial-article-row__meta"><b>{topic?.name || article.data.category}</b><time datetime={article.data.publishedAt?.toISOString()}>{article.data.publishedAt ? formatDate(article.data.publishedAt) : 'Материал'}</time></span><strong>{article.data.title}</strong><span class="editorial-article-row__description">{article.data.description}</span></span>
    <span class="editorial-article-row__arrow" aria-hidden="true">↗</span>
  </a>
</article>
<style>
  .editorial-article-row{min-width:0;border-top:1px solid var(--c-graphite);background:transparent}.editorial-article-row:last-child{border-bottom:1px solid var(--c-graphite)}.editorial-article-row__link{display:grid;grid-template-columns:34px 150px minmax(0,1fr) 24px;gap:1rem;align-items:stretch;min-height:130px;color:inherit;text-decoration:none}.editorial-article-row__link:hover{background:#fff}.editorial-article-row__index{padding-top:1rem;color:var(--c-orange);font:600 1rem/.9 var(--font-editorial)}.editorial-article-row__image{overflow:hidden;background:#e5eaee}.editorial-article-row__image img{width:100%;height:100%;object-fit:cover}.editorial-article-row__image>i{display:grid;height:100%;place-items:center;color:var(--c-blue);font-size:2rem}.editorial-article-row__body{display:grid;align-content:center;gap:.4rem;min-width:0;padding:.9rem 0}.editorial-article-row__meta{display:flex;flex-wrap:wrap;gap:.6rem;color:var(--c-muted);font-size:.68rem}.editorial-article-row__meta b{color:var(--c-blue);font-size:.68rem}.editorial-article-row__body>strong{font-size:1.18rem;line-height:1.08}.editorial-article-row__description{max-width:620px;color:var(--c-muted);font-size:.8rem;line-height:1.4}.editorial-article-row__arrow{align-self:center;color:var(--c-orange);font-size:1.25rem}.editorial-article-row--featured{border-top:3px solid var(--c-orange);background:#fff}.editorial-article-row--featured .editorial-article-row__link{grid-template-columns:34px minmax(240px,.85fr) minmax(0,1.15fr) 24px;min-height:300px}.editorial-article-row--featured .editorial-article-row__body{padding:1.4rem 1.2rem}.editorial-article-row--featured .editorial-article-row__body>strong{font-size:clamp(1.55rem,2.6vw,2.55rem);line-height:.98}
  @media(max-width:700px){.editorial-article-row__link,.editorial-article-row--featured .editorial-article-row__link{grid-template-columns:28px 92px minmax(0,1fr) 18px;gap:.6rem;min-height:118px}.editorial-article-row--featured .editorial-article-row__link{grid-template-columns:24px 1fr 18px;grid-template-rows:150px auto}.editorial-article-row--featured .editorial-article-row__image{grid-column:2/4;grid-row:1}.editorial-article-row--featured .editorial-article-row__index{grid-row:1}.editorial-article-row--featured .editorial-article-row__body{grid-column:1/4;grid-row:2;padding:.9rem 0}.editorial-article-row--featured .editorial-article-row__arrow{grid-column:3;grid-row:2;align-self:end;padding-bottom:1rem}.editorial-article-row__body>strong{font-size:.94rem}.editorial-article-row__description{display:none}.editorial-article-row__meta{font-size:.62rem}.editorial-article-row__meta b{font-size:.62rem}}
</style>
