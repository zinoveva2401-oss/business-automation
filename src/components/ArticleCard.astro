---
import ResponsiveImage from './ResponsiveImage.astro';
import { topicForCategory } from '../lib/site';
const { article, featured = false, placement = 'catalog', priority = false } = Astro.props;
const topic = topicForCategory(article.data.category);
---
<article class:list={['article-card',{featured}]} data-article-card data-category={article.data.category} data-cluster={article.data.cluster} data-search={`${article.data.title} ${article.data.description} ${article.data.primarySearchQuestion}`.toLocaleLowerCase('ru')} data-timestamp={article.data.publishedAt?.valueOf() ?? 0} data-featured={article.data.featured?'1':'0'}>
  <a class="article-card__link" href={`/articles/${article.data.slug}/`} data-analytics-event="click_related_article" data-analytics-content-id={article.data.id} data-analytics-category={article.data.category} data-analytics-placement={placement}>
    <div class:list={['article-card__image',!article.data.cover&&'article-card__image--placeholder']}>{article.data.cover?<ResponsiveImage src={article.data.cover} alt={article.data.coverAlt||''} width={720} height={405} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} sizes="(max-width: 700px) 100vw, 33vw" />:<i class="ti ti-file-description" aria-hidden="true"></i>}</div>
    <div class="article-card__body"><p class="article-card__category">{topic?.name || article.data.category}</p><h3>{article.data.title}</h3><p class="article-card__description">{article.data.description}</p></div>
  </a>
</article>
<style>
  .article-card{min-width:0;overflow:hidden;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff;transition:border-color .2s,transform .2s}.article-card:hover{transform:translateY(-2px);border-color:#aeb8bf}.article-card__link{display:grid;height:100%;grid-template-rows:auto 1fr;color:inherit;text-decoration:none}.article-card__link:focus-visible{outline:3px solid var(--c-orange);outline-offset:-3px}.article-card__image{aspect-ratio:16/9;overflow:hidden;background:#edf1f4}.article-card__image img{width:100%;height:100%;object-fit:cover;object-position:center}.article-card__image--placeholder{display:grid;place-items:center;color:#7890a6}.article-card__image--placeholder i{font-size:2.3rem}.article-card__body{padding:.8rem .9rem .9rem}.article-card__category{margin:0;color:var(--c-blue);font-size:.75rem;font-weight:800}.article-card h3{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:3;margin:.4rem 0 0;font-size:1.02rem;line-height:1.22}.article-card__description{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:.6rem 0 0;color:var(--c-muted);font-size:.84rem;line-height:1.4}.article-card.featured{border-top:3px solid var(--c-orange)}.article-card.featured h3{font-size:clamp(1.35rem,2.2vw,2rem);line-height:1.05}.article-card.featured .article-card__description{-webkit-line-clamp:3}
  @media(max-width:700px){.article-card__body{padding:.75rem .85rem .85rem}}
</style>
