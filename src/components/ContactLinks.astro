---
import { contactLinks, projectLinks, personalMaxLink, projectMaxLink } from '../lib/site';
const { type = 'all', compact = false, placement = 'contacts' } = Astro.props as { type?: 'contacts' | 'projects' | 'all'; compact?: boolean; placement?: string };
---
<div class:list={['contact-groups', { compact }]}>
  {(type === 'contacts' || type === 'all') && <section><h2>Связаться со <em>Светланой</em></h2><div class="link-list">{[...contactLinks, personalMaxLink].map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" data-analytics-event={link.event} data-analytics-destination={link.id} data-analytics-placement={placement}><i class={`ti ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span><b aria-hidden="true">→</b></a>)}</div></section>}
  {(type === 'projects' || type === 'all') && <section><h2>Площадки <em>проекта</em></h2><div class="link-list">{[...projectLinks, projectMaxLink].map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer" data-analytics-event={link.event} data-analytics-destination={link.id} data-analytics-placement={placement}><i class={`ti ${link.icon}`} aria-hidden="true"></i><span>{link.label}</span><b aria-hidden="true">→</b></a>)}</div></section>}
</div>
<style>.contact-groups{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(1.5rem,4vw,4rem)}.contact-groups.compact{grid-template-columns:1fr}.contact-groups h2{margin:0 0 1rem;font-size:clamp(1.35rem,2vw,1.8rem)}.contact-groups h2 em{color:var(--c-orange);font-style:normal}.link-list{display:flex;flex-wrap:wrap;gap:.65rem}.link-list a{display:grid;min-width:150px;min-height:52px;grid-template-columns:auto 1fr auto;align-items:center;gap:.65rem;padding:.6rem .8rem;border:1px solid #ffffff18;border-radius:var(--r-sm);background:#161b20;color:#fff;text-decoration:none}.link-list i{display:grid;width:32px;height:32px;place-items:center;border-radius:var(--r-sm);background:var(--c-blue);color:#fff;font-size:1.25rem}.link-list b{color:var(--c-orange)}@media(max-width:700px){.contact-groups{grid-template-columns:1fr}.link-list{display:grid}.link-list a{width:100%}}</style>
