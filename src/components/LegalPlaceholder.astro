---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
const { title, description } = Astro.props;
---
<BaseLayout title={`${title} — Розница в цифрах`} description={description} noindex={true}>
  <section class="legal-page"><div class="container"><Breadcrumbs items={[{ name: 'Главная', href: '/' }, { name: title }]} /><p class="eyebrow">Юридический документ</p><h1>{title}</h1><div class="legal-notice">Документ готовится к публикации после утверждения инфраструктуры и платёжного сервиса.</div></div></section>
</BaseLayout>
<style>.legal-page{min-height:62vh;padding-block:var(--section)}.legal-page h1{max-width:900px;margin:.4rem 0 2rem;font-family:var(--font-editorial);font-size:clamp(2.5rem,6vw,5.5rem);line-height:.98}.legal-notice{max-width:820px;padding:clamp(1.5rem,4vw,3rem);border-left:5px solid var(--c-orange);border-radius:var(--r-md);background:#fff;font-size:1.1rem}</style>
