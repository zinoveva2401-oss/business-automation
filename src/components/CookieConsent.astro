<aside class="cookie-consent" data-cookie-consent hidden aria-label="Настройки аналитики">
  <p>Сайт может использовать необязательную аналитику, чтобы понимать, какие материалы полезны.</p>
  <div><button type="button" data-consent="denied">Отклонить</button><button class="accept" type="button" data-consent="granted">Принять</button></div>
</aside>
<script>
  const key = 'rvd_analytics_consent';
  const banner = document.querySelector<HTMLElement>('[data-cookie-consent]');
  const show = () => { if (banner) banner.hidden = false; };
  if (!localStorage.getItem(key)) show();
  banner?.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) => button.addEventListener('click', () => {
    const value = button.dataset.consent === 'granted' ? 'granted' : 'denied';
    localStorage.setItem(key, value); banner.hidden = true;
    window.dispatchEvent(new CustomEvent('rvd:analytics-consent', { detail: { value } }));
  }));
  document.querySelector('[data-cookie-settings]')?.addEventListener('click', show);
</script>
<style>.cookie-consent{position:fixed;z-index:100;right:1rem;bottom:1rem;width:min(430px,calc(100vw - 2rem));padding:1rem;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff;box-shadow:0 16px 45px #17130f33}.cookie-consent[hidden]{display:none}.cookie-consent p{margin:0 0 .8rem;font-size:.88rem}.cookie-consent div{display:flex;gap:.5rem}.cookie-consent button{min-height:44px;padding:.6rem .9rem;border:1px solid var(--c-line);border-radius:var(--r-sm);background:#fff;font-weight:700;cursor:pointer}.cookie-consent .accept{border-color:var(--c-orange);background:var(--c-orange);color:#fff}@media(max-width:430px){.cookie-consent{right:.5rem;bottom:.5rem;width:calc(100vw - 1rem);padding:.65rem .75rem;border-radius:8px}.cookie-consent p{margin-bottom:.5rem;font-size:.78rem;line-height:1.3}.cookie-consent div{gap:.4rem}.cookie-consent button{min-height:42px;flex:1;padding:.45rem .65rem;font-size:.82rem}}</style>
