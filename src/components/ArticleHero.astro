---
import Breadcrumbs from './Breadcrumbs.astro';
import ResponsiveImage from './ResponsiveImage.astro';

interface Breadcrumb { name: string; href?: string }
interface Props {
  category: string;
  title: string;
  lead: string;
  categoryHref: string;
  image?: string;
  imageAlt: string;
  breadcrumbs: Breadcrumb[];
}

const { category, title, lead, categoryHref, image, imageAlt, breadcrumbs } = Astro.props;
---

<header class="container article-hero" aria-labelledby="article-title">
  <div class="article-hero__media">
    {image && <ResponsiveImage src={image} alt={imageAlt} width={1672} height={941} loading="eager" fetchpriority="high" sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1350px) calc(100vw - 2 * var(--gutter)), 1260px" class="article-hero__photo" />}
  </div>
  <div class="article-hero__copy">
    <Breadcrumbs items={breadcrumbs} />
    <p class="article-hero__taxonomy"><a href={categoryHref}>{category}</a></p>
    <h1 id="article-title">{title}</h1>
    <p class="article-hero__lead">{lead}</p>
  </div>
</header>

<style>
  .article-hero{position:relative;isolation:isolate;display:flex;min-height:clamp(390px,34vw,470px);align-items:center;overflow:hidden;background:var(--c-paper)}
  .article-hero__media{position:absolute;z-index:-2;inset:0;overflow:hidden;background:var(--c-paper)}
  .article-hero__media::after{position:absolute;inset:0;content:"";background:linear-gradient(90deg,rgba(255,255,255,.94) 0%,rgba(255,255,255,.83) 30%,rgba(255,255,255,.52) 43%,rgba(255,255,255,.08) 58%,rgba(255,255,255,0) 72%)}
  .article-hero__photo{width:100%;height:100%;object-fit:cover;object-position:right center}
  .article-hero__copy{width:min(55%,620px);padding:clamp(1.5rem,3vw,2.6rem) 0}
  .article-hero__taxonomy{display:flex;flex-wrap:wrap;gap:.45rem;margin:.28rem 0 .55rem;color:#4d5962;font-size:.68rem;font-weight:750;letter-spacing:.055em;text-transform:uppercase}
  .article-hero__taxonomy a{color:var(--c-orange);text-decoration:none}
  .article-hero h1{max-width:14ch;margin:.28rem 0 .62rem;font-size:clamp(2.15rem,3.35vw,3rem);line-height:1.04;letter-spacing:-.04em}
  .article-hero__lead{max-width:51ch;margin:0;color:#343a40;font-size:.96rem;line-height:1.5}
  :global(.article-hero .breadcrumbs){max-width:100%;overflow:hidden}
  :global(.article-hero .breadcrumbs ol){flex-wrap:nowrap;gap:.28rem;margin:0;color:#46515a;font-size:.66rem;line-height:1.3;white-space:nowrap}
  :global(.article-hero .breadcrumbs li){flex:0 0 auto;min-width:0;padding:0;border:0;background:transparent}
  :global(.article-hero .breadcrumbs li:last-child){overflow:hidden;text-overflow:ellipsis}
  :global(.article-hero .breadcrumbs li+li:before){content:'›';margin-right:.28rem;color:#8b9297}
  :global(.article-hero .breadcrumbs a){color:inherit}
  @media(max-width:900px){.article-hero{min-height:420px}.article-hero__copy{width:min(64%,600px)}}
  @media(max-width:700px){
    .article-hero{display:grid;grid-template-columns:minmax(0,1fr);min-height:0;align-items:stretch;overflow:hidden}
    .article-hero__media{position:relative;z-index:0;inset:auto;width:100%;aspect-ratio:1672 / 941;min-height:0;max-height:none}
    .article-hero__media::after{background:linear-gradient(180deg,rgba(255,255,255,0) 55%,rgba(255,255,255,.14) 82%,rgba(255,255,255,.48) 100%)}
    .article-hero__copy{position:relative;z-index:1;box-sizing:border-box;min-width:0;width:100%;margin-top:-.85rem;padding:.55rem 1.15rem 1.35rem;background:linear-gradient(180deg,rgba(255,255,255,.9),#fff 26%)}
    .article-hero h1{max-width:16ch;margin:.32rem 0 .6rem;font-size:clamp(2rem,7.6vw,2.5rem);line-height:1.04}
    .article-hero__lead{max-width:100%;font-size:.94rem;line-height:1.48}
    :global(.article-hero .breadcrumbs){width:100%;min-width:0}
    :global(.article-hero .breadcrumbs ol){font-size:.62rem}
  }
</style>
