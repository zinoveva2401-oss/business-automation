---
import ResponsiveImage from './ResponsiveImage.astro';
const { product, placement='catalog', priority=false } = Astro.props;
const purchasable=product.data.status==='published'&&product.data.purchaseStatus==='active'&&Boolean(product.data.purchaseUrl);
---
<article class="product-card" data-product-status={product.data.status}><a class="product-image" href={'/tools/' + product.data.slug + '/'} tabindex="-1"><ResponsiveImage src={product.data.cover} alt={product.data.coverAlt} width={720} height={440} loading={priority?'eager':'lazy'} fetchpriority={priority?'high':'auto'} sizes="(max-width: 700px) 100vw, 33vw"/></a><div><p class="product-type">{product.data.type}</p><p class="product-status">{purchasable?'Доступен':product.data.status==='comingSoon'?'В разработке':'Черновик'}</p><h3><a href={'/tools/' + product.data.slug + '/'} data-analytics-event="click_product" data-analytics-product-id={product.data.id} data-analytics-placement={placement}>{product.data.title}</a></h3><p>{product.data.description}</p>{purchasable&&<a class="product-link" href={'/tools/' + product.data.slug + '/'}>Подробнее →</a>}{!purchasable&&<a class="product-link" href={'/tools/' + product.data.slug + '/'}>Узнать о задаче →</a>}</div></article>
<style>.product-card{display:grid;overflow:hidden;border:1px solid var(--c-graphite);background:var(--c-white)}.product-image{aspect-ratio:16/10;background:#e9edf1}.product-image img{width:100%;height:100%;object-fit:cover}.product-card>div{display:flex;flex-direction:column;padding:1.2rem}.product-type,.product-status{margin:0;color:var(--c-blue);font-size:.68rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.product-status{margin-top:.25rem;color:var(--c-orange)}.product-card h3{margin:.55rem 0;font-size:1.25rem}.product-card h3 a,.product-link{text-decoration:none}.product-card>div>p:not(.product-type):not(.product-status){margin:0 0 1rem;color:#555d64}.product-link{margin-top:auto;color:var(--c-graphite);font-weight:700}.product-link:hover{color:var(--c-orange)}@media(max-width:700px){.product-card>div{padding:1rem}.product-card h3{font-size:1.1rem}}
</style>
