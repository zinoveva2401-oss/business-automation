---
import ResponsiveImage from './ResponsiveImage.astro';
import { formatPrice } from '../lib/site';
const { product, placement = 'catalog', priority = false } = Astro.props;
---
<article class="product-card">
  <a class="product-image" href={`/tools/${product.data.slug}/`} tabindex="-1"><ResponsiveImage src={product.data.cover} alt={product.data.coverAlt} width={720} height={440} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : 'auto'} sizes="(max-width: 700px) 100vw, 33vw" /></a>
  <div><p class="product-type">{product.data.type}</p><h3><a href={`/tools/${product.data.slug}/`} data-analytics-event="click_product" data-analytics-product-id={product.data.id} data-analytics-placement={placement}>{product.data.title}</a></h3><p>{product.data.description}</p><strong>{product.data.status==='published'&&product.data.purchaseStatus==='active'?'Доступен':'В разработке'}</strong>{product.data.status==='comingSoon'&&<small class="planned-price">{formatPrice(product.data.price, product.data.pricePrefix)}</small>}<a class="product-link" href={`/tools/${product.data.slug}/`} data-analytics-event="click_product_catalog" data-analytics-product-id={product.data.id} data-analytics-placement={placement}>Подробнее →</a></div>
</article>
<style>.product-card{display:grid;overflow:hidden;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff}.product-image{aspect-ratio:16/10;background:#e9edf1}.product-image img{width:100%;height:100%;object-fit:cover}.product-card>div{display:flex;flex-direction:column;padding:1.2rem}.product-type{margin:0;color:#0a4c93;font-size:.75rem;font-weight:800;text-transform:uppercase}.product-card h3{margin:.55rem 0;font-size:1.25rem}.product-card h3 a,.product-link{text-decoration:none}.product-card>div>p:not(.product-type){margin:0 0 1rem;color:#555d64}.product-card strong{margin-top:auto}.planned-price{margin-top:.3rem;color:#687078;font-size:.85rem}.product-link{margin-top:1rem;color:#07499c;font-weight:700}</style>
