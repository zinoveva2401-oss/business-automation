---
import { projectLinks } from '../lib/site';
const channels=projectLinks.filter((link)=>link.id==='vk'||link.id==='telegram');
---
<footer class="site-footer"><div class="container footer-top"><div><a class="footer-brand" href="/"><span>ДОК</span>РУТИ</a><p>Найти причину. Понять следующий шаг. Довести решение до применения.</p></div><nav aria-label="Навигация в подвале"><strong>Навигация</strong><a href="/articles/">Библиотека</a><a href="/tools/">Инструменты</a><a href="/services/">Услуги</a><a href="/about/">Обо мне</a><a href="/contacts/">Контакты</a></nav><nav aria-label="Документы"><strong>Документы</strong><a href="/privacy/">Конфиденциальность</a><a href="/cookie-policy/">Cookie</a><a href="/offer/">Оферта</a><a href="/user-agreement/">Соглашение</a></nav></div><div class="container footer-bottom"><div><span>Каналы</span>{channels.map((link)=><a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label} data-analytics-event={link.event}><i class={'ti ' + link.icon} aria-hidden="true"></i>{link.label}</a>)}</div><span>© 2026 «Докрути»</span></div></footer>
<style>.site-footer{padding:3.5rem 0 1.3rem;background:var(--c-chocolate);color:#fff}.footer-top{display:grid;grid-template-columns:1.6fr 1fr 1fr;gap:clamp(2rem,8vw,8rem)}.footer-brand{position:relative;display:inline-block;padding-left:14px;font:600 1.35rem/.82 var(--font-editorial);letter-spacing:.04em;text-decoration:none}.footer-brand::before{position:absolute;top:-4px;bottom:-4px;left:0;width:3px;background:var(--c-orange);content:''}.footer-top p{max-width:290px;margin:1rem 0 0;color:#c1c1bd;font-size:.86rem}.footer-top nav{display:grid;align-content:start;gap:.55rem}.footer-top strong{margin-bottom:.25rem;font:600 1rem var(--font-editorial)}.footer-top nav a{color:#d7d7d3;font-size:.8rem;text-decoration:none}.footer-top nav a:hover{color:#fff}.footer-bottom{display:flex;justify-content:space-between;gap:1rem;margin-top:3rem;padding-top:1rem;border-top:1px solid #ffffff26;color:#9d9d99;font-size:.74rem}.footer-bottom>div{display:flex;flex-wrap:wrap;align-items:center;gap:.55rem}.footer-bottom>div>span{margin-right:.3rem;color:#fff;font-weight:700}.footer-bottom a{display:inline-flex;align-items:center;gap:.3rem;color:#cfcfca;text-decoration:none}.footer-bottom a:hover{color:#fff}@media(max-width:700px){.footer-top{grid-template-columns:1fr 1fr;gap:2rem}.footer-top>div{grid-column:1/-1}.footer-bottom{display:grid;gap:1rem;margin-top:2rem}}@media(max-width:430px){.footer-top{grid-template-columns:1fr}.footer-top nav{padding-top:1rem;border-top:1px solid #ffffff26}.footer-bottom{font-size:.7rem}}
</style>
