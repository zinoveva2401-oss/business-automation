---
import { readingChannels } from '../lib/channels';
---
<footer class="site-footer"><div class="container footer-main"><div><a class="footer-brand" href="/">ДОКРУТИ</a><p>Практические решения для малого бизнеса.</p></div><nav aria-label="Разделы сайта"><a href="/articles/">Библиотека</a><a href="/tools/">Инструменты</a><a href="/services/">Услуги</a><a href="/about/">Обо мне</a></nav><div class="footer-actions"><button type="button" data-open-sheet="read">Где читать</button><button type="button" data-open-sheet="ask">Задать вопрос</button></div></div><div class="container footer-bottom"><span>© 2026 Докрути</span><div>{readingChannels.map(channel=><a href={channel.href} target="_blank" rel="noopener noreferrer" data-analytics-event="channel_subscribe_click" data-analytics-channel-id={channel.id}>{channel.label}</a>)}</div></div></footer>
<style>.site-footer{padding:38px 0 20px;background:#17130f;color:#fff}.footer-main{display:grid;grid-template-columns:1fr 1.4fr auto;gap:32px}.footer-brand{display:inline-block;padding-left:12px;border-left:3px solid #d9562f;font:600 19px var(--font-editorial);text-decoration:none}.footer-main p{margin:10px 0 0;color:#c9c5c0;font-size:12px}.footer-main nav{display:flex;flex-wrap:wrap;gap:12px 24px;align-content:start}.footer-main nav a,.footer-bottom a{font-size:13px;text-decoration:none}.footer-actions{display:flex;gap:8px;align-items:start}.footer-actions button{min-height:44px;padding:9px 12px;border:1px solid #ffffff77;background:transparent;color:#fff;font-size:12px;cursor:pointer}.footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:28px;padding-top:15px;border-top:1px solid #ffffff33;color:#bbb;font-size:12px}.footer-bottom>div{display:flex;gap:18px}@media(max-width:700px){.footer-main{grid-template-columns:1fr}.footer-main nav{display:grid;grid-template-columns:1fr 1fr}.footer-actions{flex-wrap:wrap}.footer-bottom{margin-top:24px}}</style>
