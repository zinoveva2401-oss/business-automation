---
import { readingChannels } from '../lib/channels';
const footerChannels = Astro.url.pathname === '/'
  ? readingChannels.map(channel => channel.id === 'telegram' ? { ...channel, href: 'https://t.me/dokruti_biz' } : channel)
  : readingChannels;
const isHome = Astro.url.pathname === '/';
---
{isHome ? <footer class="site-footer site-footer--home"><div class="container footer-home"><a class="footer-brand" href="/">Докрути</a><nav aria-label="Разделы сайта"><a href="/articles/">Библиотека</a><a href="/tools/">Инструменты</a><a href="/services/">Услуги</a><a href="/about/">Обо мне</a></nav><nav class="footer-legal" aria-label="Правовая информация"><a href="/privacy/">Политика ПД</a><a href="/cookies/">Cookies</a><a href="/personal-data-request/">Запрос по ПД</a></nav><small>© 2026 Докрути</small></div></footer> : <footer class="site-footer"><div class="container footer-main"><div><a class="footer-brand" href="/">ДОКРУТИ</a><p>Практические решения для малого бизнеса.</p></div><nav aria-label="Разделы сайта"><a href="/articles/">Библиотека</a><a href="/tools/">Инструменты</a><a href="/services/">Услуги</a><a href="/about/">Обо мне</a></nav><div class="footer-actions"><button type="button" data-open-sheet="read">Где читать</button><button type="button" data-open-sheet="ask">Задать вопрос</button></div></div><div class="container footer-bottom"><span>© 2026 Докрути</span><nav class="footer-legal" aria-label="Правовая информация"><a href="/privacy/">Политика ПД</a><a href="/cookies/">Cookies</a><a href="/personal-data-request/">Запрос по ПД</a></nav><div>{footerChannels.map(channel=><a href={channel.href} target="_blank" rel="noopener noreferrer" data-analytics-event="channel_subscribe_click" data-analytics-channel-id={channel.id}>{channel.label}</a>)}</div></div></footer>}
<style>.site-footer{padding:38px 0 20px;background:#17130f;color:#fff}.footer-main{display:grid;grid-template-columns:1fr 1.4fr auto;gap:32px}.footer-brand{display:inline-block;padding-left:12px;border-left:3px solid #d9562f;font:600 19px var(--font-editorial);text-decoration:none}.footer-main p{margin:10px 0 0;color:#c9c5c0;font-size:12px}.footer-main nav{display:flex;flex-wrap:wrap;gap:12px 24px;align-content:start}.footer-main nav a,.footer-bottom a{font-size:13px;text-decoration:none}.footer-actions{display:flex;gap:8px;align-items:start}.footer-actions button{min-height:44px;padding:9px 12px;border:1px solid #ffffff77;background:transparent;color:#fff;font-size:12px;cursor:pointer}.footer-bottom{display:flex;justify-content:space-between;gap:20px;margin-top:28px;padding-top:15px;border-top:1px solid #ffffff33;color:#bbb;font-size:12px}.footer-bottom>div{display:flex;gap:18px}.site-footer--home{padding:15px 0;background:#fff;color:#262626}.footer-home{display:flex;align-items:center;justify-content:space-between;gap:18px;padding-right:58px}.site-footer--home .footer-brand{padding-left:11px;border-left:2px solid #d9562f;color:#262626;font-size:17px}.site-footer--home nav{display:flex;flex-wrap:wrap;gap:10px 22px}.site-footer--home nav a{color:#45494c;font-size:12px;text-decoration:none}.site-footer--home nav a:hover{color:#bd4626}.site-footer--home small{color:#64696c;font-size:11px;white-space:nowrap}@media(max-width:700px){.footer-main{grid-template-columns:1fr}.footer-main nav{display:grid;grid-template-columns:1fr 1fr}.footer-actions{flex-wrap:wrap}.footer-bottom{margin-top:24px}.footer-home{align-items:flex-start;flex-direction:column;gap:12px;padding:0 0 70px}.site-footer--home nav{gap:9px 18px}.site-footer--home nav a{font-size:11px}}.footer-legal{display:flex;flex-wrap:wrap;gap:8px 14px;align-items:center}.footer-legal a{font-size:11px;text-decoration:none}.footer-legal a:hover{text-decoration:underline}.site-footer--home .footer-legal{gap:8px 12px}.site-footer--home .footer-legal a{color:#45494c;font-size:11px}@media(max-width:700px){.site-footer--home .footer-legal{gap:8px 14px}}</style>
