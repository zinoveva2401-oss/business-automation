---
const { dark = false } = Astro.props;
---
<a class="skip-link" href="#main">К содержанию</a>
<header class:list={["site-header", { dark }]}>
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Розница в цифрах — главная"><span>РОЗНИЦА</span><b>В</b> ЦИФРАХ</a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><i class="ti ti-menu-2" aria-hidden="true"></i><span class="visually-hidden">Открыть меню</span></button>
    <nav id="main-nav" aria-label="Основная навигация">
      <a href="/articles/">Статьи</a><a href="/tools/">Инструменты</a><a href="/services/">Услуги</a><a href="/about/">Обо мне</a><a href="/contacts/">Контакты</a>
    </nav>
    <a class="all-tools" href="/tools/">Все продукты <i class="ti ti-shopping-bag" aria-hidden="true"></i></a>
  </div>
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.querySelector<HTMLElement>('#main-nav');
  toggle?.addEventListener('click', () => { const expanded = toggle.getAttribute('aria-expanded') === 'true'; toggle.setAttribute('aria-expanded', String(!expanded)); nav?.classList.toggle('open', !expanded); const icon=toggle.querySelector('i'); icon?.classList.toggle('ti-menu-2',expanded); icon?.classList.toggle('ti-x',!expanded); });
</script>
<style>
  .site-header{position:relative;z-index:20;background:var(--c-ink);color:#fff;border:0}.header-inner{min-height:70px;display:grid;grid-template-columns:190px 1fr auto;align-items:center;gap:1.5rem}.brand{position:relative;padding-left:12px;font-family:var(--font-editorial);font-size:1.04rem;line-height:.9;text-decoration:none;text-transform:uppercase}.brand:before{content:'';position:absolute;inset:0 auto 0 0;width:3px;background:var(--c-orange)}.brand span{display:block}.brand b{color:inherit;font-family:inherit;font-weight:600}nav{display:flex;justify-content:center;gap:clamp(1rem,2.5vw,2.6rem)}nav a,.all-tools{font-size:.82rem;font-weight:600;text-decoration:none}nav a:hover{color:var(--c-orange)}.all-tools{min-height:42px;display:inline-flex;align-items:center;padding:.6rem .9rem;border-radius:var(--r-sm);background:var(--c-orange);color:#fff}.menu-toggle{display:none;width:44px;height:44px;padding:8px;border:0;background:transparent;color:inherit}.menu-toggle i{font-size:1.75rem}
  @media(max-width:880px){.header-inner{grid-template-columns:1fr auto;min-height:64px}.menu-toggle{display:block}.all-tools{display:none}.header-inner nav{position:absolute;top:100%;right:var(--gutter);width:min(260px,calc(100vw - 2rem));display:none;flex-direction:column;gap:0;padding:1rem;border-radius:0 0 var(--r-md) var(--r-md);background:var(--c-ink);box-shadow:0 18px 35px #0005}.header-inner nav.open{display:flex}.header-inner nav a{min-height:46px;display:flex;align-items:center;border-top:1px solid #ffffff18}.header-inner nav a:first-child{border-top:0}}
</style>
