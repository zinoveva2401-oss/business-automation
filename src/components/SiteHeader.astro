---
const { dark=false } = Astro.props;
---
<a class="skip-link" href="#main">К содержанию</a>
<header class:list={['site-header',{dark}]}><div class="container header-inner"><a class="brand" href="/" aria-label="Докрути — главная"><span>ДОК</span>РУТИ</a><button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><i class="ti ti-menu-2" aria-hidden="true"></i><span class="visually-hidden">Открыть меню</span></button><nav id="main-nav" aria-label="Основная навигация"><a href="/articles/">Библиотека</a><a href="/tools/">Инструменты</a><a href="/services/">Услуги</a><a href="/about/">Обо мне</a></nav><a class="header-cta" href="/#question">Найти решение <i class="ti ti-arrow-up-right" aria-hidden="true"></i></a></div></header>
<script>const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector<HTMLElement>('#main-nav');toggle?.addEventListener('click',()=>{const expanded=toggle.getAttribute('aria-expanded')==='true';toggle.setAttribute('aria-expanded',String(!expanded));nav?.classList.toggle('open',!expanded);const icon=toggle.querySelector('i');icon?.classList.toggle('ti-menu-2',expanded);icon?.classList.toggle('ti-x',!expanded)});</script>
<style>.site-header{position:relative;z-index:20;background:var(--c-chocolate);color:#fff}.header-inner{min-height:76px;display:grid;grid-template-columns:150px 1fr auto;align-items:center;gap:2rem}.brand{position:relative;padding-left:14px;font-family:var(--font-editorial);font-size:1.3rem;line-height:.82;letter-spacing:.04em;text-decoration:none}.brand::before{position:absolute;top:-4px;bottom:-4px;left:0;width:3px;background:var(--c-orange);content:''}.header-inner nav{display:flex;justify-content:center;gap:clamp(1rem,2.7vw,2.8rem)}.header-inner nav a,.header-cta{font-size:.82rem;font-weight:600;text-decoration:none}.header-inner nav a:hover{color:#b8d4f6}.header-cta{display:inline-flex;min-height:42px;align-items:center;gap:.4rem;padding:.65rem .85rem;border-bottom:1px solid var(--c-orange);color:#fff}.header-cta:hover{color:#ffd0c2}.menu-toggle{display:none;width:44px;height:44px;padding:8px;border:0;background:transparent;color:inherit}.menu-toggle i{font-size:1.7rem}@media(max-width:880px){.header-inner{grid-template-columns:1fr auto;min-height:68px;gap:.5rem}.menu-toggle{display:block}.header-cta{display:none}.header-inner nav{position:absolute;top:100%;right:var(--gutter);display:none;width:min(280px,calc(100vw - 2rem));flex-direction:column;gap:0;padding:1rem;background:var(--c-chocolate);box-shadow:0 18px 35px #0005}.header-inner nav.open{display:flex}.header-inner nav a{display:flex;min-height:46px;align-items:center;border-top:1px solid #ffffff1f}.header-inner nav a:first-child{border-top:0}}
</style>
