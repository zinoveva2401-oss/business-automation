---
const steps = [
  { number: '01', label: 'Увидеть', text: 'что изменилось первым' },
  { number: '02', label: 'Проверить', text: 'где возникает отклонение' },
  { number: '03', label: 'Докрутить', text: 'следующий шаг до применения' },
];
---

<section class="causal-trace" id="how-we-work" aria-labelledby="causal-trace-title" data-causal-trace>
  <div class="container">
    <div class="causal-trace__intro">
      <div>
        <p class="eyebrow">Как работает «Докрути»</p>
        <h2 id="causal-trace-title">Не угадывать.<br /><em>Разобраться.</em></h2>
      </div>
      <p class="causal-trace__lead">Один рабочий маршрут для разных задач: от первого симптома до следующего действия, которое можно проверить.</p>
    </div>
    <ol class="causal-trace__steps">
      {steps.map((step) => <li class="causal-trace__step" data-trace-step>
        <span class="causal-trace__number">{step.number}</span>
        <span class="causal-trace__copy"><strong>{step.label}</strong><small>{step.text}</small></span>
      </li>)}
    </ol>
    <p class="causal-trace__note"><span aria-hidden="true">↗</span> Факт остаётся фактом. Предположение помечается как предположение.</p>
  </div>
</section>

<script>
  const trace = document.querySelector<HTMLElement>('[data-causal-trace]');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-trace-step]')];
  if (trace && steps.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      trace.classList.add('is-visible');
      steps.forEach((step, index) => window.setTimeout(() => step.classList.add('is-active'), index * 180));
      observer.disconnect();
    }, { threshold: 0.25 });
    observer.observe(trace);
  } else {
    trace?.classList.add('is-visible');
    steps.forEach((step) => step.classList.add('is-active'));
  }
</script>

<style>
  .causal-trace{padding:var(--section) 0;background:#fff;color:var(--c-graphite)}
  .causal-trace__intro{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,8vw,8rem);align-items:end}
  .causal-trace h2{margin:.35rem 0 0;font-size:clamp(2.8rem,5vw,5rem);line-height:.95}
  .causal-trace h2 em{color:var(--c-orange);font-style:normal}
  .causal-trace__lead{max-width:560px;margin:0;color:#505b63;font-size:1.08rem;line-height:1.6}
  .causal-trace__steps{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:4rem 0 0;padding:0;list-style:none;border-top:2px solid var(--c-graphite)}
  .causal-trace__steps::before{position:absolute;top:-2px;left:0;width:0;height:2px;background:var(--c-orange);content:'';transition:width .8s ease}
  .causal-trace.is-visible .causal-trace__steps::before{width:100%}
  .causal-trace__step{display:grid;grid-template-columns:auto 1fr;gap:1rem;padding:1.1rem 1.2rem 0 0;border-right:1px solid var(--c-line);opacity:.45;transform:translateY(8px);transition:opacity .35s ease,transform .35s ease}
  .causal-trace__step+ .causal-trace__step{padding-left:1.2rem}
  .causal-trace__step:last-child{border-right:0}
  .causal-trace__step.is-active{opacity:1;transform:none}
  .causal-trace__number{color:var(--c-orange);font:600 1.35rem/.9 var(--font-editorial)}
  .causal-trace__copy{display:grid;gap:.28rem}
  .causal-trace__copy strong{font-size:1rem}
  .causal-trace__copy small{color:var(--c-muted);font-size:.78rem;line-height:1.35}
  .causal-trace__note{display:flex;align-items:center;gap:.5rem;margin:1.4rem 0 0;color:var(--c-muted);font-size:.78rem}
  .causal-trace__note span{color:var(--c-orange);font-size:1.1rem}
  @media(max-width:700px){.causal-trace__intro{grid-template-columns:1fr;gap:1.25rem}.causal-trace__lead{font-size:1rem}.causal-trace__steps{grid-template-columns:1fr;margin-top:2.5rem}.causal-trace__step,.causal-trace__step+.causal-trace__step{grid-template-columns:38px 1fr;padding:1rem 0;border-right:0;border-bottom:1px solid var(--c-line)}.causal-trace__step:last-child{border-bottom:0}.causal-trace__number{font-size:1.2rem}}
  @media(prefers-reduced-motion:reduce){.causal-trace__steps::before,.causal-trace__step{transition:none}}
</style>
