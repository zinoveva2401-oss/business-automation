---
const { dark = false, id = 'evidence-track', title = 'Не угадывать. Разобраться.', lead = 'Один рабочий маршрут: от наблюдаемого факта к следующей проверке, которую можно выполнить.' } = Astro.props as { dark?: boolean; id?: string; title?: string; lead?: string };
const steps = [{ number: '01', label: 'Причина', text: 'назвать симптом и отделить факт от версии' }, { number: '02', label: 'Проверка', text: 'собрать один наблюдаемый сигнал' }, { number: '03', label: 'Действие', text: 'зафиксировать следующий шаг и его след' }];
---
<section class:list={['editorial-evidence', { 'editorial-evidence--dark': dark }]} id={id} aria-labelledby={id + '-title'} data-evidence-track>
  <div class="container"><div class="editorial-evidence__intro"><div><p class="eyebrow">Рабочая механика</p><h2 id={id + '-title'}>{title}</h2></div><p>{lead}</p></div><ol class="editorial-evidence__steps">{steps.map((step) => <li><span>{step.number}</span><strong>{step.label}</strong><small>{step.text}</small></li>)}</ol><p class="editorial-evidence__note"><b aria-hidden="true">↗</b> Материал, который можно проверить, важнее уверенного совета.</p></div>
</section>
<style>
  .editorial-evidence{padding:clamp(3.5rem,7vw,6rem) 0;background:#e9eef2;color:var(--c-graphite)}.editorial-evidence--dark{background:var(--c-chocolate);color:#fff}.editorial-evidence__intro{display:grid;grid-template-columns:.82fr 1.18fr;gap:clamp(2rem,8vw,8rem);align-items:end}.editorial-evidence h2{max-width:560px;margin:.4rem 0 0;font-size:clamp(2.35rem,4.6vw,4.6rem);line-height:.94;letter-spacing:-.035em}.editorial-evidence__intro>p{max-width:540px;margin:0;color:#55616a;font-size:1rem;line-height:1.55}.editorial-evidence--dark .editorial-evidence__intro>p{color:#d2d9df}.editorial-evidence__steps{display:grid;grid-template-columns:repeat(3,1fr);margin:3.4rem 0 0;padding:0;border-top:2px solid var(--c-orange);list-style:none}.editorial-evidence__steps li{display:grid;grid-template-columns:auto 1fr;gap:.8rem;padding:1rem 1rem 0 0;border-right:1px solid #64717b;align-content:start}.editorial-evidence__steps li+li{padding-left:1rem}.editorial-evidence__steps li:last-child{border-right:0}.editorial-evidence__steps span{color:var(--c-orange);font:600 1.2rem/.9 var(--font-editorial)}.editorial-evidence__steps strong{font-size:.98rem}.editorial-evidence__steps small{grid-column:2;color:#65727b;font-size:.75rem;line-height:1.4}.editorial-evidence--dark .editorial-evidence__steps small{color:#cbd3d9}.editorial-evidence__note{display:flex;gap:.5rem;margin:1.4rem 0 0;color:#66737c;font-size:.75rem}.editorial-evidence--dark .editorial-evidence__note{color:#cbd3d9}.editorial-evidence__note b{color:var(--c-orange);font-size:1rem}
  @media(max-width:700px){.editorial-evidence__intro{grid-template-columns:1fr;gap:1.2rem}.editorial-evidence__steps{grid-template-columns:1fr;margin-top:2.5rem}.editorial-evidence__steps li,.editorial-evidence__steps li+li{grid-template-columns:34px 1fr;padding:1rem 0;border-right:0;border-bottom:1px solid #64717b}.editorial-evidence__steps li:last-child{border-bottom:0}.editorial-evidence__steps small{grid-column:2}}
</style>
