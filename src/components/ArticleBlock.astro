---
type Item = { title:string; text?:string };
interface Props { type:'callout'|'important'|'error'|'action'|'example'|'case'|'checklist'|'steps'|'comparison'|'matrix'|'process'|'quote'; title:string; intro?:string; items?:Item[] }
const { type, title, intro, items=[] } = Astro.props;
const ordered = type==='steps'||type==='process';
---
<section class:list={['article-block',`article-block--${type}`]} aria-label={title}>
  <p class="article-block__kind">{type==='error'?'Ошибка':type==='action'?'Что делать':type==='important'?'Важно':type==='case'?'Кейс':type==='example'?'Пример':'Практический блок'}</p>
  <h2>{title}</h2>
  {intro&&<p class="article-block__intro">{intro}</p>}
  {items.length>0&&(ordered?<ol>{items.map((item)=><li><strong>{item.title}</strong>{item.text&&<span>{item.text}</span>}</li>)}</ol>:<ul>{items.map((item)=><li><strong>{item.title}</strong>{item.text&&<span>{item.text}</span>}</li>)}</ul>)}
</section>
<style>
  .article-block{margin:2rem 0 2.5rem;padding:1.25rem;border:1px solid var(--c-line);border-radius:var(--r-md);background:#fff}.article-block__kind{margin:0 0 .4rem;color:var(--c-blue);font:800 .75rem/1.2 var(--font-ui);letter-spacing:.07em;text-transform:uppercase}.article-block h2{margin:0 0 .65rem;font-size:1.45rem}.article-block__intro{max-width:68ch;margin:.35rem 0 1rem}.article-block ul,.article-block ol{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem;margin:0;padding:0;list-style:none;counter-reset:item}.article-block li{display:grid;gap:.25rem;padding:.85rem;background:#f3f5f7}.article-block li span{color:#505b63}.article-block--steps ol,.article-block--process ol{grid-template-columns:repeat(auto-fit,minmax(135px,1fr))}.article-block--steps li,.article-block--process li{counter-increment:item;border-top:3px solid var(--c-blue)}.article-block--steps li::before,.article-block--process li::before{content:counter(item,decimal-leading-zero);color:var(--c-blue);font-weight:800}.article-block--comparison li:first-child{border-left:4px solid var(--c-blue)}.article-block--comparison li:last-child{border-left:4px solid var(--c-orange)}.article-block--error{border-left:5px solid var(--c-orange)}.article-block--error .article-block__kind{color:var(--c-orange)}.article-block--important,.article-block--quote{background:var(--c-ink);color:#fff}.article-block--important li,.article-block--quote li{background:#ffffff10}.article-block--important .article-block__kind,.article-block--quote .article-block__kind{color:#a8c5e6}.article-block--checklist li::before{content:'✓';color:var(--c-blue);font-weight:900}.article-block--matrix ul{grid-template-columns:repeat(2,minmax(0,1fr))}
  @media(max-width:700px){.article-block{margin:1.4rem 0 1.8rem;padding:1rem}.article-block h2{font-size:1.3rem}.article-block ul,.article-block ol,.article-block--steps ol,.article-block--process ol,.article-block--matrix ul{grid-template-columns:1fr}}
</style>
