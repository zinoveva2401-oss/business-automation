---
// Header компонент
---

<header class="header">
  <div class="container header__container">
    <a href="/" class="header__logo">
      <span class="header__logo-text">Розница в цифрах</span>
    </a>
    
    <nav class="header__nav" aria-label="Основная навигация">
      <ul class="header__menu">
        <li class="header__menu-item">
          <a href="/articles/" class="header__menu-link">Статьи</a>
        </li>
        <li class="header__menu-item">
          <a href="/tools/" class="header__menu-link">Инструменты</a>
        </li>
        <li class="header__menu-item">
          <a href="/services/" class="header__menu-link">Услуги</a>
        </li>
        <li class="header__menu-item">
          <a href="/about/" class="header__menu-link">О проекте</a>
        </li>
        <li class="header__menu-item">
          <a href="/contacts/" class="header__menu-link">Контакты</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .header {
    background-color: var(--color-white);
    border-bottom: 1px solid var(--color-border);
    padding: var(--spacing-md) 0;
    position: sticky;
    top: 0;
    z-index: var(--z-sticky);
  }

  .header__container {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header__logo {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .header__logo:hover {
    color: var(--color-accent-orange);
  }

  .header__menu {
    display: flex;
    gap: var(--spacing-lg);
  }

  .header__menu-link {
    font-size: var(--text-sm);
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .header__menu-link:hover {
    color: var(--color-accent-orange);
  }

  @media (max-width: 768px) {
    .header__menu {
      gap: var(--spacing-md);
    }

    .header__menu-link {
      font-size: var(--text-xs);
    }
  }
</style>
