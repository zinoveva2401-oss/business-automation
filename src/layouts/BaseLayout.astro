---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CookieConsent from '../components/CookieConsent.astro';
import AnalyticsBridge from '../components/AnalyticsBridge.astro';
import { SITE_NAME } from '../lib/site';
interface Props { title:string; description:string; darkHeader?:boolean; image?:string; type?:'website'|'article'|'product'; schema?:Record<string,unknown>|Record<string,unknown>[]; noindex?:boolean; canonicalUrl?:string; heroPreload?:boolean }
const { title, description, darkHeader=false, image='/favicon.svg', type='website', schema, noindex=false, canonicalUrl, heroPreload=false } = Astro.props;
const isStaging = import.meta.env.PUBLIC_DEPLOY_ENV === 'staging';
const effectiveNoindex = noindex || isStaging;
const canonical = !isStaging && Astro.site ? new URL(canonicalUrl ? new URL(canonicalUrl, Astro.site).pathname : Astro.url.pathname, Astro.site).href : undefined;
const socialImage = Astro.site ? new URL(image, Astro.site).href : image;
const websiteSchema = {'@context':'https://schema.org','@type':'WebSite',name:SITE_NAME,...(!isStaging&&Astro.site?{url:Astro.site.href}:{})};
const heroPreloadDesktop = image === '/hero-dokruti-editorial.png' ? '/_optimized/hero-dokruti-editorial.w1600.webp' : image === '/hero-retail-investigation.png.png' ? '/_optimized/hero-retail-investigation.png.w1600.webp' : image;
const heroPreloadMobile = image === '/hero-dokruti-editorial.png' ? '/_optimized/hero-dokruti-editorial.w768.webp' : image === '/hero-retail-investigation.png.png' ? '/_optimized/hero-retail-investigation.png.w768.webp' : image;
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="description" content={description}><meta name="theme-color" content="#17130f"><meta name="robots" content={effectiveNoindex?'noindex,nofollow':'index,follow,max-snippet:-1,max-image-preview:large,max-video-preview:-1'}><title>{title}</title>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:locale" content="ru_RU"><meta property="og:site_name" content={SITE_NAME}><meta property="og:type" content={type==='product'?'product':type}><meta property="og:title" content={title}><meta property="og:description" content={description}>{canonical&&<meta property="og:url" content={canonical}/>}<meta property="og:image" content={socialImage}><meta name="twitter:card" content="summary_large_image">{heroPreload&&<><link rel="preload" as="image" href={heroPreloadDesktop} fetchpriority="high" media="(min-width: 601px)"/><link rel="preload" as="image" href={heroPreloadMobile} fetchpriority="high" media="(max-width: 600px)"/></>}<link rel="icon" href="/favicon.svg" type="image/svg+xml"><script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)}/>{schema&&<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/>}</head><body><SiteHeader dark={darkHeader}/><main id="main"><slot/></main><SiteFooter/><CookieConsent/><AnalyticsBridge/></body></html>
