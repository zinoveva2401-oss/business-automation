---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
interface Props { title: string; description: string; darkHeader?: boolean; image?: string; schema?: Record<string, unknown>; }
const { title, description, darkHeader = false, image = '/favicon.svg', schema } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html><html lang="ru"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content={description}><meta name="theme-color" content="#17130f"><title>{title}</title>{canonical && <link rel="canonical" href={canonical}/>}<meta property="og:type" content="website"><meta property="og:title" content={title}><meta property="og:description" content={description}><meta property="og:image" content={image}><link rel="icon" href="/favicon.svg" type="image/svg+xml">{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}</head><body><SiteHeader dark={darkHeader}/><main id="main"><slot/></main><SiteFooter/></body></html>
