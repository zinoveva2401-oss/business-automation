{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dokruti.ru/schemas/content-factory/content-run.schema.json",
  "title": "ContentRun",
  "type": "object",
  "required": [
    "run_id",
    "request_fingerprint",
    "portfolio_id",
    "brand_id",
    "audience_id",
    "source_set_id",
    "objective",
    "status",
    "stage",
    "revision",
    "created_at",
    "updated_at",
    "lanes",
    "checkpoints",
    "blockers",
    "owner_gates",
    "owner_authorizations",
    "idempotency_keys",
    "writeback_status"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "request_fingerprint": {
      "type": "string"
    },
    "portfolio_id": {"type":"string","minLength":1},
    "brand_id": {"type":"string","minLength":1},
    "audience_id": {"type":"string","minLength":1},
    "source_set_id": {"type":"string","minLength":1},
    "objective": {"enum":["COLD_REACH","FOLLOWERS","TRUST","AWARENESS","ENGAGEMENT","PLATFORM_MONETIZATION","AFFILIATE_REVENUE","PRODUCT_DEMAND","SERVICE_DEMAND","SEO_SEARCH","MARKET_PAIN","INCOMING_REQUESTS","EXPERTISE"]},
    "status": {
      "enum": [
        "READY",
        "RUNNING",
        "BLOCKED",
        "FAILED",
        "COMPLETE"
      ]
    },
    "stage": {
      "enum": [
        "intake",
        "source_restore",
        "strategy",
        "research",
        "master",
        "editorial",
        "adaptation",
        "qa",
        "approval",
        "publication",
        "analytics",
        "complete"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/checkpoint"
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner_gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "owner_authorizations": {"type":"array","items":{"$ref":"#/$defs/ownerAuthorization"}},
    "idempotency_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "writeback_status": {
      "enum": [
        "NOT_REQUIRED",
        "PENDING",
        "CONFIRMED",
        "UNKNOWN"
      ]
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "owner_gate_required": {
      "type": "boolean"
    },
    "persistence": {"type":"object","required":["system","record_id","field","storage_revision","last_writeback_hash"],"properties":{"system":{"const":"CONTENT_SYSTEM"},"record_id":{"type":"string"},"field":{"const":"Примечание"},"storage_revision":{"type":"integer","minimum":0},"last_writeback_hash":{"type":["string","null"]}},"additionalProperties":false}
  },
  "additionalProperties": false,
  "$defs": {
    "checkpoint": {
      "type": "object",
      "required": [
        "checkpoint_id",
        "stage",
        "completed_at",
        "evidence_refs",
        "proven"
      ],
      "properties": {
        "checkpoint_id": {
          "type": "string"
        },
        "stage": {
          "enum": ["intake","source_restore","strategy","research","master","editorial","adaptation","qa","approval","publication","analytics","complete"]
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "output_hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "next_stage": {
          "enum": ["source_restore","strategy","research","master","editorial","adaptation","qa","approval","publication","analytics","complete"]
        },
        "proven": {"const":true}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "required": [
        "gate_id",
        "status",
        "scope"
      ],
      "properties": {
        "gate_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "REQUIRED",
            "APPROVED",
            "DECLINED",
            "EXPIRED"
          ]
        },
        "scope": {
          "type": "string"
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ownerAuthorization": {"type":"object","required":["authorization_id","batch_id","approved_payload_hashes","channels","valid_from","valid_until","expires_at","allowed_changes","evidence_ref","status"],"properties":{"authorization_id":{"type":"string"},"batch_id":{"type":"string"},"approved_payload_hashes":{"type":"array","items":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"},"minItems":1,"uniqueItems":true},"channels":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},"valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"expires_at":{"type":"string","format":"date-time"},"allowed_changes":{"type":"array","items":{"type":"string"},"uniqueItems":true},"evidence_ref":{"type":"string"},"status":{"enum":["APPROVED","REVOKED","EXPIRED"]},"approved_at":{"type":"string","format":"date-time"}},"additionalProperties":false}
  }
}
