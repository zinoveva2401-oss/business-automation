      "human_task": "Полевой руководитель каждый день фиксирует короткие наблюдения с телефона и возвращается к ним на еженедельной планёрке, иногда без связи.",
      "signals": ["daily", "mobile", "offline", "repeat"],
      "routes": [
        {"name": "ebook", "fit": ["offline"], "amplifier": "add a compact capture checklist"},
        {"name": "mobile-first quick tool", "fit": ["daily", "mobile", "offline", "repeat"], "amplifier": "add an exportable weekly review"},
        {"name": "desktop dashboard", "fit": ["repeat"], "amplifier": "add a freshness indicator"}
      ]
    },
    {
      "id": "editorial-visual",
      "domain": "web/visual",
      "human_task": "Нужно объяснить новый принцип работы команды так, чтобы посетитель увидел изменение состояния, а не набор карточек.",
      "signals": ["story", "visual-event", "no-cards", "brand"],
      "routes": [
        {"name": "card grid", "fit": ["brand"], "amplifier": "add a static hero"},
        {"name": "editorial signal map", "fit": ["story", "visual-event", "no-cards", "brand"], "amplifier": "add a reduced-motion state"},
        {"name": "dashboard", "fit": ["no-cards"], "amplifier": "add a filter"}
      ]
    },
    {
      "id": "short-form-video",
      "domain": "media/video",
      "human_task": "Сделай короткий вертикальный ролик: за первые секунды зритель должен понять проблему, затем увидеть действие, услышать ясную фразу и прочитать её.",
      "signals": ["vertical", "two-beats", "voice", "captions", "retention"],
      "routes": [
        {"name": "single still", "fit": ["vertical"], "amplifier": "add a title card"},
        {"name": "two-scene narrated cut", "fit": ["vertical", "two-beats", "voice", "captions", "retention"], "amplifier": "tighten the first-second hook"},
        {"name": "long interview", "fit": ["voice"], "amplifier": "add chapter markers"}
      ]
    },
    {
      "id": "decision-data",
      "domain": "data/logic",
      "human_task": "Руководитель каждую неделю сравнивает каналы, хочет видеть свежесть данных, выбросы и один приоритет для следующего разбора.",
      "signals": ["freshness", "outlier", "drilldown", "priority", "repeat"],
      "routes": [
        {"name": "static report", "fit": ["repeat"], "amplifier": "add a data dictionary"},
        {"name": "decision dashboard", "fit": ["freshness", "outlier", "drilldown", "priority", "repeat"], "amplifier": "add an explicit next action"},
        {"name": "calculator", "fit": ["outlier"], "amplifier": "add saved scenarios"}
      ]
    },
    {
      "id": "webhook-recovery",
      "domain": "technical/integration",
      "human_task": "Платёжный webhook иногда повторяется и иногда отвечает с ошибкой; обработчик не должен дважды запускать внешнее действие.",
      "signals": ["duplicate", "retry", "partial-failure", "external-action", "least-privilege"],
      "routes": [
        {"name": "fire-and-forget", "fit": ["external-action"], "amplifier": "add a log line"},
        {"name": "idempotent retry handler", "fit": ["duplicate", "retry", "partial-failure", "external-action", "least-privilege"], "amplifier": "add a bounded dead-letter recovery"},
        {"name": "manual spreadsheet", "fit": ["partial-failure"], "amplifier": "add a duplicate column"}
      ]
    }
  ]
